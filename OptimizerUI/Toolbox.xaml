<Page x:Class="JamesOptimizer.Toolbox"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:JamesOptimizer"
      Title="Toolbox"
      Background="Transparent"
      FontFamily="{DynamicResource PrimaryFontFamily}"
      Loaded="Toolbox_Loaded">

    <Page.Resources>
        <!-- Tool Card Lift Style -->
        <Style x:Key="ToolCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#000000" Opacity="0.55" BlurRadius="24" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SurfaceHover}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" Opacity="0.25" BlurRadius="28" ShadowDepth="0"/>
                        </Setter.Value>
                    </Setter>
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="-2" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                 To="0" Duration="0:0:0.14">
                                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                </DoubleAnimation>
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Violet Gradient Launch Button -->
        <Style x:Key="VioletPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" CornerRadius="8">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="{DynamicResource ColorAccentViolet}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource ColorAccentCyan}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentViolet}" BlurRadius="16" Opacity="0.5" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Warning Amber Ghost Button -->
        <Style x:Key="AmberGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource WarningAmber}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource WarningAmber}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource WarningBackground}"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorWarningAmber}" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Green Ghost Button -->
        <Style x:Key="GreenGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="100"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SuccessGreen}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource SuccessGreen}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource SuccessBackground}"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorSuccessGreen}" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="*"/>    <!-- Tool Cards Stack -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Wrench icon (WarningAmber, 28px) -->
                    <Viewbox Width="28" Height="28" Margin="0,0,14,0">
                        <Path Fill="{DynamicResource WarningAmber}"
                              Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"/>
                    </Viewbox>
                    <TextBlock Text="TOOLBOX" Style="{StaticResource PageTitle}"/>
                </StackPanel>
                <TextBlock Text="Utilities and system tools to help you maintain and monitor your PC."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderSubtle}" Margin="0,20,0,24" SnapsToDevicePixels="True"/>

            <!-- ══════════════════════════════════════════════════════════
                 TOOL CARDS (full-width stack, gap 12px)
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="2">
                <!-- ⓪ System Benchmark Hero Card -->
                <Border x:Name="CardBenchmark" Margin="0,0,0,16" Padding="20,18"
                        Background="{DynamicResource Surface1}"
                        BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1.5"
                        CornerRadius="14">
                    <StackPanel>
                        <!-- Top Row: Icon + Title + Tier Badge -->
                        <Grid Margin="0,0,0,14">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="48" Height="48" CornerRadius="12"
                                        Background="{DynamicResource GlowCyan}"
                                        BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1"
                                        Margin="0,0,14,0">
                                    <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Fill="{DynamicResource AccentCyan}"
                                              Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14c-3.31 0-6-2.69-6-6s2.69-6 6-6 6 2.69 6 6-2.69 6-6 6zm1-10h-2v5h4v-2h-2z"/>
                                    </Viewbox>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="SYSTEM HARDWARE BENCHMARK" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Multithreaded synthetic stress test measuring CPU ops, memory throughput, and disk latency."
                                               Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="BadgeBenchmarkTier" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                                    CornerRadius="8" Padding="12,5">
                                <TextBlock x:Name="TxtBenchmarkTier" Text="TIER: READY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                            </Border>
                        </Grid>

                        <!-- Score Capsules -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- CPU Score -->
                            <Border Grid.Column="0" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="CPU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBenchCpu" Text="--" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtBenchCpuDetail" Text="Ops/sec" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- RAM Score -->
                            <Border Grid.Column="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="RAM" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBenchRam" Text="--" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtBenchRamDetail" Text="Bandwidth" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- DISK Score -->
                            <Border Grid.Column="4" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="DISK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource WarningAmber}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBenchDisk" Text="--" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtBenchDiskDetail" Text="Throughput" FontSize="9" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- OVERALL Score -->
                            <Border Grid.Column="6" Background="{DynamicResource SuccessBackground}" BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1.5" CornerRadius="10" Padding="10,10">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="OVERALL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="TxtBenchTotal" Text="--" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                    <TextBlock x:Name="TxtBenchTotalDetail" Text="Rank Tier" FontSize="9" Foreground="{DynamicResource SuccessGreen}" HorizontalAlignment="Center" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Progress Bar (hidden unless running) -->
                        <ProgressBar x:Name="BenchProgressBar" Height="4" Minimum="0" Maximum="100" Value="0"
                                     Background="{DynamicResource Surface2}" Foreground="{DynamicResource AccentCyan}"
                                     BorderThickness="0" Margin="0,0,0,12" Visibility="Collapsed"/>

                        <!-- Footer: Status Text + Run Button -->
                        <Grid>
                            <TextBlock x:Name="TxtBenchmarkStatus" Text="Ready to benchmark hardware. Click to start synthetic suite."
                                       Style="{StaticResource BodyText}" VerticalAlignment="Center"/>
                            <Button x:Name="BtnRunBenchmark" Width="160" Height="36" Style="{StaticResource PrimaryActionButton}"
                                    HorizontalAlignment="Right" Click="BtnRunBenchmark_Click">
                                <TextBlock x:Name="TxtRunBenchmarkBtn" Text="RUN BENCHMARK" FontSize="11" FontWeight="Bold"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ① CPU-Z -->
                <Border x:Name="CardCpuz" Height="80" Margin="0,0,0,12" Style="{StaticResource ToolCardStyle}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Col 0: Square 48×48px icon area -->
                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource GlowCyan}"
                                BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="{DynamicResource AccentCyan}"
                                      Data="M9 3L7 5v2H5L3 9v2h2v2H3v2l2 2h2v2l2 2h2v-2h2v2l2-2h2v-2h2l2-2v-2h-2v-2h2V9l-2-2h-2V5l-2-2h-2v2h-2V3H9zm0 6h6v6H9V9z"/>
                            </Viewbox>
                        </Border>

                        <!-- Col 1: Text Block -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="CPU-Z" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="View detailed CPU specs, cache, voltage, and per-core clock speeds in real time."
                                       Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Col 2: Action Button -->
                        <Button Grid.Column="2" Width="100" Height="36" Style="{StaticResource PrimaryButton}"
                                Click="BtnLaunchCpuz_Click">
                            <TextBlock Text="LAUNCH" FontSize="12" FontWeight="Bold" Foreground="#000000"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ② GPU-Z -->
                <Border x:Name="CardGpuz" Height="80" Margin="0,0,0,12" Style="{StaticResource ToolCardStyle}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource GlowViolet}"
                                BorderBrush="{DynamicResource GlowViolet}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="{DynamicResource AccentViolet}"
                                      Data="M21 4H3c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm-1 14H4V6h16v12zm-3-8h-2v4h2v-4zm-4 0h-2v4h2v-4zm-4 0H7v4h2v-4z"/>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="GPU-Z" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Monitor GPU model, VRAM, driver version, clocks, and sensor data."
                                       Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Button: LAUNCH PrimaryButton (violet gradient variant) -->
                        <Button Grid.Column="2" Style="{StaticResource VioletPrimaryButtonStyle}"
                                Click="BtnLaunchGpuz_Click">
                            <TextBlock Text="LAUNCH" FontSize="12" FontWeight="Bold" Foreground="#FFFFFF"/>
                        </Button>
                    </Grid>
                </Border>

                <!-- ③ Create System Restore Point -->
                <Border x:Name="CardRestorePoint" Height="80" Margin="0,0,0,12" Style="{StaticResource ToolCardStyle}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource WarningBackground}"
                                BorderBrush="{DynamicResource WarningBorder}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="{DynamicResource WarningAmber}"
                                      Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Create System Restore Point" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Snapshot your registry state before applying heavy tweaks. Serves as a safety net."
                                       Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Buttons: WIZARD + CREATE -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="80" Height="36" Style="{StaticResource ConsoleChipStyle}" Margin="0,0,8,0" Click="BtnOpenSystemRestore_Click" ToolTip="Open Windows System Restore Wizard">
                                <TextBlock Text="WIZARD" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Button x:Name="BtnCreateRestore" Width="90" Height="36" Style="{StaticResource AmberGhostButtonStyle}"
                                    Click="BtnCreateRestore_Click">
                                <TextBlock x:Name="TxtCreateRestoreBtn" Text="CREATE" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ④ Driver Check -->
                <StackPanel Margin="0,0,0,12">
                    <Border x:Name="CardDriverCheck" Height="80" Style="{StaticResource ToolCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                    Background="{DynamicResource MutedBackground}"
                                    BorderBrush="{DynamicResource MutedBorder}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="{DynamicResource TextSecondary}"
                                          Data="M12 1c-4.97 0-9 4.03-9 9v7c0 2.21 1.79 4 4 4h3v-8H5v-3c0-3.87 3.13-7 7-7s7 3.13 7 7v3h-5v8h3c2.21 0 4-1.79 4-4v-7c0-4.97-4.03-9-9-9z"/>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Driver Check" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Detect outdated GPU and chipset drivers and get direct download links."
                                           Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <!-- Button: CHECK GhostButton -->
                            <Button Grid.Column="2" Width="100" Height="36" Style="{StaticResource GhostButton}"
                                    Click="BtnCheckDrivers_Click">
                                <TextBlock x:Name="TxtCheckDriversBtn" Text="CHECK" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Driver Check Results Panel (expands below card) -->
                    <Border x:Name="PanelDriverResults" Margin="12,4,12,0" Padding="18,14"
                            Background="{DynamicResource Surface2}"
                            BorderBrush="{DynamicResource AccentCyan}" BorderThickness="2,0,0,0"
                            CornerRadius="0,8,8,0"
                            Visibility="Collapsed" Height="0" ClipToBounds="True">
                        <StackPanel>
                            <!-- GPU Driver Row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NVIDIA Graphics Driver" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Current: v32.0.16.2101 · Latest Available: v32.0.16.2101" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✓ Up to date" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                            </Grid>
                            <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}" Margin="0,0,0,8"/>

                            <!-- Chipset Driver Row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Intel Chipset Device Software" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="Current: v10.1.19600.8418 · Latest: v10.1.19600.8418" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="✓ Up to date" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ⑤ Auto-Cleanup Scheduler -->
                <Border x:Name="CardScheduler" Height="80" Margin="0,0,0,16" Style="{StaticResource ToolCardStyle}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource SuccessBackground}"
                                BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Viewbox Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="{DynamicResource SuccessGreen}"
                                      Data="M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2zM12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z"/>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Auto-Cleanup Scheduler" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Create a Windows Scheduled Task to run RAM and temp cleanups silently every 3 hours."
                                       Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <!-- Button + Status pill -->
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button x:Name="BtnToggleScheduler" Style="{StaticResource GreenGhostButtonStyle}"
                                    Click="BtnToggleScheduler_Click">
                                <TextBlock x:Name="TxtToggleSchedulerBtn" Text="ENABLE" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                            <TextBlock x:Name="TxtSchedulerStatus" Text="Not scheduled" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ⑥ Context Menu Cleaner -->
                <StackPanel Margin="0,0,0,12">
                    <Border x:Name="CardContextMenu" Height="80" Style="{StaticResource ToolCardStyle}">
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="72"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                    Background="{DynamicResource GlowCyan}"
                                    BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Path Fill="{DynamicResource AccentCyan}"
                                          Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                                </Viewbox>
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Context Menu Cleaner" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Inspect and toggle shell extensions bloating your right-click context menu."
                                           Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="2" Width="100" Height="36" Style="{StaticResource GhostButton}"
                                    Click="BtnScanContextMenu_Click">
                                <TextBlock x:Name="TxtContextMenuBtn" Text="SCAN" FontSize="12" FontWeight="SemiBold"/>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Context Menu Items Results Drawer -->
                    <Border x:Name="PanelContextMenuResults" Margin="0,8,0,0" Padding="18,16"
                            Background="{DynamicResource Surface1}"
                            BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                            CornerRadius="12"
                            Visibility="Collapsed">
                        <StackPanel>
                            <!-- Header Bar: title + count badge + restart explorer action -->
                            <Grid Margin="0,0,0,14">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="EXPLORER SHELL EXTENSIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                    <Border Margin="10,0,0,0" CornerRadius="10" Background="#1400D4FF" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock x:Name="TxtContextMenuCount" Text="Scanning..." FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}"/>
                                    </Border>
                                </StackPanel>

                                <Button HorizontalAlignment="Right" Style="{StaticResource ConsoleChipStyle}" Height="28" Padding="10,0" Click="BtnRestartExplorer_Click" ToolTip="Restart Windows Explorer to apply changes immediately">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="🔄" FontSize="10" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="RESTART EXPLORER" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <!-- Items ScrollViewer without scrollbars -->
                            <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StackContextMenuEntries">
                                    <TextBlock Text="Loading shell handlers..." FontSize="12" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ⑦ Windows Update Controls -->
                <Border x:Name="CardWindowsUpdate" Height="80" Margin="0,0,0,16" Style="{StaticResource ToolCardStyle}">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="72"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Width="48" Height="48" CornerRadius="12"
                                Background="{DynamicResource GlowViolet}"
                                BorderBrush="{DynamicResource GlowViolet}" BorderThickness="1"
                                HorizontalAlignment="Left">
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Fill="{DynamicResource AccentViolet}"
                                      Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
                            </Viewbox>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Windows Update Controls" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock Text="Pause pending background updates for 7 days, open update center, or restart services."
                                       Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Width="80" Height="36" Style="{StaticResource ConsoleChipStyle}" Margin="0,0,8,0" Click="BtnOpenWindowsUpdate_Click" ToolTip="Open Windows Update Settings">
                                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold"/>
                            </Button>
                            <Button x:Name="BtnPauseUpdate" Width="100" Height="36" Style="{StaticResource VioletPrimaryButtonStyle}"
                                    Click="BtnPauseUpdate_Click">
                                <TextBlock x:Name="TxtPauseUpdateBtn" Text="PAUSE 7D" FontSize="11" FontWeight="Bold" Foreground="#FFFFFF"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ── FUTURE TOOLS PLACEHOLDER ── -->
                <Border x:Name="CardFutureTools" Height="64" CornerRadius="12"
                        BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1"
                        Background="Transparent">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Rocket Icon -->
                        <Viewbox Width="16" Height="16" Margin="0,0,10,0">
                            <Path Fill="{DynamicResource TextMuted}"
                                  Data="M12 2.5s-4 4-4 9.5c0 2.5 1 4.5 2 5.5l-1 3.5 3-1.5 3 1.5-1-3.5c1-1 2-3 2-5.5 0-5.5-4-9.5-4-9.5zm-1 8a1 1 0 1 1 2 0 1 1 0 0 1-2 0z"/>
                        </Viewbox>
                        <TextBlock Text="More tools coming in future updates"
                                   FontSize="13" FontStyle="Italic"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
