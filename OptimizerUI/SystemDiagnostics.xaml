<Page x:Class="JamesOptimizer.SystemDiagnostics"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:JamesOptimizer"
      Title="System Diagnostics"
      Background="Transparent"
      FontFamily="{DynamicResource PrimaryFontFamily}"
      Loaded="SystemDiagnostics_Loaded">

    <Page.Resources>
        <!-- Compact Ghost Button -->
        <Style x:Key="DiagnosticsGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="16,0"/>
        </Style>

        <!-- Violet Variant Ghost Button -->
        <Style x:Key="VioletGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentViolet}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource GlowViolet}"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentViolet}" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconOnlyButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Section 1: System Specifications -->
                <RowDefinition Height="Auto"/> <!-- Section 2: System Status & Condition -->
                <RowDefinition Height="Auto"/> <!-- Health Check Results (slides down) -->
                <RowDefinition Height="Auto"/> <!-- Bottom Action Bar -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Heart/pulse icon (AccentCyan, 28px) -->
                    <Viewbox Width="28" Height="28" Margin="0,0,14,0">
                        <Path Fill="{DynamicResource AccentCyan}"
                              Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                    </Viewbox>
                    <TextBlock Text="SYSTEM DIAGNOSTICS" Style="{StaticResource PageTitle}"/>
                </StackPanel>
                <TextBlock Text="Quick health check and detailed system reporting."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderSubtle}" Margin="0,20,0,24" SnapsToDevicePixels="True"/>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION 1: SYSTEM SPECIFICATIONS (GlassCard)
                 ══════════════════════════════════════════════════════════ -->
            <Border x:Name="CardSpecs" Grid.Row="2" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header row -->
                    <Grid Margin="0,0,0,16">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                                <Path Fill="{DynamicResource AccentCyan}"
                                      Data="M20 18c1.1 0 1.99-.9 1.99-2L22 6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/>
                            </Viewbox>
                            <TextBlock Text="SYSTEM SPECIFICATIONS" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtLastUpdated" Text="LAST UPDATED: Just now"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Button Style="{StaticResource IconOnlyButtonStyle}" Click="BtnRefreshSpecs_Click" ToolTip="Refresh Specs">
                                <Viewbox Width="14" Height="14">
                                    <Path Fill="{DynamicResource TextMuted}"
                                          Data="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
                                </Viewbox>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Spec Rows -->
                    <!-- 1. Processor -->
                    <Grid MinHeight="44" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Processor" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtCpuModel" Text="Intel(R) Core(TM) i7-14700F" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <TextBlock x:Name="TxtUptime" Text="System Uptime: 0d 2h 45m" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                    <!-- 2. Graphics Card (GPU) -->
                    <Grid MinHeight="44" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Graphics Card (GPU)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtGpuModel" Text="NVIDIA GeForce RTX 4060 Ti" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                <TextBlock x:Name="TxtGpuDriver" Text="Driver: 32.0.16.2101" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                                <Border CornerRadius="4" Padding="6,1" Background="{DynamicResource SuccessBackground}" BorderBrush="{DynamicResource SuccessBorder}" BorderThickness="1">
                                    <TextBlock Text="UP TO DATE" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}"/>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                    <!-- 3. Memory (RAM) -->
                    <Grid MinHeight="44" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Memory (RAM)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtRamTotal" Text="32537 MB (6000 MHz)" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,16,0"/>
                            <Border Width="100" Height="6" CornerRadius="3" Background="{DynamicResource BorderSubtle}" VerticalAlignment="Center">
                                <ProgressBar x:Name="BarRamUsage" Height="6" Minimum="0" Maximum="100" Value="42" Style="{StaticResource LiquidProgressBar}"/>
                            </Border>
                            <TextBlock x:Name="TxtRamUsagePercent" Text=" 42% used" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                    <!-- 4. Storage (Total) -->
                    <Grid MinHeight="44" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Storage (Total)" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <StackPanel Grid.Column="1" x:Name="StackDrivesDiagnostics" VerticalAlignment="Center">
                            <!-- Dynamic Drive lines populated in code-behind -->
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 SECTION 2: SYSTEM STATUS & CONDITION (GlassCard)
                 ══════════════════════════════════════════════════════════ -->
            <Border x:Name="CardCondition" Grid.Row="3" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Header row -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Viewbox Width="20" Height="20" Margin="0,0,8,0">
                            <Path Fill="{DynamicResource AccentViolet}"
                                  Data="M17 3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V7l-4-4zm-5 16c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm3-10H5V5h10v4z"/>
                        </Viewbox>
                        <TextBlock Text="SYSTEM STATUS &amp; CONDITION" Style="{StaticResource SectionLabel}"/>
                    </StackPanel>

                    <!-- Row 1: Storage Partitions -->
                    <Grid MinHeight="44" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Storage Partitions" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtPartitionCount" Text="3 Drives Detected · NVMe / SATA RAID Ready" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                    <!-- Row 2: Network & IP -->
                    <Grid MinHeight="52" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Network &amp; IP" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <StackPanel Grid.Column="1" x:Name="StackNetworkAdapters" VerticalAlignment="Center">
                            <!-- Populated in code-behind -->
                        </StackPanel>
                    </Grid>
                    <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}"/>

                    <!-- Row 3: PC Condition -->
                    <Grid MinHeight="52" VerticalAlignment="Center" Margin="0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PC Condition" FontSize="13" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Top" Margin="0,8,0,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtOsCondition" Text="Microsoft Windows NT 10.0.26100.0" FontSize="12" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="  •  64-Bit OS: True" FontSize="12" Foreground="{DynamicResource SuccessGreen}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <TextBlock Text="Optimization &amp; Maintenance:" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,6,0,2"/>
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path Fill="{DynamicResource SuccessGreen}"
                                          Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                </Viewbox>
                                <TextBlock Text="SSD Detected: Defragmentation not recommended. TRIM is utilized for optimization."
                                           FontSize="11" Foreground="{DynamicResource SuccessGreen}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 HEALTH CHECK RESULTS PANEL (slides down after check)
                 ══════════════════════════════════════════════════════════ -->
            <Border x:Name="PanelHealthResults" Grid.Row="4" Style="{StaticResource GlassCard}" Padding="24" Margin="0,0,0,20"
                    Visibility="Collapsed" Height="0" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <TextBlock x:Name="TxtHealthTimestamp" Text="HEALTH CHECK RESULTS — Just now" Style="{StaticResource SectionLabel}"/>
                        <Button HorizontalAlignment="Right" Content="✕" Style="{StaticResource IconOnlyButtonStyle}" Click="BtnCloseHealthResults_Click"/>
                    </Grid>

                    <StackPanel x:Name="StackHealthCheckItems">
                        <!-- Populated dynamically -->
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 BOTTOM ACTION BAR (GlassCard bar, full width, height 64px)
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="5" Height="64" Style="{StaticResource GlassCard}" CornerRadius="12" Padding="24,0">
                <Grid VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- RUN HEALTH CHECK GhostButton (AccentCyan) -->
                        <Button x:Name="BtnHealthCheck" Width="200"
                                Style="{StaticResource DiagnosticsGhostButtonStyle}"
                                Click="BtnHealthCheck_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Fill="{DynamicResource AccentCyan}"
                                          Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
                                </Viewbox>
                                <TextBlock x:Name="TxtHealthCheckBtn" Text="RUN HEALTH CHECK" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- EXPORT REPORT GhostButton (AccentViolet) -->
                        <Button x:Name="BtnExportReport" Width="180" Margin="12,0,0,0"
                                Style="{StaticResource VioletGhostButtonStyle}"
                                Click="BtnExportReport_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="16" Height="16" Margin="0,0,8,0">
                                    <Path Fill="{DynamicResource AccentViolet}"
                                          Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L11 12.67V3h2z"/>
                                </Viewbox>
                                <TextBlock Text="EXPORT REPORT" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
