<Page x:Class="JamesOptimizer.StartupManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:JamesOptimizer"
      Title="Startup Manager"
      Background="Transparent"
      FontFamily="{DynamicResource PrimaryFontFamily}"
      Loaded="StartupManager_Loaded">

    <Page.Resources>
        <!-- Tab Button Style -->
        <Style x:Key="StartupTabButtonStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="20,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="TabBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8,8,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource Surface2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="TabBorder" Property="Background" Value="{DynamicResource GlowCyan}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Ghost Button -->
        <Style x:Key="CompactGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="32,28,32,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header -->
                <RowDefinition Height="Auto"/> <!-- Separator -->
                <RowDefinition Height="Auto"/> <!-- Tab Bar -->
                <RowDefinition Height="Auto"/> <!-- Toolbar & Impact Card -->
                <RowDefinition Height="*"/>    <!-- Tab Panes -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- List Icon (AccentCyan, 28px) -->
                    <Viewbox Width="28" Height="28" Margin="0,0,14,0">
                        <Path Fill="{DynamicResource AccentCyan}"
                              Data="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z"/>
                    </Viewbox>
                    <TextBlock Text="STARTUP MANAGER" Style="{StaticResource PageTitle}"/>
                </StackPanel>
                <TextBlock Text="Manage startup applications, services, and autorun keys to improve boot times."
                           Style="{StaticResource BodyText}"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <!-- Separator -->
            <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderSubtle}" Margin="0,20,0,16" SnapsToDevicePixels="True"/>

            <!-- ══════════════════════════════════════════════════════════
                 CUSTOM HORIZONTAL TAB BAR
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2" Margin="0,0,0,16">
                <StackPanel Orientation="Horizontal" x:Name="TabBarPanel">
                    <RadioButton x:Name="TabApps" Content="Startup Apps"
                                 GroupName="StartupTabs" IsChecked="True"
                                 Style="{StaticResource StartupTabButtonStyle}"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="TabServices" Content="Services (Auto)"
                                 GroupName="StartupTabs"
                                 Style="{StaticResource StartupTabButtonStyle}"
                                 Margin="6,0,0,0"
                                 Click="Tab_Click"/>
                    <RadioButton x:Name="TabAutoruns" Content="Registry Autoruns"
                                 GroupName="StartupTabs"
                                 Style="{StaticResource StartupTabButtonStyle}"
                                 Margin="6,0,0,0"
                                 Click="Tab_Click"/>
                </StackPanel>

                <!-- Indicator underline track & animated thumb -->
                <Canvas VerticalAlignment="Bottom" Height="2">
                    <Rectangle Height="1" Width="800" Fill="{DynamicResource BorderSubtle}"/>
                    <Rectangle x:Name="TabActiveIndicator" Height="2" Width="120"
                               Fill="{DynamicResource AccentCyan}"
                               RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="IndicatorTranslate" X="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Canvas>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 TOOLBAR & BOOT IMPACT SUMMARY CARD
                 ══════════════════════════════════════════════════════════ -->
            <StackPanel Grid.Row="3" Margin="0,0,0,16">
                <!-- Toolbar -->
                <Grid Margin="0,0,0,14">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- ↺ Refresh button -->
                        <Button x:Name="BtnRefresh" Style="{StaticResource CompactGhostButtonStyle}"
                                Click="BtnRefresh_Click" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺ " FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- Search bar (220px) -->
                        <Grid Width="220">
                            <TextBox x:Name="TxtSearch"
                                     Style="{StaticResource GlassSearchBar}"
                                     Tag="Search Apps..."
                                     TextChanged="TxtSearch_TextChanged"/>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- ── BOOT IMPACT SUMMARY CARD (Height 60px) ── -->
                <Border Height="60" Style="{StaticResource GlassCard}" Padding="20,0">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Icon + Label -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="18" Height="18" Margin="0,0,10,0">
                                <Path Fill="{DynamicResource AccentCyan}"
                                      Data="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z"/>
                            </Viewbox>
                            <TextBlock Text="STARTUP IMPACT" Style="{StaticResource SectionLabel}"/>
                        </StackPanel>

                        <!-- Center: Mini impact level bar (green -> amber -> red) -->
                        <Border Grid.Column="1" Height="6" CornerRadius="3" Background="{DynamicResource BorderSubtle}"
                                Margin="32,0,32,0" MaxWidth="320">
                            <ProgressBar x:Name="BarBootImpact" Height="6" Minimum="0" Maximum="100" Value="35"
                                         Style="{StaticResource LiquidProgressBar}"/>
                        </Border>

                        <!-- Right: Status text -->
                        <TextBlock Grid.Column="2" x:Name="TxtBootImpactSummary"
                                   Text="4 apps enabled — estimated boot delay: ~1.2s"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondary}"
                                   VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- ══════════════════════════════════════════════════════════
                 TAB CONTENT AREA
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="4" x:Name="TabContentContainer">
                <!-- ── TAB 1: STARTUP APPS ── -->
                <StackPanel x:Name="PaneApps" Visibility="Visible">
                    <ItemsControl x:Name="ListStartupApps">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,8">
                                    <!-- Main Row (Height 60px) -->
                                    <Border Height="60" Style="{StaticResource GlassCard}" CornerRadius="12" Padding="16,0">
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/> <!-- App Icon -->
                                                <ColumnDefinition Width="*"/>    <!-- Name + Impact Badge -->
                                                <ColumnDefinition Width="Auto"/> <!-- More Info + Toggle -->
                                            </Grid.ColumnDefinitions>

                                            <!-- Left: App Icon (32×32px) -->
                                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                    Background="{DynamicResource Surface2}" Margin="0,0,16,0">
                                                <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Path Fill="{DynamicResource AccentCyan}"
                                                          Data="M4 8h4V4H4v4zm6 12h4v-4h-4v4zm-6 0h4v-4H4v4zm0-6h4v-4H4v4zm6 0h4v-4h-4v4zm6-10v4h4V4h-4zm-6 4h4V4h-4v4zm6 6h4v-4h-4v4zm0 6h4v-4h-4v4z"/>
                                                </Viewbox>
                                            </Border>

                                            <!-- Center: App Name + Impact Badge -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,12,0"/>
                                                <!-- Impact Badge -->
                                                <Border CornerRadius="6" Padding="8,2"
                                                        Background="{Binding ImpactBg}" BorderBrush="{Binding ImpactBorder}" BorderThickness="1">
                                                    <TextBlock Text="{Binding ImpactText}" FontSize="10" FontWeight="Bold" Foreground="{Binding ImpactFg}"/>
                                                </Border>
                                            </StackPanel>

                                            <!-- Right: "More info" link + Toggle Switch -->
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="More info" Cursor="Hand"
                                                           FontSize="12" Foreground="{DynamicResource AccentCyan}"
                                                           VerticalAlignment="Center" Margin="0,0,20,0"
                                                           Tag="{Binding}" MouseDown="BtnMoreInfo_Click"/>

                                                <!-- Toggle Switch -->
                                                <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                          Style="{StaticResource ToggleSwitch}"
                                                          Tag="{Binding}"
                                                          Click="ToggleApp_Click"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- Expandable Accordion Panel (hidden by default) -->
                                    <Border Visibility="{Binding IsAccordionVisible, Converter={x:Static local:VisibilityConverter.Instance}}"
                                            Margin="12,4,12,0" Padding="18,14"
                                            Background="{DynamicResource Surface2}"
                                            BorderBrush="{DynamicResource AccentCyan}"
                                            BorderThickness="2,0,0,0"
                                            CornerRadius="0,8,8,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Executable Path:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="{DynamicResource MonospaceFontFamily}"
                                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Publisher:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding Publisher}" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="Impact Rating:" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding ImpactText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{Binding ImpactFg}" HorizontalAlignment="Right"/>
                                            </Grid>
                                            <TextBlock Text="{Binding Recommendation}" FontSize="11" FontStyle="Italic"
                                                       Foreground="{DynamicResource AccentCyan}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── TAB 2: SERVICES (AUTO) ── -->
                <StackPanel x:Name="PaneServices" Visibility="Collapsed">
                    <ItemsControl x:Name="ListStartupServices">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="60" Margin="0,0,0,8" Style="{StaticResource GlassCard}" CornerRadius="12" Padding="16,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                Background="{DynamicResource Surface2}" Margin="0,0,16,0">
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Fill="{DynamicResource AccentViolet}"
                                                      Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Toggle Switch: ON = Auto, OFF = Disabled -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Startup: Auto" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                      Style="{StaticResource ToggleSwitch}"
                                                      Tag="{Binding}"
                                                      Click="ToggleService_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── TAB 3: REGISTRY AUTORUNS ── -->
                <StackPanel x:Name="PaneAutoruns" Visibility="Collapsed">
                    <ItemsControl x:Name="ListStartupAutoruns">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="64" Margin="0,0,0,8" Style="{StaticResource GlassCard}" CornerRadius="12" Padding="16,0"
                                        BorderBrush="{Binding DeleteConfirmationBorder}">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                                Background="{DynamicResource Surface2}" Margin="0,0,16,0">
                                            <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Path Fill="{DynamicResource WarningAmber}"
                                                      Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Source}" FontSize="11" FontFamily="{DynamicResource MonospaceFontFamily}" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Right: Delete / Confirm Delete -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Normal Delete Button -->
                                            <Button Visibility="{Binding IsConfirmingDelete, Converter={x:Static local:InverseVisibilityConverter.Instance}}"
                                                    Width="34" Height="34" Style="{StaticResource DangerButton}"
                                                    Padding="0" Tag="{Binding}" Click="BtnDeleteAutorun_Click" ToolTip="Delete Autorun Key">
                                                <Viewbox Width="14" Height="14">
                                                    <Path Fill="{DynamicResource DangerRed}"
                                                          Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                </Viewbox>
                                            </Button>

                                            <!-- Inline Confirmation: "Confirm Delete?" Yes / Cancel -->
                                            <StackPanel Visibility="{Binding IsConfirmingDelete, Converter={x:Static local:VisibilityConverter.Instance}}"
                                                        Orientation="Horizontal">
                                                <TextBlock Text="Confirm Delete?" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerRed}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <Button Content="Yes" Height="28" Width="42" Style="{StaticResource DangerButton}" Padding="0" Tag="{Binding}" Click="BtnConfirmDelete_Click" Margin="0,0,4,0"/>
                                                <Button Content="No" Height="28" Width="42" Style="{StaticResource GhostButton}" Padding="0" Tag="{Binding}" Click="BtnCancelDelete_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ── EMPTY STATE ── -->
                <Border x:Name="EmptyStateBorder" Visibility="Collapsed" Margin="0,48,0,0" HorizontalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12">
                            <Path Fill="{DynamicResource TextMuted}"
                                  Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                        </Viewbox>
                        <TextBlock Text="No startup items found" Style="{StaticResource CardTitle}" HorizontalAlignment="Center"/>
                        <TextBlock Text="Try a different search term" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</Page>
