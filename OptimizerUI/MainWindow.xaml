                                                    <!-- Gradient Fill for Upload -->
                                                    <Polygon x:Name="GraphUploadFill">
                                                        <Polygon.Fill>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#661A73E8" Offset="0"/>
                                                                <GradientStop Color="#001A73E8" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Polygon.Fill>
                                                    </Polygon>
                                                    <Polyline x:Name="GraphUpload" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" StrokeDashArray="2 2" />
                                                    <Polyline x:Name="GraphDownload" Stroke="#00FF88" StrokeThickness="2" />
                                                </Canvas>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Grid>

                    </Grid>
                </Grid>
            <!-- Removed extra Grid closing tag -->


            <!-- CONFIRMATION OVERLAY -->
            <Grid x:Name="ConfirmationOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B2000000" Panel.ZIndex="100">
                <Border x:Name="ConfirmationCard" Background="#15151F" BorderBrush="#33FFD93D" BorderThickness="1" CornerRadius="15" 
                        Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ConfirmationCardScale" ScaleX="0.8" ScaleY="0.8" CenterX="200" CenterY="100"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#FFD93D" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Animated Checkmark/Icon -->
                        <TextBlock Text="&#x2705;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="ConfirmationIconScale" ScaleX="0" ScaleY="0" CenterX="20" CenterY="20"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        
                        <TextBlock x:Name="TxtConfirmationTitle" Text="CONFIRM" FontSize="20" FontWeight="Black" Foreground="#FFD93D" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtConfirmationMessage" Text="Are you sure?" FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,25"/>
                        
                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <Button Grid.Column="0" Content="NO" Height="40" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource DangerLightBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" Click="BtnConfirmNo_Click" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Button.RenderTransform>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NoBtnBorder" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="NoBgColor" Color="#33FF6B6B"/>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="NoBgColor" Storyboard.TargetProperty="Color" To="#55FF6B6B" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="NoBgColor" Storyboard.TargetProperty="Color" To="#33FF6B6B" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="NoBtnBorder" Property="Background" Value="#77FF6B6B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06"/>
                                        </Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                            
                            <Button Grid.Column="2" Content="YES" Height="40" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource SuccessLightBrush}" BorderBrush="#00FF88" BorderThickness="1" Click="BtnConfirmYes_Click" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                <Button.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Button.RenderTransform>
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="YesBtnBorder" CornerRadius="10" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Background>
                                                <SolidColorBrush x:Name="YesBgColor" Color="#3300FF88"/>
                                            </Border.Background>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="YesBgColor" Storyboard.TargetProperty="Color" To="#5500FF88" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="YesBgColor" Storyboard.TargetProperty="Color" To="#3300FF88" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="YesBtnBorder" Property="Background" Value="#7700FF88"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                                <Button.Triggers>
                                    <EventTrigger RoutedEvent="PreviewMouseDown">
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.95" Duration="0:0:0.06"/>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.95" Duration="0:0:0.06"/>
                                        </Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                    <EventTrigger RoutedEvent="PreviewMouseUp">
                                        <BeginStoryboard><Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12">
                                                <DoubleAnimation.EasingFunction><QuadraticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard></BeginStoryboard>
                                    </EventTrigger>
                                </Button.Triggers>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- FEEDBACK OVERLAY -->
            <Grid x:Name="FeedbackOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#B2000000" Panel.ZIndex="100">
                <Border x:Name="FeedbackCard" Background="#15151F" BorderBrush="{DynamicResource AccentLightBrush}" BorderThickness="1" CornerRadius="15" 
                        Width="350" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="FeedbackCardScale" ScaleX="0.8" ScaleY="0.8" CenterX="175" CenterY="100"/>
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#00D2FF" Opacity="0.3"/>
                    </Border.Effect>
                    <StackPanel>
                        <!-- Animated Checkmark/Icon -->
                        <TextBlock Text="&#x2705;" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10">
                            <TextBlock.RenderTransform>
                                <ScaleTransform x:Name="FeedbackIconScale" ScaleX="0" ScaleY="0" CenterX="20" CenterY="20"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        
                        <TextBlock Text="COMPLETED!" FontSize="20" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                        <TextBlock x:Name="TxtFeedbackMessage" Text="Optimization applied successfully." FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,15"/>
                        
                        <!-- Recommendation / Score -->
                        <Border Background="#1A00FF88" BorderBrush="{DynamicResource SuccessBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,25">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="&#x26A1; Score Boost: " Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12"/>
                                <TextBlock x:Name="TxtScoreBoost" Text="+15" Foreground="{DynamicResource SuccessBrush}" FontSize="12" FontWeight="Bold"/>
                                <TextBlock Text="  |  " Foreground="#33FFFFFF" FontSize="12"/>
                                <TextBlock Text="Check Dashboard for results" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                        
                        <!-- The OK Button with smooth animation -->
                        <Button x:Name="BtnFeedbackOk" Content="OK" Height="40" Width="120" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Background="{DynamicResource AccentLightBrush}" BorderBrush="#00D2FF" BorderThickness="1" Click="BtnFeedbackOk_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="OkBtnBorder" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                        <Border.Background>
                                            <SolidColorBrush Color="#3300D2FF"/>
                                        </Border.Background>
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <EventTrigger RoutedEvent="MouseEnter">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="OkBtnBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#6600D2FF" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <EventTrigger RoutedEvent="MouseLeave">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="OkBtnBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#3300D2FF" Duration="0:0:0.2"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="OkBtnBorder" Property="Background" Value="#9900D2FF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- LOADING OVERLAY -->
            <Grid x:Name="LoadingOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#D8000000" Panel.ZIndex="150">
                <Border Background="#101018" BorderBrush="#2200D2FF" BorderThickness="1" CornerRadius="12" 
                        Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
                    <StackPanel>
                        <TextBlock x:Name="TxtLoadingTitle" Text="Optimizing..." FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                        
                                                <Border x:Name="ProgressBarTrack" Height="10" Background="#22FFFFFF" CornerRadius="5" Margin="0,0,0,20" HorizontalAlignment="Stretch">
                            <Border x:Name="ProgressBarIndicator" CornerRadius="5" HorizontalAlignment="Left" Width="0" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#007ACC" Offset="0"/>
                                        <GradientStop Color="#00D2FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <!-- Sweeping Glow Animation -->
                                <Border Width="80" HorizontalAlignment="Left">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                                            <GradientStop Color="#66FFFFFF" Offset="0.5"/>
                                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Border.Background>
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="GlowTransform" X="-80"/>
                                    </Border.RenderTransform>
                                    <Border.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard>
                                                    <DoubleAnimation Storyboard.TargetName="GlowTransform" 
                                                                     Storyboard.TargetProperty="X" 
                                                                     From="-80" To="400" 
                                                                     Duration="0:0:1.5" 
                                                                     RepeatBehavior="Forever" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Border.Triggers>
                                </Border>
                            </Border>
                        </Border>
                        
                        <TextBlock x:Name="TxtLoadingMessage" Text="Please wait while the operation completes." FontSize="14" Foreground="#AAAAAA" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- RESTART OVERLAY -->
            <Grid x:Name="RestartOverlay" Grid.RowSpan="2" Visibility="Collapsed" Background="#CC000000" Panel.ZIndex="200">
                <Border x:Name="RestartCard" Background="#0D0D1A"
                        BorderThickness="1.5" CornerRadius="20"
                        Width="480" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="40">
                    <Border.BorderBrush>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF9900" Offset="0"/>
                            <GradientStop Color="#FF4400" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.BorderBrush>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="60" ShadowDepth="0" Color="#FF6600" Opacity="0.8"/>
                    </Border.Effect>
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="RestartCardScale" ScaleX="0.85" ScaleY="0.85" CenterX="240" CenterY="180"/>
                    </Border.RenderTransform>
                    <Border.Triggers>
                        <EventTrigger RoutedEvent="Border.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="RestartCardScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                    <DoubleAnimation Storyboard.TargetName="RestartCardScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.4">
                                        <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.3"/></DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Border.Triggers>
                    <StackPanel HorizontalAlignment="Center">

                        <!-- Icon -->
                        <TextBlock Text="&#x1F504;" FontSize="52" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                        <!-- Headline -->
                        <TextBlock Text="RESTART REQUIRED" FontSize="22" FontWeight="Black"
                                   HorizontalAlignment="Center" Margin="0,0,0,8" TextAlignment="Center">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF9900" Offset="0"/>
                                    <GradientStop Color="#FFDD00" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#FF9900" Opacity="1"/>
                            </TextBlock.Effect>
                        </TextBlock>

                        <!-- Sub text -->
                        <TextBlock Text="Your GPU optimizations and Virtual Memory settings have been applied successfully. A restart is required for all changes to take full effect."
                                   FontSize="13" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap"
                                   HorizontalAlignment="Center" TextAlignment="Center" Margin="0,0,0,30"/>

                        <!-- Buttons -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="15"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Restart Later -->
                            <Button Grid.Column="0" x:Name="BtnRestartLater" Height="46"
                                    Content="RESTART LATER" FontSize="13" FontWeight="Bold"
                                    Foreground="#AAAAAA" Background="#22FFFFFF"
                                    BorderBrush="#44FFFFFF" BorderThickness="1"
                                    Cursor="Hand" Click="BtnRestartLater_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="LaterBorder" CornerRadius="10"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="LaterBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#44FFFFFF" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="LaterBorder" Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)" To="#22FFFFFF" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <!-- Restart Now -->
                            <Button Grid.Column="2" x:Name="BtnRestartNow" Height="46"
                                    Content="&#x26A1;  RESTART NOW" FontSize="14" FontWeight="Black"
                                    Foreground="{DynamicResource PrimaryTextBrush}" Background="#CCFF6600"
                                    BorderBrush="#FF9900" BorderThickness="1.5"
                                    Cursor="Hand" Click="BtnRestartNow_Click">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="NowBorder" CornerRadius="10"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#CC882200" Offset="0"/>
                                                    <GradientStop Color="#CCFF6600" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="25" ShadowDepth="0" Color="#FF6600" Opacity="0.9"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <EventTrigger RoutedEvent="MouseEnter">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="NowBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FFDD00" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                            <EventTrigger RoutedEvent="MouseLeave">
                                                <BeginStoryboard><Storyboard>
                                                    <ColorAnimation Storyboard.TargetName="NowBorder" Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF9900" Duration="0:0:0.2"/>
                                                </Storyboard></BeginStoryboard>
                                            </EventTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
            <!-- END RESTART OVERLAY -->

            <!-- NEW WALKTHROUGH OVERLAY -->
            <local:WalkthroughOverlay x:Name="MasterWalkthrough" Panel.ZIndex="9999" />

            <!-- Toast Container - Top Right -->
            <ItemsControl x:Name="ToastContainer" 
                          Grid.RowSpan="2" 
                          Panel.ZIndex="1000"
                          HorizontalAlignment="Right" 
                          VerticalAlignment="Top" 
                          Margin="0,60,20,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Vertical" VerticalAlignment="Top" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>
    </Border>
</Window>
