<Window x:Class="JamesOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JamesOptimizer"
        Title="JAMES OPTIMIZER v3.0.0"
        Height="860" Width="1340"
        MinHeight="620" MinWidth="960"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="{DynamicResource PrimaryFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Icon="pack://application:,,,/app_icon.ico"
        Loaded="MainWindow_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="52"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="-1"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ── CAPTION BUTTON STYLES (Minimize / Maximize / Close) ── -->
        <Style x:Key="CaptionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource Surface2}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CaptionCloseButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="6" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBorder" Property="Background" Value="{DynamicResource DangerRed}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── SIDEBAR NAVIGATION ITEM STYLE ── -->
        <Style x:Key="SidebarNavItemStyle" TargetType="RadioButton">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Margin" Value="10,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="ItemRoot" Height="46" Background="Transparent">
                            <!-- Left Accent Indicator Bar on Rail Edge (Clean separation, no corner clip) -->
                            <Border x:Name="AccentBar"
                                    Width="3.5"
                                    Height="22"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentCyan}"
                                    CornerRadius="1.75"
                                    Margin="0,0,0,0"
                                    Visibility="Collapsed">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="8" Opacity="0.8" ShadowDepth="0"/>
                                </Border.Effect>
                            </Border>

                            <Border x:Name="RowBorder"
                                    CornerRadius="10"
                                    Margin="8,2,8,2"
                                    Background="{TemplateBinding Background}"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    SnapsToDevicePixels="True">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="ContentShift" X="0"/>
                                </Border.RenderTransform>
                                <Grid>
                                    <!-- Content Stack: Icon + Label -->
                                    <StackPanel Orientation="Horizontal" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <Viewbox Width="19" Height="19" Stretch="Uniform" VerticalAlignment="Center">
                                            <Path x:Name="NavIcon" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Fill="{DynamicResource TextMuted}" Stretch="Uniform"/>
                                        </Viewbox>
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- Hover state: Smooth background highlight, white icon and label, subtle slide -->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource Surface2}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
                                <Setter TargetName="NavIcon" Property="Fill" Value="{DynamicResource TextPrimary}"/>
                            </MultiTrigger>

                            <!-- Active / Selected state: Electric gradient pill, luminous accent bar, glowing icon, pure white text -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource NavActiveGradient}"/>
                                <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="NavIcon" Property="Fill" Value="{DynamicResource AccentCyan}"/>
                                <Setter TargetName="NavIcon" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="8" Opacity="0.7" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Setter TargetName="RowBorder" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}"/>
                                <Setter TargetName="RowBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="16" Opacity="0.25" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Nav Label Style -->
        <Style x:Key="SidebarNavLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
    </Window.Resources>

    <!-- ── ROOT CONTAINER ── -->
    <Border x:Name="RootBorder"
            Background="{DynamicResource AppBackground}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            ClipToBounds="True">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="52"/> <!-- Row 0: Custom TitleBar -->
                <RowDefinition Height="*"/>  <!-- Row 1: Main Content Area -->
            </Grid.RowDefinitions>

            <!-- ── ATMOSPHERIC AMBIENT GLOW (JamesGui Cinematic Lighting) ── -->
            <Grid Grid.RowSpan="2" IsHitTestVisible="False" ClipToBounds="True">
                <!-- Top-Right: Cool Subtle Dark Indigo Glow (Zero Coral Discoloration, Contained Bounds) -->
                <Ellipse HorizontalAlignment="Right" VerticalAlignment="Top"
                         Width="400" Height="400" Margin="0,-120,-120,0"
                         Opacity="0.04">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#00F5FF" Offset="0"/>
                            <GradientStop Color="#0000F5FF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <!-- Bottom-Left: Deep Violet/Purple Ambient Glow -->
                <Ellipse HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Width="500" Height="500" Margin="-180,0,0,-180"
                         Opacity="0.08">
                    <Ellipse.Fill>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#7C3AED" Offset="0"/>
                            <GradientStop Color="#007C3AED" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 CUSTOM TITLEBAR (Row 0)
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TitlebarBackground}"
                    BorderBrush="{DynamicResource BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    SnapsToDevicePixels="True">
                <Grid Margin="16,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" MinWidth="220"/> <!-- Left section: Brand Lockup -->
                        <ColumnDefinition Width="*"/>                  <!-- Center section: Status Pill -->
                        <ColumnDefinition Width="Auto"/>                 <!-- Right section: Caption Buttons (Flush) -->
                    </Grid.ColumnDefinitions>

                    <!-- Left section: Redesigned Multi-Layered Animated Cyber Emblem + Modern Brand Lockup -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" ToolTip="James Optimizer Pro · Ultra Performance Suite">
                        <!-- Multi-Layered Animated Cyber Emblem (32×32) -->
                        <Grid Width="32" Height="32" Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                            <!-- Background Ambient Luminous Glow -->
                            <Ellipse Width="24" Height="24" Fill="{DynamicResource GlowCyan}" Margin="4"/>

                            <!-- Layer 1: Outer Rotating Gradient Orbital Ring -->
                            <Grid Width="30" Height="30" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="LogoRotationTransform" Angle="0"/>
                                </Grid.RenderTransform>
                                <Ellipse Width="28" Height="28"
                                         StrokeThickness="1.5"
                                         StrokeDashArray="5 2 1 2"
                                         Opacity="0.95">
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#00E5FF" Offset="0"/>
                                            <GradientStop Color="#8A67FF" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                </Ellipse>
                                <!-- Satellite orbital node -->
                                <Ellipse Width="3" Height="3" Fill="#00E5FF" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-0.5,0"/>
                            </Grid>

                            <!-- Layer 2: Inner Counter-Rotating Hex Orbit -->
                            <Grid Width="22" Height="22" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="LogoCounterRotationTransform" Angle="0"/>
                                </Grid.RenderTransform>
                                <Path Data="M11,1 L20,6 L20,16 L11,21 L2,16 L2,6 Z"
                                      Stroke="#8A67FF"
                                      StrokeThickness="1"
                                      Opacity="0.55"
                                      Fill="Transparent"
                                      Stretch="Uniform"
                                      Width="18" Height="18"/>
                            </Grid>

                            <!-- Layer 3: Central Brand Core with Continuous Breathing Scale -->
                            <Grid Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="LogoCoreScale" ScaleX="1.0" ScaleY="1.0"/>
                                </Grid.RenderTransform>
                                <Image Source="pack://application:,,,/Assets/logo-64.png"
                                       Width="18" Height="18"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       SnapsToDevicePixels="True"
                                       HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Image.Effect>
                                        <DropShadowEffect x:Name="LogoCoreGlow" Color="#00E5FF" BlurRadius="12" Opacity="0.9" ShadowDepth="0"/>
                                    </Image.Effect>
                                </Image>
                            </Grid>
                        </Grid>

                        <!-- Brand Lockup: Modern Typography with High Contrast -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="JAMES"
                                       FontSize="14"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="OPTIMIZER"
                                       FontSize="14"
                                       FontWeight="Black"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0">
                                <TextBlock.Foreground>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00E5FF" Offset="0"/>
                                        <GradientStop Color="#8A67FF" Offset="1"/>
                                    </LinearGradientBrush>
                                </TextBlock.Foreground>
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#00E5FF" BlurRadius="10" Opacity="0.35" ShadowDepth="0"/>
                                </TextBlock.Effect>
                            </TextBlock>

                            <!-- Modern Pro Version Pill -->
                            <Border CornerRadius="6"
                                    Background="#1F00E5FF"
                                    BorderBrush="#4D00E5FF"
                                    BorderThickness="1"
                                    Padding="7,2"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="PRO v3.2"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentCyan}"/>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <!-- Center section: Windows 11 Fluent System Pill Badge + Command Palette Quick Action Trigger -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border x:Name="StatusSystemPill"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                CornerRadius="16"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Padding="14,5"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="14" Opacity="0.35" ShadowDepth="0"/>
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <!-- Windows Fluent 4-Pane Icon -->
                                <Canvas Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Path Fill="{DynamicResource AccentCyan}" Data="M0,0 H5.8 V5.8 H0 Z M7.2,0 H13 V5.8 H7.2 Z M0,7.2 H5.8 V13 H0 Z M7.2,7.2 H13 V13 H7.2 Z"/>
                                </Canvas>
                                <TextBlock x:Name="TxtOsVersion"
                                           Text="Windows 11 Pro · 64-bit"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <Rectangle Width="1" Height="10" Fill="{DynamicResource BorderSubtle}" Margin="10,0,10,0" VerticalAlignment="Center"/>
                                <!-- Animated Emerald Status Dot -->
                                <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessGreen}" Margin="0,0,5,0" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#00FF9D" BlurRadius="8" Opacity="0.9" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock Text="SYSTEM READY"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource SuccessGreen}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Command Palette Trigger (Ctrl+K) -->
                        <Border x:Name="BtnOpenCommandPalette"
                                MouseLeftButtonUp="BtnOpenCommandPalette_Click"
                                Cursor="Hand"
                                CornerRadius="16"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                Padding="12,5"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="Open Quick Actions &amp; Command Palette (Ctrl+K)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Fill="{DynamicResource AccentCyan}" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0"/>
                                <TextBlock Text="Quick Actions..." FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                                <Border Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="8,0,0,0">
                                    <TextBlock Text="Ctrl+K" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right section: Caption buttons (Minimize, Maximize/Restore, Close) -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Minimize Button (46×32px, dash icon) -->
                        <Button x:Name="BtnMinimize" Style="{StaticResource CaptionButtonStyle}" Click="BtnMinimize_Click" ToolTip="Minimize">
                            <Path Data="M0,0 L10,0" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>

                        <!-- Maximize / Restore Button (46×32px, square/restore icon) -->
                        <Button x:Name="BtnMaximize" Style="{StaticResource CaptionButtonStyle}" Click="BtnMaximize_Click" ToolTip="Maximize / Restore">
                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path x:Name="IconMaximize" Data="M0,0 H10 V10 H0 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2" Fill="Transparent"/>
                                <Path x:Name="IconRestore" Data="M2,0 H10 V8 H8 V10 H0 V2 H2 Z M2,2 V8 H8 V2 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1" Fill="Transparent" Visibility="Collapsed"/>
                            </Grid>
                        </Button>

                        <!-- Close Button (46×32px, X icon) -->
                        <Button x:Name="BtnClose" Style="{StaticResource CaptionCloseButtonStyle}" Click="BtnClose_Click" ToolTip="Close">
                            <Path Data="M0,0 L9,9 M9,0 L0,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 MAIN CONTENT AREA (Row 1): Sidebar + Content Frame
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/> <!-- Column 0: Sidebar -->
                    <ColumnDefinition Width="*"/>    <!-- Column 1: Content Frame -->
                </Grid.ColumnDefinitions>

                <!-- ── SIDEBAR (Left column, starts at Row 1) ── -->
                <Border x:Name="SidebarContainer"
                        Grid.Column="0"
                        Width="220"
                        Background="{DynamicResource SidebarBackground}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="0,0,1,0"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Top: Hamburger Button -->
                            <RowDefinition Height="*"/>    <!-- Middle: Nav Items -->
                            <RowDefinition Height="Auto"/> <!-- Bottom: JE Badge / Profile -->
                        </Grid.RowDefinitions>

                        <!-- Left border: accent hairline at rail edge -->
                        <Rectangle Grid.RowSpan="3" Width="2" HorizontalAlignment="Left" Fill="{DynamicResource BorderAccent}" SnapsToDevicePixels="True"/>

                        <!-- Expand / Collapse trigger: hamburger button at top of sidebar -->
                        <Button x:Name="BtnToggleSidebar"
                                Grid.Row="0"
                                Width="40" Height="40"
                                Margin="12,12,12,6"
                                HorizontalAlignment="Left"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Click="BtnToggleSidebar_Click"
                                ToolTip="Toggle Sidebar">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="10">
                                        <!-- 3-line hamburger icon -->
                                        <Path Data="M0,0 H14 M0,5 H14 M0,10 H14"
                                              Stroke="{DynamicResource TextSecondary}"
                                              StrokeThickness="1.8"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Surface2}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>

                        <!-- Navigation items (top section, ScrollViewer + StackPanel) -->
                        <ScrollViewer Grid.Row="1"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,4,0,4">
                            <StackPanel x:Name="SidebarNavStack">
                                <!-- 1. Dashboard — grid/home icon -->
                                <RadioButton x:Name="NavDashboard" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" IsChecked="True" Click="NavButton_Click"
                                             Tag="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z">
                                    <TextBlock x:Name="LblDashboard" Text="Dashboard" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 2. System Cleanups — broom/trash icon -->
                                <RadioButton x:Name="NavCleanups" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M19.36 2.72l1.42 1.42-3.18 3.18-1.42-1.42 3.18-3.18zM6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z">
                                    <TextBlock x:Name="LblCleanups" Text="System Cleanups" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 3. Performance Tweaks — rocket/gear icon -->
                                <RadioButton x:Name="NavTweaks" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z">
                                    <TextBlock x:Name="LblTweaks" Text="Performance Tweaks" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 4. Gaming Mode — gamepad/controller icon -->
                                <RadioButton x:Name="NavGaming" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm3-3c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z">
                                    <TextBlock x:Name="LblGaming" Text="Gaming Mode" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 5. Startup Apps — rocket launch icon -->
                                <RadioButton x:Name="NavStartup" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M13 3h-2v10h2V3zm4.83 2.17l-1.42 1.42C17.99 7.86 19 9.81 19 12c0 3.87-3.13 7-7 7s-7-3.13-7-7c0-2.19 1.01-4.14 2.58-5.42L6.17 5.17C4.23 6.82 3 9.26 3 12c0 4.97 4.03 9 9 9s9-4.03 9-9c0-2.74-1.23-5.18-3.17-6.83z">
                                    <TextBlock x:Name="LblStartup" Text="Startup Apps" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 6. Windows Services — server/layers icon -->
                                <RadioButton x:Name="NavServices" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M19 3H5c-1.1 0-2 .9-2 2v4c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 10H5c-1.1 0-2 .9-2 2v4c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-4c0-1.1-.9-2-2-2z">
                                    <TextBlock x:Name="LblServices" Text="Services" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- Separator line (1px BorderSubtle, 24px margin) between items 6 and 7 -->
                                <Rectangle Height="1" Fill="{DynamicResource BorderSubtle}" Margin="16,24,16,24" SnapsToDevicePixels="True"/>

                                <!-- 6. Network Boost — globe/wifi icon -->
                                <RadioButton x:Name="NavNetwork" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z">
                                    <TextBlock x:Name="LblNetwork" Text="Network Boost" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 7. Storage — drive/floppy icon -->
                                <RadioButton x:Name="NavStorage" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z">
                                    <TextBlock x:Name="LblStorage" Text="Storage" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 8. Toolbox — wrench icon -->
                                <RadioButton x:Name="NavToolbox" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z">
                                    <TextBlock x:Name="LblToolbox" Text="Toolbox" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 9. Diagnostics — heart/pulse icon -->
                                <RadioButton x:Name="NavDiagnostics" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M3 13h3.5l2-5 3.5 10 2.5-7 1.5 4 2-2H21v-2h-4.5l-2 2-1.5-4-2.5 7-3.5-10-2 5H3v3z">
                                    <TextBlock x:Name="LblDiagnostics" Text="Diagnostics" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 9. Settings — gear icon -->
                                <RadioButton x:Name="NavSettings" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z">
                                    <TextBlock x:Name="LblSettings" Text="Settings" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>

                                <!-- 10. About — info icon -->
                                <RadioButton x:Name="NavAbout" Style="{StaticResource SidebarNavItemStyle}" GroupName="SidebarNav" Click="NavButton_Click"
                                             Tag="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z">
                                    <TextBlock x:Name="LblAbout" Text="About" Style="{StaticResource SidebarNavLabel}"/>
                                </RadioButton>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Bottom section (pinned to sidebar bottom) -->
                        <Grid Grid.Row="2" Margin="0,0,0,16">
                            <!-- Collapsed view: Only show modern emblem badge (40×40px, status dot, glow) -->
                            <Border x:Name="FooterCollapsed"
                                    Width="40" Height="40"
                                    CornerRadius="10"
                                    HorizontalAlignment="Center"
                                    Background="{DynamicResource Surface1}"
                                    BorderBrush="{DynamicResource CardGlassBorderGradient}"
                                    BorderThickness="1"
                                    Visibility="Collapsed"
                                    ToolTip="James God — James Optimizer Pro v3.2">
                                <Grid>
                                    <Border Width="30" Height="30" CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#00E5FF" Offset="0"/>
                                                <GradientStop Color="#8A67FF" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                        <Border.Effect>
                                            <DropShadowEffect Color="#00E5FF" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                        </Border.Effect>
                                        <!-- Turbo speed bolt in center -->
                                        <Path Data="M7,1 L12,6 L8,7 L11,13 L3,8 L7,7 Z"
                                              Fill="#FFFFFF"
                                              Stretch="Uniform"
                                              Width="14" Height="14"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <!-- Green Status indicator dot -->
                                    <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessGreen}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,3,3,0">
                                        <Ellipse.Effect>
                                            <DropShadowEffect Color="#00FF9D" BlurRadius="6" Opacity="0.9" ShadowDepth="0"/>
                                        </Ellipse.Effect>
                                    </Ellipse>
                                </Grid>
                            </Border>

                            <!-- Expanded view: Modern Glass Profile Card with Verified Badge and System Engine Status -->
                            <Border x:Name="FooterExpanded"
                                    Margin="10,0"
                                    Padding="10,8"
                                    CornerRadius="12"
                                    Background="{DynamicResource Surface1}"
                                    BorderBrush="{DynamicResource CardGlassBorderGradient}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True"
                                    Visibility="Visible">
                                <Border.Effect>
                                    <DropShadowEffect Color="#000000" BlurRadius="16" Opacity="0.35" ShadowDepth="2"/>
                                </Border.Effect>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Avatar / Turbo emblem container with status indicator -->
                                    <Grid Grid.Column="0">
                                        <Border Width="38" Height="38" CornerRadius="9">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#00E5FF" Offset="0"/>
                                                    <GradientStop Color="#8A67FF" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect Color="#00E5FF" BlurRadius="12" Opacity="0.35" ShadowDepth="0"/>
                                            </Border.Effect>
                                            <!-- Turbo speed bolt -->
                                            <Path Data="M7,1 L12,6 L8,7 L11,13 L3,8 L7,7 Z"
                                                  Fill="#FFFFFF"
                                                  Stretch="Uniform"
                                                  Width="16" Height="16"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <!-- Animated Green Status Dot -->
                                        <Ellipse Width="8" Height="8" Fill="{DynamicResource SuccessGreen}"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                 Margin="0,0,-1,-1">
                                            <Ellipse.Effect>
                                                <DropShadowEffect Color="#00FF9D" BlurRadius="6" Opacity="0.95" ShadowDepth="0"/>
                                            </Ellipse.Effect>
                                        </Ellipse>
                                    </Grid>

                                    <!-- Full name + Verified status + System Edition -->
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="James God" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <!-- Verified checkmark chip -->
                                            <Viewbox Width="12" Height="12" Margin="6,0,0,0" VerticalAlignment="Center">
                                                <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10,10-4.48,10-10S17.52,2,12,2z M10,17l-5-5l1.41-1.41L10,14.17l7.59-7.59L19,8L10,17z"
                                                      Fill="{DynamicResource AccentCyan}"/>
                                            </Viewbox>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock Text="PRO SUITE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}"/>
                                            <TextBlock Text=" · ACTIVE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource SuccessGreen}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ── CONTENT FRAME (Right column, Row 1) ── -->
                <local:NavigationFrame x:Name="MainContentFrame"
                                       Grid.Column="1"
                                       NavigationUIVisibility="Hidden"
                                       Background="Transparent"
                                       Margin="0"/>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 TOAST CONTAINER (Overlaid on root grid, ZIndex 999, pointer passthrough)
                 Top-right anchor: Margin 0,62,16,0, VerticalAlignment Top, HorizontalAlignment Right
                 ══════════════════════════════════════════════════════════ -->
            <Canvas x:Name="ToastCanvas"
                    Grid.RowSpan="2"
                    Panel.ZIndex="999"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,62,16,0"
                    Width="360"
                    ClipToBounds="False"
                    Background="{x:Null}">
                <StackPanel x:Name="ToastStack" Width="360"/>
            </Canvas>

            <!-- ══════════════════════════════════════════════════════════
                 TIPS WALKTHROUGH OVERLAY (first-run + replay from Settings)
                 Highlights chrome elements with a cutout scrim + callout.
                 Sits above content but below the command palette and toasts.
                 ══════════════════════════════════════════════════════════ -->
            <local:WalkthroughOverlay x:Name="TipsOverlay"
                                      Grid.RowSpan="2"
                                      Panel.ZIndex="950"/>

            <!-- ══════════════════════════════════════════════════════════
                 COMMAND PALETTE / QUICK ACTIONS MODAL (Ctrl+K)
                 ══════════════════════════════════════════════════════════ -->
            <Grid x:Name="CommandPaletteOverlay"
                  Grid.RowSpan="2"
                  Panel.ZIndex="1000"
                  Visibility="Collapsed">
                <!-- Dark Blur/Scrim Background -->
                <Border Background="#CC070A10"
                        MouseDown="CommandPaletteScrim_MouseDown"/>

                <!-- Centered Glass Modal Card -->
                <Border Width="600"
                        MaxHeight="480"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Margin="0,70,0,0"
                        Background="{DynamicResource Surface1}"
                        BorderBrush="{DynamicResource BorderAccent}"
                        BorderThickness="1"
                        CornerRadius="16"
                        SnapsToDevicePixels="True">
                    <Border.Effect>
                        <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="36" Opacity="0.35" ShadowDepth="4"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/> <!-- Search input row -->
                            <RowDefinition Height="1"/>    <!-- Separator -->
                            <RowDefinition Height="*"/>    <!-- Results list -->
                            <RowDefinition Height="Auto"/> <!-- Footer shortcuts -->
                        </Grid.RowDefinitions>

                        <!-- Search Input Row -->
                        <Grid Grid.Row="0" Margin="18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Fill="{DynamicResource AccentCyan}" Data="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <TextBox x:Name="TxtCommandSearch"
                                     Grid.Column="1"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimary}"
                                     FontSize="15"
                                     FontWeight="SemiBold"
                                     CaretBrush="{DynamicResource AccentCyan}"
                                     VerticalAlignment="Center"
                                     TextChanged="TxtCommandSearch_TextChanged"
                                     KeyDown="TxtCommandSearch_KeyDown"/>
                            <TextBlock x:Name="TxtSearchPlaceholder"
                                       Grid.Column="1"
                                       Text="Type a command, page name, or quick action..."
                                       FontSize="15"
                                       Foreground="{DynamicResource TextMuted}"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"/>
                            <Button Grid.Column="2"
                                    Content="ESC"
                                    Style="{StaticResource ConsoleChipStyle}"
                                    Click="BtnCloseCommandPalette_Click"
                                    ToolTip="Close (Esc)"/>
                        </Grid>

                        <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderSubtle}"/>

                        <!-- Results List -->
                        <ListBox x:Name="ListCommandResults"
                                 Grid.Row="2"
                                 MaxHeight="310"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Padding="8,6"
                                 SelectionChanged="ListCommandResults_SelectionChanged"
                                 KeyDown="ListCommandResults_KeyDown"
                                 MouseDoubleClick="ListCommandResults_MouseDoubleClick">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Margin" Value="0,2"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="ItemBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="10"
                                                        Padding="{TemplateBinding Padding}"
                                                        SnapsToDevicePixels="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Surface2}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource NavActiveGradient}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                                                        <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="8" Background="{DynamicResource Surface2}" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding IconGlyph}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="6" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Category}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <!-- Keyboard Navigation Help Footer -->
                        <Border Grid.Row="3" Background="{DynamicResource Surface2}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="0,1,0,0" CornerRadius="0,0,16,16" Padding="16,10">
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Use " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="↑" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="↓" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" to navigate · " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="↵ Enter" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                    <TextBlock Text=" to execute · " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                    <TextBlock Text="Esc" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text=" to dismiss" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <TextBlock Text="JAMES COMMAND RUNNER" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
