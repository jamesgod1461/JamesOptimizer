                                        </StackPanel>
                                        <TextBlock Text="Downloads often harbor huge, forgotten installers. Delete them if you no longer need them." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- PAGE DUPLICATE FILES -->
                        <Grid x:Name="PageDuplicateFiles" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="600"/>
                                <ColumnDefinition Width="320"/>
                            </Grid.ColumnDefinitions>
                            
                            <Grid Grid.Column="0" Margin="0,0,20,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
                                    <Button Content="&#x2190;" FontSize="20" Foreground="{DynamicResource PrimaryTextBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand" Click="BtnBackToStorage_Click" Margin="0,0,15,0"/>
                                    <TextBlock Text="Duplicate files" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center"/>
                                </StackPanel>
                                
                                <Grid x:Name="DuplicateScanningContainer" Grid.Row="1" Visibility="Collapsed" Margin="0,40,0,0">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="Scanning for Duplicates..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="We are comparing file hashes across your folders." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,20"/>
                                        <Border CornerRadius="5" Background="#11FFFFFF" Height="10" Width="400">
                                            <ProgressBar x:Name="DuplicateScanProgressBar" Minimum="0" Maximum="100" Value="0" Height="10" 
                                                         Background="Transparent" BorderThickness="0" 
                                                         Foreground="{DynamicResource AccentBrush}">
                                                <ProgressBar.Resources>
                                                    <Style TargetType="ProgressBar">
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ProgressBar">
                                                                    <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="5">
                                                                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="5"/>
                                                                    </Border>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ProgressBar.Resources>
                                            </ProgressBar>
                                        </Border>
                                        <TextBlock x:Name="TxtDuplicateScanPercentage" Text="0%" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="DuplicateResultsContainer" Grid.Row="2" Visibility="Visible">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    
                                    <Grid Grid.Row="0" Margin="0,0,0,20">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" x:Name="BtnDeleteDuplicateFiles" Content="Delete Selected Duplicates" Style="{StaticResource NeonToolButton}" Height="35" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="Bold" Click="BtnDeleteDuplicateFiles_Click" Margin="0,0,15,0" Padding="15,0" Visibility="Collapsed">
                                            <Button.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF4B4B" Offset="0"/>
                                                    <GradientStop Color="#FF2323" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Button.Background>
                                            <Button.BorderBrush>
                                                <SolidColorBrush Color="#FF3333"/>
                                            </Button.BorderBrush>
                                        </Button>
                                        <TextBlock Grid.Column="1" x:Name="TxtDuplicateFilesStatus" Text="Found 45 groups of duplicates." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                    </Grid>
                                    
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Margin="0,0,0,20">
                                        <ItemsControl x:Name="ListDuplicateFiles" Background="Transparent" BorderThickness="0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GlassCard}" Margin="0,0,10,15" Padding="15" Opacity="0">
                                                        <Border.RenderTransform>
                                                            <TranslateTransform Y="20"/>
                                                        </Border.RenderTransform>
                                                        <Border.Triggers>
                                                            <EventTrigger RoutedEvent="Loaded">
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.4" />
                                                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="20" To="0" Duration="0:0:0.4">
                                                                            <DoubleAnimation.EasingFunction>
                                                                                <QuadraticEase EasingMode="EaseOut"/>
                                                                            </DoubleAnimation.EasingFunction>
                                                                        </DoubleAnimation>
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </EventTrigger>
                                                        </Border.Triggers>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                                                <TextBlock Text="&#x1F4C1;" Foreground="{DynamicResource AccentBrush}" FontSize="16" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                                <TextBlock Text="{Binding GroupTitle}" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="450"/>
                                                            </StackPanel>
                                                            <Rectangle Height="1" Fill="#22FFFFFF" Margin="0,0,0,10"/>
                                                            <ItemsControl ItemsSource="{Binding Files}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Grid Margin="0,5">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto"/>
                                                                                <ColumnDefinition Width="*"/>
                                                                            </Grid.ColumnDefinitions>
                                                                            <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" Margin="0,0,15,0" VerticalAlignment="Center">
                                                                                <!-- Removed -->
                                                                                    
                                                                                <!-- Removed -->
                                                                            </CheckBox>
                                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                                <TextBlock Text="{Binding File.FileName}" Foreground="{DynamicResource PrimaryTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                                                <TextBlock Text="{Binding File.FilePath}" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </Grid>
                            
                            <!-- TIPS SIDEBAR -->
                            <StackPanel Grid.Column="1" Margin="10,45,0,0">
                                <!-- Status Card -->
                                <Border Style="{StaticResource GlassCard}" Padding="20" Margin="0,0,0,20" Background="{DynamicResource AccentLightBrush}" BorderBrush="{DynamicResource AccentLightBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="&#x1F46F;" FontSize="24" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                                        <TextBlock Text="Duplicate Finder" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                                        <TextBlock Text="We use secure file hashing to guarantee these files are identical byte-for-byte." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Style="{StaticResource GlassCard}" Padding="15" Margin="0,0,0,12" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#x1F4A1;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Keep One Copy" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Always make sure to leave at least one checkbox unselected per group so you don't lose the file entirely!" Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                                
                                <Border Style="{StaticResource GlassCard}" Padding="15" Margin="0,0,0,12" BorderBrush="#22FFFFFF" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <TextBlock Text="&#x1F553;" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                            <TextBlock Text="Check Paths" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock Text="Review the file paths carefully. Sometimes a file is intentionally duplicated in different project folders." Foreground="#AAAAAA" FontSize="12" TextWrapping="Wrap" LineHeight="18"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                        <!-- PAGE 4: GRAPHICS SETTINGS -->
                        <Grid x:Name="PageGraphics" Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Left" Width="400">
                                <TextBlock Text="&#x1F3AE; GRAPHICS OPTIMIZATION" FontSize="20" FontWeight="Black" Foreground="{DynamicResource DangerBrush}" Margin="0,0,0,20"/>
                                
                                <Border Style="{StaticResource GlassCard}" Padding="20">
                                    <StackPanel>
                                        <TextBlock Text="GPU Maximum Performance" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Automatically detects NVIDIA/AMD cards and forces P-State 0 (Max Perf) and disables ULPS for zero stuttering." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        
                                        <Button x:Name="BtnGpuFix" Content="&#x26A1; Apply GPU Max Performance" Style="{StaticResource NeonToolButton}" Foreground="{DynamicResource DangerBrush}" BorderBrush="#33FF6B6B" Click="BtnGpu_Click"/>
                                        
                                        <Border Height="1" Background="{DynamicResource HoverBackgroundBrush}" Margin="0,15"/>
                                        
                                        <TextBlock Text="Shader Cache Reset" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                                        <TextBlock Text="Clears corrupt DirectX/OpenGL shader caches to fix stuttering." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15"/>
                                        
                                        <Button x:Name="BtnShader" Content="&#x1F9F9; Clear Shader Cache" Style="{StaticResource NeonToolButton}" Click="BtnShader_Click"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- PAGE 5: ADVANCED TWEAKS -->
                        <Grid x:Name="PageAdvanced" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="&#x2699;&#xFE0F; PERFORMANCE TWEAKS" FontSize="20" FontWeight="Black" Foreground="#FFD93D" Margin="0,0,0,20"/>
                            
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <WrapPanel Orientation="Horizontal">
                                    <!-- Card 1: Aggressive Optimizations -->
                                    <Border Style="{StaticResource GlassCard}" Padding="20" Width="330" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="Aggressive Optimizations" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="These tweaks alter system registry and priority settings to force maximum resources to your games." Foreground="#FFD93D" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" Height="40"/>
                                            
                                            <Button x:Name="BtnReg" Content="&#x26A1; Registry Repair" Style="{StaticResource NeonToolButton}" Click="BtnReg_Click"/>
                                            <Button x:Name="BtnElite" Content="&#x26A1; Elite Hardware Mode" Style="{StaticResource NeonToolButton}" Click="BtnElite_Click"/>
                                            <Button x:Name="BtnVisual" Content="&#x26A1; Visual FX Optimizer" Style="{StaticResource NeonToolButton}" Click="BtnVisual_Click"/>
                                            <Button x:Name="BtnGaming" Content="&#x26A1; Gaming Priority Mode" Style="{StaticResource NeonToolButton}" Click="BtnGaming_Click"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Card 2: Input & Peripheral Optimizations -->
                                    <Border Style="{StaticResource GlassCard}" Padding="20" Width="330" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="Input &amp; Peripheral" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="Reduces input latency and configures keyboard and mouse settings for lowest delay in competitive gaming." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" Height="40"/>
                                            
                                            <Button x:Name="BtnMouseFix" Content="&#x1F5B1;&#xFE0F; Mouse Latency Fix" Style="{StaticResource NeonToolButton}" Click="BtnMouseFix_Click"/>
                                            <Button x:Name="BtnKeyboardFix" Content="&#x2328;&#xFE0F; Keyboard Latency Fix" Style="{StaticResource NeonToolButton}" Click="BtnKeyboardFix_Click"/>
                                            <Button x:Name="BtnGpuTweaks" Content="&#x1F5A5;&#xFE0F; GPU Max Performance" Style="{StaticResource NeonToolButton}" Click="BtnGpuTweaks_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Card 3: System & Network -->
                                    <Border Style="{StaticResource GlassCard}" Padding="20" Width="330" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="System &amp; Network" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="Flush network buffers and debloat Windows to reduce background processes and improve hit registration." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" Height="40"/>
                                            
                                            <Button x:Name="BtnWindowsDebloat" Content="&#x1F5A5;&#xFE0F; Windows OS Debloat" Style="{StaticResource NeonToolButton}" Click="BtnWindowsDebloat_Click"/>
                                            <Button x:Name="BtnNetworkFlush" Content="&#x1F310; Network DNS Flush" Style="{StaticResource NeonToolButton}" Click="BtnNetworkFlush_Click"/>
                                            <Button x:Name="BtnJamesRegedit" Content="&#x1F4BE; James Regedit V2" Style="{StaticResource NeonToolButton}" Click="BtnJamesRegedit_Click"/>
                                        </StackPanel>
                                    </Border>
                                    
                                    <!-- Card 4: Power Options (New) -->
                                    <Border Style="{StaticResource GlassCard}" Padding="20" Width="330" Margin="0,0,20,20">
                                        <StackPanel>
                                            <TextBlock Text="Power &amp; Energy" Foreground="{DynamicResource PrimaryTextBrush}" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="Unlock hidden power plans to ensure your CPU maintains maximum clock speeds and disables sleep states." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,15" Height="40"/>
                                            
                                            <Button x:Name="BtnUltimatePower" Content="&#x26A1; Ultimate Performance Plan" Style="{StaticResource NeonToolButton}" Click="BtnUltimatePower_Click"/>
                                            <Button x:Name="BtnCpuUnpark" Content="&#x1F5A5;&#xFE0F; Unpark CPU Cores" Style="{StaticResource NeonToolButton}" Click="BtnCpuUnpark_Click"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Pro Tip Card -->
                                    <Border Style="{StaticResource GlassCard}" Padding="20" Width="330" Margin="0,0,20,20" Background="#2C2010">
                                        <StackPanel>
                                            <TextBlock Text="&#x26A0;&#xFE0F; Optimization Advice" Foreground="#FF5555" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                                            <TextBlock Text="These tweaks forcefully adjust registry keys. Always create a restore point before applying Aggressive Optimizations!" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <TextBlock Text="If you experience stutters after applying, use the 'Settings &gt; Revert Tweaks' option." Foreground="#FFD93D" FontSize="11" TextWrapping="Wrap" FontStyle="Italic"/>
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </ScrollViewer>
                            
                            <Button Grid.Row="2" x:Name="BtnExecuteAll" Content="&#x1F680; RUN ALL ADVANCED TWEAKS NOW" FontSize="16" FontWeight="Black" Foreground="{DynamicResource PrimaryTextBrush}" Height="52" Margin="0,20,0,0" Click="BtnExecuteAll_Click" Cursor="Hand" RenderTransformOrigin="0.5,0.5">
                                            <Button.RenderTransform>
                                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            </Button.RenderTransform>
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="BigBtnBorder" CornerRadius="14" BorderThickness="1.5">
                                                        <Border.BorderBrush>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#00D2FF" Offset="0"/>
                                                                <GradientStop Color="#00B4D8" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.BorderBrush>
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                <GradientStop Color="#331A73E8" Offset="0"/>
                                                                <GradientStop Color="#3300B4D8" Offset="1"/>
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Border.Effect>
                                                            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Color="#00D2FF" Opacity="0.4"/>
                                                        </Border.Effect>
                                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <EventTrigger RoutedEvent="MouseEnter">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" Storyboard.TargetName="BigBtnBorder" To="0.7" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <EventTrigger RoutedEvent="MouseLeave">
                                                            <BeginStoryboard>
                                                                <Storyboard>
                                                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)" Storyboard.TargetName="BigBtnBorder" To="0.4" Duration="0:0:0.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </EventTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="BigBtnBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#551A73E8" Offset="0"/>
                                                                        <GradientStop Color="#5500B4D8" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="BigBtnBorder" Property="Background">
                                                                <Setter.Value>
                                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                        <GradientStop Color="#771A73E8" Offset="0"/>
                                                                        <GradientStop Color="#7700B4D8" Offset="1"/>
                                                                    </LinearGradientBrush>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <Button.Triggers>
                                                <EventTrigger RoutedEvent="PreviewMouseDown">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="0:0:0.08"/>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="0:0:0.08"/>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                                <EventTrigger RoutedEvent="PreviewMouseUp">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="8" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.15">
                                                                <DoubleAnimation.EasingFunction><ElasticEase Oscillations="1" Springiness="8" EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Button.Triggers>
                                        </Button>
                        </Grid>

                        <!-- PAGE 6: DIAGNOSTICS -->
                        <Grid x:Name="PageDiagnostics" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <StackPanel Grid.Row="0" HorizontalAlignment="Left" Width="700">
                                <TextBlock Text="&#x2764;&#xFE0F; SYSTEM DIAGNOSTICS" FontSize="20" FontWeight="Black" Foreground="#00E5FF" Margin="0,0,0,10"/>
                                <TextBlock Text="Quick health check and detailed system reporting." Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,0,0,20"/>
                            </StackPanel>

                            <Border Grid.Row="1" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,20" ClipToBounds="True">
                                <Grid>
                                    <Canvas x:Name="DiagnosticsBgCanvas" IsHitTestVisible="False" Opacity="0.4"/>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel Margin="0,0,15,0">
                                            
                                            <!-- SECTION 1: SYSTEM SPECIFICATIONS -->
                                            <Border Background="{DynamicResource GlassCardBackgroundBrush}" BorderBrush="{DynamicResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                                <StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                                        <TextBlock Text="&#x1F5A5;&#xFE0F;" FontSize="24" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                        <TextBlock Text="SYSTEM SPECIFICATIONS" FontSize="16" FontWeight="Black" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" MinWidth="150"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        
                                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Processor:" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,10,8"/>
                                                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtDiagCpuModel" Text="Gathering info..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                        
                                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Graphics Card (GPU):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,10,8"/>
                                                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtDiagGpuModel" Text="Gathering info..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                        
                                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Memory (RAM):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,10,8"/>
                                                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtDiagRamTotal" Text="Gathering info..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" Margin="0,0,0,8" TextWrapping="Wrap"/>
                                                        
                                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Storage (Total):" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="13" FontWeight="Bold" Margin="0,0,10,0"/>
                                                        <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtDiagStorageDrives" Text="Gathering info..." Foreground="{DynamicResource PrimaryTextBrush}" FontSize="13" TextWrapping="Wrap"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>

                                            <!-- SECTION 2: SYSTEM STATUS -->
                                            <Border Background="{DynamicResource GlassCardBackgroundBrush}" BorderBrush="{DynamicResource GlassCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="20" Margin="0,0,0,15">
                                                <StackPanel>
