<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         SEMANTIC COLOR SYSTEM - DARK THEME
         ============================================================ -->

    <!-- Brand Colors -->
    <Color x:Key="BrandPrimaryColor">#0078D4</Color>
    <Color x:Key="BrandPrimaryDarkColor">#005A9E</Color>
    <Color x:Key="BrandPrimaryLightColor">#409EFF</Color>
    <Color x:Key="BrandAccentColor">#00D2FF</Color>
    <Color x:Key="BrandAccentSecondaryColor">#B500FF</Color>

    <!-- Semantic Surface Colors -->
    <Color x:Key="SurfaceBaseColor">#0F0F12</Color>
    <Color x:Key="SurfaceContainerColor">#16161B</Color>
    <Color x:Key="SurfaceContainerHighColor">#1E1E24</Color>
    <Color x:Key="SurfaceContainerHighestColor">#24242C</Color>
    <Color x:Key="SurfaceVariantColor">#2A2A32</Color>
    <Color x:Key="SurfaceOutlineColor">#33333A</Color>

    <!-- Semantic Content Colors -->
    <Color x:Key="ContentPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ContentSecondaryColor">#B0B3BA</Color>
    <Color x:Key="ContentTertiaryColor">#7A7D85</Color>
    <Color x:Key="ContentDisabledColor">#4A4A52</Color>
    <Color x:Key="ContentOnPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ContentOnAccentColor">#0F0F12</Color>

    <!-- Semantic State Colors -->
    <Color x:Key="StateSuccessColor">#10B981</Color>
    <Color x:Key="StateSuccessContainerColor">#064E3B</Color>
    <Color x:Key="StateWarningColor">#F59E0B</Color>
    <Color x:Key="StateWarningContainerColor">#78350F</Color>
    <Color x:Key="StateErrorColor">#EF4444</Color>
    <Color x:Key="StateErrorContainerColor">#7F1D1D</Color>
    <Color x:Key="StateInfoColor">#3B82F6</Color>
    <Color x:Key="StateInfoContainerColor">#1E3A5F</Color>

    <!-- Interactive Colors -->
    <Color x:Key="InteractiveHoverColor">#1AFFFFFF</Color>
    <Color x:Key="InteractivePressedColor">#33FFFFFF</Color>
    <Color x:Key="InteractiveFocusColor">#0078D4</Color>
    <Color x:Key="InteractiveDisabledColor">#1FFFFFFF</Color>

    <!-- Elevation Shadows -->
    <Color x:Key="ShadowColor">#000000</Color>

    <!-- ============================================================
         SOLID COLOR BRUSHES
         ============================================================ -->

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLightColor}"/>
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}"/>
    <SolidColorBrush x:Key="BrandAccentSecondaryBrush" Color="{StaticResource BrandAccentSecondaryColor}"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}"/>
    <SolidColorBrush x:Key="SurfaceVariantBrush" Color="{StaticResource SurfaceVariantColor}"/>
    <SolidColorBrush x:Key="SurfaceOutlineBrush" Color="{StaticResource SurfaceOutlineColor}"/>

    <!-- Content -->
    <SolidColorBrush x:Key="ContentPrimaryBrush" Color="{StaticResource ContentPrimaryColor}"/>
    <SolidColorBrush x:Key="ContentSecondaryBrush" Color="{StaticResource ContentSecondaryColor}"/>
    <SolidColorBrush x:Key="ContentTertiaryBrush" Color="{StaticResource ContentTertiaryColor}"/>
    <SolidColorBrush x:Key="ContentDisabledBrush" Color="{StaticResource ContentDisabledColor}"/>
    <SolidColorBrush x:Key="ContentOnPrimaryBrush" Color="{StaticResource ContentOnPrimaryColor}"/>
    <SolidColorBrush x:Key="ContentOnAccentBrush" Color="{StaticResource ContentOnAccentColor}"/>

    <!-- States -->
    <SolidColorBrush x:Key="StateSuccessBrush" Color="{StaticResource StateSuccessColor}"/>
    <SolidColorBrush x:Key="StateSuccessContainerBrush" Color="{StaticResource StateSuccessContainerColor}"/>
    <SolidColorBrush x:Key="StateWarningBrush" Color="{StaticResource StateWarningColor}"/>
    <SolidColorBrush x:Key="StateWarningContainerBrush" Color="{StaticResource StateWarningContainerColor}"/>
    <SolidColorBrush x:Key="StateErrorBrush" Color="{StaticResource StateErrorColor}"/>
    <SolidColorBrush x:Key="StateErrorContainerBrush" Color="{StaticResource StateErrorContainerColor}"/>
    <SolidColorBrush x:Key="StateInfoBrush" Color="{StaticResource StateInfoColor}"/>
    <SolidColorBrush x:Key="StateInfoContainerBrush" Color="{StaticResource StateInfoContainerColor}"/>

    <!-- Interactive -->
    <SolidColorBrush x:Key="InteractiveHoverBrush" Color="{StaticResource InteractiveHoverColor}"/>
    <SolidColorBrush x:Key="InteractivePressedBrush" Color="{StaticResource InteractivePressedColor}"/>
    <SolidColorBrush x:Key="InteractiveFocusBrush" Color="{StaticResource InteractiveFocusColor}"/>
    <SolidColorBrush x:Key="InteractiveDisabledBrush" Color="{StaticResource InteractiveDisabledColor}"/>

    <!-- ============================================================
         GRADIENT BRUSHES
         ============================================================ -->

    <!-- Primary Gradient -->
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandPrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandAccentColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BrandPrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandAccentColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Accent Gradient -->
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandAccentColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandAccentSecondaryColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Surface Gradient -->
    <LinearGradientBrush x:Key="SurfaceGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource SurfaceContainerColor}" Offset="0"/>
        <GradientStop Color="{StaticResource SurfaceContainerHighColor}" Offset="1"/>
    </LinearGradientBrush>

    <!-- Glass/Overlay Gradients -->
    <LinearGradientBrush x:Key="GlassBorderBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#33FFFFFF" Offset="0"/>
        <GradientStop Color="#0AFFFFFF" Offset="0.5"/>
        <GradientStop Color="#00FFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlassBorderHoverBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#66FFFFFF" Offset="0"/>
        <GradientStop Color="#1AFFFFFF" Offset="1"/>
    </LinearGradientBrush>

    <!-- State Gradients -->
    <LinearGradientBrush x:Key="SuccessGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0"/>
        <GradientStop Color="#34D399" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="WarningGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F59E0B" Offset="0"/>
        <GradientStop Color="#FBBF24" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="ErrorGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0"/>
        <GradientStop Color="#F87171" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================
         LEGACY COMPATIBILITY ALIASES
         ============================================================ -->

    <Color x:Key="AppBackgroundColor">#0F0F12</Color>
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource AppBackgroundColor}"/>

    <Color x:Key="GlassCardBackgroundColor">#16161B</Color>
    <SolidColorBrush x:Key="GlassCardBackgroundBrush" Color="{StaticResource GlassCardBackgroundColor}"/>

    <Color x:Key="SidebarBackgroundColor">#16161B</Color>
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>

    <SolidColorBrush x:Key="GlassCardBorderBrush" Color="#33333A"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#2A2A32"/>

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#B0B3BA"/>

    <SolidColorBrush x:Key="AccentBrush" Color="#00D2FF"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#3300D2FF"/>

    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#1AFFFFFF"/>

    <SolidColorBrush x:Key="TitleBarHoverBrush" Color="#1AFFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="SuccessLightBrush" Color="#3310B981"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarningLightBrush" Color="#33F59E0B"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444"/>
    <SolidColorBrush x:Key="DangerLightBrush" Color="#33EF4444"/>

</ResourceDictionary>