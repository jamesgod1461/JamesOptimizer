<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         JAMES OPTIMIZER V3 — TYPOGRAPHY SYSTEM
         All V3 spec style keys + legacy aliases.
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── FONT FAMILY TOKENS ────────────────────────────────────────── -->
    <FontFamily x:Key="PrimaryFontFamily">Segoe UI Variable Text, Segoe UI Variable Display, Inter, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display, Inter, Segoe UI, Arial</FontFamily>
    <FontFamily x:Key="MonospaceFontFamily">JetBrains Mono, Cascadia Code, Consolas, Courier New</FontFamily>

    <!-- ── TEXT RENDERING DEFAULTS ───────────────────────────────────── -->
    <!-- Applied as a base; individual styles inherit via BasedOn or duplication -->

    <!-- ── V3 NAMED STYLE: PageTitle ─────────────────────────────────── -->
    <!-- 28px / Bold / Segoe UI Variable Display / TextPrimary -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource DisplayFontFamily}"/>
        <Setter Property="FontSize"                      Value="28"/>
        <Setter Property="FontWeight"                    Value="Bold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: SectionLabel ──────────────────────────────── -->
    <!-- 11px / SemiBold / AccentCyan 80% / CharacterSpacing 200 / UPPERCASE -->
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="11"/>
        <Setter Property="FontWeight"                    Value="SemiBold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource SectionLabelBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: CardTitle ─────────────────────────────────── -->
    <!-- 15px / SemiBold / TextPrimary -->
    <Style x:Key="CardTitle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="15"/>
        <Setter Property="FontWeight"                    Value="SemiBold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextPrimary}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: BodyText ──────────────────────────────────── -->
    <!-- 13px / Regular / TextSecondary / LineHeight 1.6 (via LineStackingStrategy) -->
    <Style x:Key="BodyText" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="13"/>
        <Setter Property="FontWeight"                    Value="Normal"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextSecondary}"/>
        <Setter Property="LineHeight"                    Value="20.8"/>
        <Setter Property="LineStackingStrategy"          Value="BlockLineHeight"/>
        <Setter Property="TextWrapping"                  Value="Wrap"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: MetricValue ───────────────────────────────── -->
    <!-- 36px / Bold / JetBrains Mono / AccentCyan (color applied dynamically per threshold in code-behind) -->
    <Style x:Key="MetricValue" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource MonospaceFontFamily}"/>
        <Setter Property="FontSize"                      Value="36"/>
        <Setter Property="FontWeight"                    Value="Bold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource AccentCyan}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: MetricLabel ───────────────────────────────── -->
    <!-- 11px / Medium / TextMuted / CharacterSpacing 50 -->
    <Style x:Key="MetricLabel" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="11"/>
        <Setter Property="FontWeight"                    Value="Medium"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextMuted}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: BadgeText ─────────────────────────────────── -->
    <!-- 11px / SemiBold / CharacterSpacing 50 — color set by badge parent -->
    <Style x:Key="BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="11"/>
        <Setter Property="FontWeight"                    Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ── V3 NAMED STYLE: ButtonText ────────────────────────────────── -->
    <!-- 13px / SemiBold / CharacterSpacing 100 — Foreground set by button template -->
    <Style x:Key="ButtonText" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="13"/>
        <Setter Property="FontWeight"                    Value="SemiBold"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <!-- ════════════════════════════════════════════════════════════════
         LEGACY STYLE ALIASES — keeps existing XAML compilable
         ════════════════════════════════════════════════════════════════ -->

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource PageTitle}">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="12"/>
        <Setter Property="FontWeight"                    Value="Bold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="PageSubtitleStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="14"/>
        <Setter Property="FontWeight"                    Value="Normal"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="BodyTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="14"/>
        <Setter Property="FontWeight"                    Value="Normal"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
        <Setter Property="TextWrapping"                  Value="Wrap"/>
    </Style>

    <Style x:Key="BodyStrongTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="14"/>
        <Setter Property="FontWeight"                    Value="SemiBold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="MicroLabelStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="11"/>
        <Setter Property="FontWeight"                    Value="SemiBold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="MonospaceHeroStatStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource MonospaceFontFamily}"/>
        <Setter Property="FontSize"                      Value="52"/>
        <Setter Property="FontWeight"                    Value="Bold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="MonospaceMetricStatStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource MonospaceFontFamily}"/>
        <Setter Property="FontSize"                      Value="36"/>
        <Setter Property="FontWeight"                    Value="Bold"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="MonospaceSmallStatStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource MonospaceFontFamily}"/>
        <Setter Property="FontSize"                      Value="13"/>
        <Setter Property="FontWeight"                    Value="Medium"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
    </Style>

    <Style x:Key="NavItemTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily"                    Value="{StaticResource PrimaryFontFamily}"/>
        <Setter Property="FontSize"                      Value="13"/>
        <Setter Property="FontWeight"                    Value="Medium"/>
        <Setter Property="Foreground"                    Value="{DynamicResource TextSecondaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType"/>
        <Setter Property="TextOptions.TextHintingMode"   Value="Fixed"/>
        <Setter Property="VerticalAlignment"             Value="Center"/>
    </Style>

    <Style x:Key="DataText" TargetType="TextBlock" BasedOn="{StaticResource MonospaceSmallStatStyle}"/>

</ResourceDictionary>
