<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================
         G-HUB INSPIRED COLOR SYSTEM
         ============================================================ -->

    <!-- Brand Colors - G-Hub Cyan/Blue -->
    <Color x:Key="BrandPrimaryColor">#00D4FF</Color>
    <Color x:Key="BrandPrimaryDarkColor">#0099CC</Color>
    <Color x:Key="BrandPrimaryLightColor">#4DDFFF</Color>
    <Color x:Key="BrandSecondaryColor">#00E676</Color>
    <Color x:Key="BrandAccentColor">#FF6D00</Color>

    <!-- Surface Colors - Dark Gaming Theme -->
    <Color x:Key="SurfaceBaseColor">#121212</Color>
    <Color x:Key="SurfaceContainerColor">#1A1A1A</Color>
    <Color x:Key="SurfaceContainerHighColor">#1F1F1F</Color>
    <Color x:Key="SurfaceContainerHighestColor">#242424</Color>
    <Color x:Key="SurfaceCardColor">#1E1E1E</Color>
    <Color x:Key="SurfaceCardBorderColor">#2D2D2D</Color>
    <Color x:Key="SurfaceHoverColor">#2A2A2A</Color>
    <Color x:Key="SurfacePressedColor">#333333</Color>

    <!-- Content Colors -->
    <Color x:Key="ContentPrimaryColor">#FFFFFF</Color>
    <Color x:Key="ContentSecondaryColor">#B0B0B0</Color>
    <Color x:Key="ContentTertiaryColor">#808080</Color>
    <Color x:Key="ContentDisabledColor">#4A4A4A</Color>
    <Color x:Key="ContentOnPrimaryColor">#121212</Color>

    <!-- State Colors -->
    <Color x:Key="StateSuccessColor">#00E676</Color>
    <Color x:Key="StateSuccessContainerColor">#003D1F</Color>
    <Color x:Key="StateWarningColor">#FFAB00</Color>
    <Color x:Key="StateWarningContainerColor">#3D2B00</Color>
    <Color x:Key="StateErrorColor">#FF5252</Color>
    <Color x:Key="StateErrorContainerColor">#3D0000</Color>
    <Color x:Key="StateInfoColor">#00D4FF</Color>
    <Color x:Key="StateInfoContainerColor">#002B3D</Color>

    <!-- Interactive Colors -->
    <Color x:Key="InteractiveHoverColor">#1AFFFFFF</Color>
    <Color x:Key="InteractivePressedColor">#33FFFFFF</Color>
    <Color x:Key="InteractiveFocusColor">#00D4FF</Color>
    <Color x:Key="InteractiveDisabledColor">#1FFFFFFF</Color>

    <!-- Sidebar Colors -->
    <Color x:Key="SidebarBackgroundColor">#0D0D0D</Color>
    <Color x:Key="SidebarItemHoverColor">#1A1A1A</Color>
    <Color x:Key="SidebarItemActiveColor">#1F1F1F</Color>
    <Color x:Key="SidebarBorderColor">#1F1F1F</Color>
    <Color x:Key="SidebarDividerColor">#2D2D2D</Color>

    <!-- ============================================================
         SOLID COLOR BRUSHES
         ============================================================ -->

    <!-- Brand -->
    <SolidColorBrush x:Key="BrandPrimaryBrush" Color="{StaticResource BrandPrimaryColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryDarkBrush" Color="{StaticResource BrandPrimaryDarkColor}"/>
    <SolidColorBrush x:Key="BrandPrimaryLightBrush" Color="{StaticResource BrandPrimaryLightColor}"/>
    <SolidColorBrush x:Key="BrandSecondaryBrush" Color="{StaticResource BrandSecondaryColor}"/>
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{StaticResource BrandAccentColor}"/>

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBaseBrush" Color="{StaticResource SurfaceBaseColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerBrush" Color="{StaticResource SurfaceContainerColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighBrush" Color="{StaticResource SurfaceContainerHighColor}"/>
    <SolidColorBrush x:Key="SurfaceContainerHighestBrush" Color="{StaticResource SurfaceContainerHighestColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBrush" Color="{StaticResource SurfaceCardColor}"/>
    <SolidColorBrush x:Key="SurfaceCardBorderBrush" Color="{StaticResource SurfaceCardBorderColor}"/>
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource SurfaceHoverColor}"/>
    <SolidColorBrush x:Key="SurfacePressedBrush" Color="{StaticResource SurfacePressedColor}"/>

    <!-- Content -->
    <SolidColorBrush x:Key="ContentPrimaryBrush" Color="{StaticResource ContentPrimaryColor}"/>
    <SolidColorBrush x:Key="ContentSecondaryBrush" Color="{StaticResource ContentSecondaryColor}"/>
    <SolidColorBrush x:Key="ContentTertiaryBrush" Color="{StaticResource ContentTertiaryColor}"/>
    <SolidColorBrush x:Key="ContentDisabledBrush" Color="{StaticResource ContentDisabledColor}"/>
    <SolidColorBrush x:Key="ContentOnPrimaryBrush" Color="{StaticResource ContentOnPrimaryColor}"/>

    <!-- States -->
    <SolidColorBrush x:Key="StateSuccessBrush" Color="{StaticResource StateSuccessColor}"/>
    <SolidColorBrush x:Key="StateSuccessContainerBrush" Color="{StaticResource StateSuccessContainerColor}"/>
    <SolidColorBrush x:Key="StateWarningBrush" Color="{StaticResource StateWarningColor}"/>
    <SolidColorBrush x:Key="StateWarningContainerBrush" Color="{StaticResource StateWarningContainerColor}"/>
    <SolidColorBrush x:Key="StateErrorBrush" Color="{StaticResource StateErrorColor}"/>
    <SolidColorBrush x:Key="StateErrorContainerBrush" Color="{StaticResource StateErrorContainerColor}"/>
    <SolidColorBrush x:Key="StateInfoBrush" Color="{StaticResource StateInfoColor}"/>
    <SolidColorBrush x:Key="StateInfoContainerBrush" Color="{StaticResource StateInfoContainerColor}"/>

    <!-- Interactive -->
    <SolidColorBrush x:Key="InteractiveHoverBrush" Color="{StaticResource InteractiveHoverColor}"/>
    <SolidColorBrush x:Key="InteractivePressedBrush" Color="{StaticResource InteractivePressedColor}"/>
    <SolidColorBrush x:Key="InteractiveFocusBrush" Color="{StaticResource InteractiveFocusColor}"/>
    <SolidColorBrush x:Key="InteractiveDisabledBrush" Color="{StaticResource InteractiveDisabledColor}"/>

    <!-- Sidebar -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="{StaticResource SidebarBackgroundColor}"/>
    <SolidColorBrush x:Key="SidebarItemHoverBrush" Color="{StaticResource SidebarItemHoverColor}"/>
    <SolidColorBrush x:Key="SidebarItemActiveBrush" Color="{StaticResource SidebarItemActiveColor}"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="{StaticResource SidebarBorderColor}"/>
    <SolidColorBrush x:Key="SidebarDividerBrush" Color="{StaticResource SidebarDividerColor}"/>

    <!-- ============================================================
         GRADIENT BRUSHES
         ============================================================ -->

    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandPrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandPrimaryDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="PrimaryGradientVerticalBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource BrandPrimaryColor}" Offset="0"/>
        <GradientStop Color="{StaticResource BrandPrimaryDarkColor}" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SecondaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandSecondaryColor}" Offset="0"/>
        <GradientStop Color="#00C853" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{StaticResource BrandAccentColor}" Offset="0"/>
        <GradientStop Color="#FF9100" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1F1F1F" Offset="0"/>
        <GradientStop Color="#1A1A1A" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CardHoverGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2A2A2A" Offset="0"/>
        <GradientStop Color="#222222" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarActiveGradientBrush" StartPoint="1,0" EndPoint="0,0">
        <GradientStop Color="#00D4FF" Offset="0"/>
        <GradientStop Color="#003D4D" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="GlowGradientBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#0000D4FF" Offset="0"/>
        <GradientStop Color="#00D4FF" Offset="0.5"/>
        <GradientStop Color="#0000D4FF" Offset="1"/>
    </LinearGradientBrush>

    <!-- ============================================================
         SHADOWS & EFFECTS
         ============================================================ -->

    <DropShadowEffect x:Key="CardShadowEffect" 
                      BlurRadius="16" 
                      ShadowDepth="0" 
                      Color="#000000" 
                      Opacity="0.3"/>
    
    <DropShadowEffect x:Key="CardHoverShadowEffect" 
                      BlurRadius="24" 
                      ShadowDepth="0" 
                      Color="#00D4FF" 
                      Opacity="0.15"/>
    
    <DropShadowEffect x:Key="GlowShadowEffect" 
                      BlurRadius="32" 
                      ShadowDepth="0" 
                      Color="#00D4FF" 
                      Opacity="0.4"/>
    
    <DropShadowEffect x:Key="ButtonShadowEffect" 
                      BlurRadius="12" 
                      ShadowDepth="0" 
                      Color="#00D4FF" 
                      Opacity="0.25"/>

    <!-- ============================================================
         TYPOGRAPHY
         ============================================================ -->

    <FontFamily x:Key="FontFamilyPrimary">Segoe UI Variable, Segoe UI, system-ui</FontFamily>
    <FontFamily x:Key="FontFamilyMono">JetBrains Mono, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="FontFamilyIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <sys:Double x:Key="FontSizeXS">11</sys:Double>
    <sys:Double x:Key="FontSizeSM">12</sys:Double>
    <sys:Double x:Key="FontSizeMD">13</sys:Double>
    <sys:Double x:Key="FontSizeLG">14</sys:Double>
    <sys:Double x:Key="FontSizeXL">16</sys:Double>
    <sys:Double x:Key="FontSize2XL">18</sys:Double>
    <sys:Double x:Key="FontSize3XL">20</sys:Double>
    <sys:Double x:Key="FontSize4XL">24</sys:Double>
    <sys:Double x:Key="FontSize5XL">32</sys:Double>
    <sys:Double x:Key="FontSize6XL">40</sys:Double>
    <sys:Double x:Key="FontSize7XL">56</sys:Double>

    <FontWeight x:Key="FontWeightRegular">400</FontWeight>
    <FontWeight x:Key="FontWeightMedium">500</FontWeight>
    <FontWeight x:Key="FontWeightSemiBold">600</FontWeight>
    <FontWeight x:Key="FontWeightBold">700</FontWeight>
    <FontWeight x:Key="FontWeightExtraBold">800</FontWeight>

    <!-- ============================================================
         SPACING & SIZING
         ============================================================ -->

    <sys:Double x:Key="SpacingXS">4</sys:Double>
    <sys:Double x:Key="SpacingSM">8</sys:Double>
    <sys:Double x:Key="SpacingMD">12</sys:Double>
    <sys:Double x:Key="SpacingLG">16</sys:Double>
    <sys:Double x:Key="SpacingXL">24</sys:Double>
    <sys:Double x:Key="Spacing2XL">32</sys:Double>
    <sys:Double x:Key="Spacing3XL">48</sys:Double>

    <sys:Double x:Key="BorderRadiusXS">4</sys:Double>
    <sys:Double x:Key="BorderRadiusSM">8</sys:Double>
    <sys:Double x:Key="BorderRadiusMD">12</sys:Double>
    <sys:Double x:Key="BorderRadiusLG">16</sys:Double>
    <sys:Double x:Key="BorderRadiusXL">24</sys:Double>
    <sys:Double x:Key="BorderRadiusFull">9999</sys:Double>

    <sys:Double x:Key="SidebarWidthCollapsed">64</sys:Double>
    <sys:Double x:Key="SidebarWidthExpanded">240</sys:Double>
    <sys:Double x:Key="TopBarHeight">48</sys:Double>
    <sys:Double x:Key="CardMinHeight">120</sys:Double>

    <!-- ============================================================
         ANIMATION TIMING
         ============================================================ -->

    <Duration x:Key="DurationFast">0:0:0.15</Duration>
    <Duration x:Key="DurationNormal">0:0:0.25</Duration>
    <Duration x:Key="DurationSlow">0:0:0.35</Duration>
    <Duration x:Key="DurationPageTransition">0:0:0.3</Duration>

    <CubicEase x:Key="EasingStandard" EasingMode="EaseOut"/>
    <CubicEase x:Key="EasingEmphasized" EasingMode="EaseOut"/>
    <QuinticEase x:Key="EasingSpring" EasingMode="EaseOut"/>

</ResourceDictionary>