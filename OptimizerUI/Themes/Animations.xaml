<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         JAMES OPTIMIZER V3 — ANIMATION LIBRARY
         Reusable Storyboard resources. Apply via BeginStoryboard
         or code-behind. All timings follow the V3 spec.
         ════════════════════════════════════════════════════════════════ -->

    <!-- ── PAGE ENTER (opacity 0→1 + translateY 10→0, 220ms EaseOut) ── -->
    <Storyboard x:Key="PageEnterAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="10" To="0"
                         Duration="0:0:0.22">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── PAGE EXIT (opacity 1→0 + translateY 0→-6, 160ms EaseIn) ── -->
    <Storyboard x:Key="PageExitAnimation">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="0:0:0.16">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="0" To="-6"
                         Duration="0:0:0.16">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── CARD HOVER IN (translateY 0→-3, 180ms EaseOut) ── -->
    <Storyboard x:Key="CardHoverIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         To="-3" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── CARD HOVER OUT (translateY back to 0, 180ms EaseOut) ── -->
    <Storyboard x:Key="CardHoverOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         To="0" Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── PULSE GLOW (RepeatForever, BlurRadius 8→20→8, Opacity 0.3→0.7→0.3)
         Attach to element via code-behind: target the DropShadowEffect
         Note: Storyboard.Target must be set per usage since Effect is not accessible via property path alone.
         Use the x:Key to retrieve and begin; set Storyboard.TargetName to the effect in code.
    ── -->
    <Storyboard x:Key="PulseGlow" RepeatBehavior="Forever">
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)">
            <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="8"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="20">
                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
            </EasingDoubleKeyFrame>
            <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="8">
                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
            </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
        <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.Opacity)">
            <EasingDoubleKeyFrame KeyTime="0:0:0"   Value="0.3"/>
            <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="0.7">
                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
            </EasingDoubleKeyFrame>
            <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="0.3">
                <EasingDoubleKeyFrame.EasingFunction><CubicEase EasingMode="EaseInOut"/></EasingDoubleKeyFrame.EasingFunction>
            </EasingDoubleKeyFrame>
        </DoubleAnimationUsingKeyFrames>
    </Storyboard>

    <!-- ── STAGGERED LIST ROW LOAD (translateY 14→0 + opacity 0→1, 200ms EaseOut)
         Caller must set BeginTime offset per row: row_index * 0:0:0.03
    ── -->
    <Storyboard x:Key="StaggeredListLoad">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="14" To="0"
                         Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── GAUGE COUNT UP (0→target, 1400ms CubicEaseOut)
         Set Storyboard.TargetProperty to the TextBlock or DependencyProperty being animated.
         "To" value must be set in code-behind before beginning.
    ── -->
    <Storyboard x:Key="GaugeCountUp">
        <DoubleAnimation Storyboard.TargetProperty="(FrameworkElement.Tag)"
                         From="0"
                         Duration="0:0:1.4">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── TOAST SLIDE IN (translateX 120→0 + opacity 0→1, 250ms EaseOut) ── -->
    <Storyboard x:Key="ToastSlideIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="120" To="0"
                         Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.25">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── TOAST SLIDE OUT (translateX 0→120 + opacity 1→0, then height collapse) ── -->
    <Storyboard x:Key="ToastSlideOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                         From="0" To="120"
                         Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="0:0:0.18">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="Height"
                         To="0"
                         BeginTime="0:0:0.18"
                         Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── FADE IN (generic opacity 0→1, 200ms) ── -->
    <Storyboard x:Key="FadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1"
                         Duration="0:0:0.20">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── FADE OUT (generic opacity 1→0, 150ms) ── -->
    <Storyboard x:Key="FadeOut">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="1" To="0"
                         Duration="0:0:0.15">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseIn"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── STATUS DOT BREATHING (Continuous pulse on glow) ── -->
    <Storyboard x:Key="StatusDotBreath" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0.75" To="1.0" Duration="0:0:1.4" AutoReverse="True">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.95" To="1.15" Duration="0:0:1.4" AutoReverse="True">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.95" To="1.15" Duration="0:0:1.4" AutoReverse="True">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── LOGO CORE BREATH (Continuous subtle pulse) ── -->
    <Storyboard x:Key="LogoCoreBreath" RepeatBehavior="Forever">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                         From="0.96" To="1.05" Duration="0:0:2.0" AutoReverse="True">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                         From="0.96" To="1.05" Duration="0:0:2.0" AutoReverse="True">
            <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <!-- ── ACTION TILE HOVER IN (translateY 0→-2, 140ms EaseOut) ── -->
    <Storyboard x:Key="ActionTileHoverIn">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         To="-2" Duration="0:0:0.14">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

    <Storyboard x:Key="ActionTileHoverOut">
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         To="0" Duration="0:0:0.14">
            <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>
