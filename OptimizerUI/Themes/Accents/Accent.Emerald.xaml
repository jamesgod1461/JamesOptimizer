<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════
         ACCENT OVERLAY — Emerald Rush
         Merged AFTER the color dictionary by ThemeManager so these keys
         win. Values are tuned to stay legible on both dark and light.
         ════════════════════════════════════════════════════════════════ -->

    <!-- Raw colors -->
    <Color x:Key="ColorAccentCyan">#10C98F</Color>
    <Color x:Key="ColorAccentViolet">#2DD4BF</Color>
    <Color x:Key="ColorAccentGradientStart">#10C98F</Color>
    <Color x:Key="ColorAccentGradientEnd">#2DD4BF</Color>
    <Color x:Key="ColorAccentGlow">#10C98F</Color>
    <Color x:Key="ColorBorderAccent">#6610C98F</Color>
    <Color x:Key="ColorGlowCyan">#3310C98F</Color>
    <Color x:Key="ColorPrimaryAccent">#10C98F</Color>
    <Color x:Key="ColorSecondaryAccent">#2DD4BF</Color>
    <Color x:Key="ColorSidebarBorder">#3310C98F</Color>
    <Color x:Key="ColorBorderHover">#6610C98F</Color>
    <Color x:Key="ColorBorderFocus">#9910C98F</Color>
    <Color x:Key="ColorGlowCyanIntense">#6610C98F</Color>
    <Color x:Key="AccentColor">#10C98F</Color>

    <!-- Core accent brushes -->
    <SolidColorBrush x:Key="AccentCyan" Color="#10C98F"/>
    <SolidColorBrush x:Key="AccentViolet" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="BorderAccent" Color="#6610C98F"/>
    <SolidColorBrush x:Key="GlowCyan" Color="#3310C98F"/>
    <SolidColorBrush x:Key="AccentTint" Color="#1A10C98F"/>
    <SolidColorBrush x:Key="AccentTintBorder" Color="#3310C98F"/>
    <SolidColorBrush x:Key="AccentTintStrong" Color="#2E10C98F"/>
    <SolidColorBrush x:Key="SectionLabelBrush" Color="#CC10C98F"/>

    <!-- Gradients -->
    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10C98F" Offset="0.0"/>
        <GradientStop Color="#2DD4BF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentGradientHorizontal" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#10C98F" Offset="0.0"/>
        <GradientStop Color="#2DD4BF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="NavActiveGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#2E10C98F" Offset="0"/>
        <GradientStop Color="#142DD4BF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBorderGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#9910C98F" Offset="0.0"/>
        <GradientStop Color="#592DD4BF" Offset="1.0"/>
    </LinearGradientBrush>

    <!-- Interactive + legacy aliases -->
    <SolidColorBrush x:Key="NavActiveBackground" Color="#2410C98F"/>
    <SolidColorBrush x:Key="NavActiveBackgroundBrush" Color="#1A10C98F"/>
    <SolidColorBrush x:Key="PrimaryAccentBrush" Color="#10C98F"/>
    <SolidColorBrush x:Key="SecondaryAccentBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#10C98F"/>
    <SolidColorBrush x:Key="AccentLightBrush" Color="#3310C98F"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#10C98F"/>
    <SolidColorBrush x:Key="PrimaryGlowBrush" Color="#3310C98F"/>
    <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10C98F" Offset="0.0"/>
        <GradientStop Color="#2DD4BF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PrimaryGradientHorizontalBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="#10C98F" Offset="0.0"/>
        <GradientStop Color="#2DD4BF" Offset="1.0"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardHoverBorderGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#8010C98F" Offset="0.0"/>
        <GradientStop Color="#402DD4BF" Offset="1.0"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="GlowCyanBrush" Color="#3310C98F"/>
    <SolidColorBrush x:Key="BorderHoverBrush" Color="#6610C98F"/>
    <SolidColorBrush x:Key="BorderFocusBrush" Color="#9910C98F"/>
    <SolidColorBrush x:Key="SidebarBorderBrush" Color="#3310C98F"/>
    <SolidColorBrush x:Key="GlassBorderCyanBrush" Color="#4D10C98F"/>
    <SolidColorBrush x:Key="ActionGhostHoverBrush" Color="#1410C98F"/>
    <SolidColorBrush x:Key="ActionGhostBorderBrush" Color="#5910C98F"/>

</ResourceDictionary>
