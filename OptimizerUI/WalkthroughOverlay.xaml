<UserControl x:Class="JamesOptimizer.WalkthroughOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="850" d:DesignWidth="1350"
             Visibility="Collapsed"
             IsHitTestVisible="True"
             Background="Transparent"
             Focusable="True"
             KeyDown="UserControl_KeyDown">

    <Grid x:Name="RootGrid" Background="Transparent" MouseLeftButtonDown="RootGrid_MouseLeftButtonDown">
        
        <!-- Scrim with Cutout -->
        <Path x:Name="OverlayPath" Fill="#CC000000">
            <Path.Data>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <!-- Full screen bounds will be set in code -->
                        <RectangleGeometry x:Name="OuterGeometry" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <!-- Target cutout bounds will be animated in code -->
                        <RectangleGeometry x:Name="InnerGeometry" RadiusX="8" RadiusY="8" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Path.Data>
        </Path>

        <!-- Floating Callout Card -->
        <Border x:Name="CalloutCard" HorizontalAlignment="Left" VerticalAlignment="Top" 
                Width="350" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource BorderAccent}" BorderThickness="1.5" CornerRadius="12"
                Margin="0,0,0,0" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="30" ShadowDepth="0" Opacity="0.5"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock x:Name="TxtWalkthroughTitle" Text="Welcome" FontWeight="Black" FontSize="20" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,10"/>
                <TextBlock x:Name="TxtWalkthroughDesc" Text="Description here..." TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,20"/>
                
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStepCounter" Text="1 of 5" Foreground="{DynamicResource TextMuted}" FontSize="12" FontWeight="SemiBold"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="BtnWalkthroughSkip" Content="Skip" Style="{StaticResource GhostActionButton}" Padding="14,6" FontSize="13" Margin="0,0,12,0" Click="BtnWalkthroughSkip_Click"/>
                        <Button x:Name="BtnWalkthroughNext" Content="Next &#x2192;" Style="{StaticResource PrimaryActionButton}" Padding="18,8" FontSize="13" Click="BtnWalkthroughNext_Click"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
