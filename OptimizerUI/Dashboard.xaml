                                <Path Data="M3 3h7v7H3V3zm11 0h7v7h-7V3zm-11 11h7v7H3v-7zm11 0h7v7h-7v-7z" Fill="{DynamicResource TextMuted}" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.4" ToolTip="Grid View (Coming Soon)"/>
                            </Grid>

                            <!-- 4 metric tiles stacked (CPU, GPU, RAM, Disk) -->
                            <StackPanel>
