                            <TextBlock Text="STORAGE OVERVIEW" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,16"/>

                            <!-- 3 disk entries (C:, D:, E:) -->
                            <StackPanel x:Name="StorageStack">
                                <!-- Drive C: -->
                                <Border x:Name="BorderDriveC" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <!-- Donut chart (52×52px) -->
                                        <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center">
                                            <Ellipse Width="44" Height="44" Stroke="{DynamicResource BorderSubtle}" StrokeThickness="5" Fill="Transparent"/>
                                            <Ellipse x:Name="DonutDriveC" Width="44" Height="44" Stroke="{DynamicResource AccentCyan}" StrokeThickness="5" StrokeDashArray="17 10" StrokeDashCap="Round" Fill="Transparent" RenderTransformOrigin="0.5,0.5">
