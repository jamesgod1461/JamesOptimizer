                                            <TextBlock x:Name="TxtDriveCPercent" Text="62%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <!-- Drive Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="TxtDriveCLabel" Text="System Drive (C:)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="TxtDriveCTotal" Text="Total: 930.4 GB" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtDriveCUsedFree" Text="Used: 573.4 GB  ·  Free: 357.0 GB" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Drive D: -->
                                <Border x:Name="BorderDriveD" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center">
                                            <Ellipse Width="44" Height="44" Stroke="{DynamicResource BorderSubtle}" StrokeThickness="5" Fill="Transparent"/>
                                            <Ellipse x:Name="DonutDriveD" Width="44" Height="44" Stroke="{DynamicResource AccentViolet}" StrokeThickness="5" StrokeDashArray="12 15" StrokeDashCap="Round" Fill="Transparent" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <TextBlock x:Name="TxtDriveDPercent" Text="44%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="TxtDriveDLabel" Text="Games &amp; Apps (D:)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="TxtDriveDTotal" Text="Total: 1,863.0 GB" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtDriveDUsedFree" Text="Used: 819.7 GB  ·  Free: 1,043.3 GB" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- Drive E: -->
                                <Border x:Name="BorderDriveE" Background="{DynamicResource Surface2}" CornerRadius="10" Padding="12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center">
                                            <Ellipse Width="44" Height="44" Stroke="{DynamicResource BorderSubtle}" StrokeThickness="5" Fill="Transparent"/>
                                            <Ellipse x:Name="DonutDriveE" Width="44" Height="44" Stroke="{DynamicResource SuccessGreen}" StrokeThickness="5" StrokeDashArray="6 20" StrokeDashCap="Round" Fill="Transparent" RenderTransformOrigin="0.5,0.5">
                                                <Ellipse.RenderTransform><RotateTransform Angle="-90"/></Ellipse.RenderTransform>
                                            </Ellipse>
                                            <TextBlock x:Name="TxtDriveEPercent" Text="21%" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <TextBlock x:Name="TxtDriveELabel" Text="Media &amp; Backup (E:)" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock x:Name="TxtDriveETotal" Text="Total: 3,726.0 GB" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                            <TextBlock x:Name="TxtDriveEUsedFree" Text="Used: 782.5 GB  ·  Free: 2,943.5 GB" FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <!-- Bottom: "MANAGE STORAGE →" ghost button, full width -->
                            <Button x:Name="BtnManageStorage"
                                    Content="MANAGE STORAGE →"
                                    Style="{StaticResource GhostButton}"
                                    Height="38"
                                    Margin="0,12,0,0"
                                    Click="BtnManageStorage_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 HERO MISSION CTA (JamesGui Style "START MISSION" Button)
                 ══════════════════════════════════════════════════════════ -->
            <Button x:Name="BtnHeroStartOptimization"
                    Grid.Row="3"
                    Margin="0,28,0,0"
                    Style="{StaticResource HeroPillButton}"
                    Click="BtnRunOptimization_Click">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Play / Rocket Glyph inside circular white pill -->
                    <Border Width="26" Height="26" CornerRadius="13" Background="#FFFFFF" Margin="0,0,12,0" VerticalAlignment="Center">
                        <Path Data="M0,0 L9,6 L0,12 Z" Fill="#FF3B5C" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0"/>
                    </Border>
                    <TextBlock Text="START SYSTEM OPTIMIZATION" FontSize="14" FontWeight="Black" Foreground="#FFFFFF" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>
    </ScrollViewer>
</Page>
