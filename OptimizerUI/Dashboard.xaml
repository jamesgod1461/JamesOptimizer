<Page x:Class="JamesOptimizer.Dashboard"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:JamesOptimizer"
      Title="Dashboard"
      Background="Transparent"
      FontFamily="{DynamicResource PrimaryFontFamily}"
      Loaded="Dashboard_Loaded"
      Unloaded="Dashboard_Unloaded">

    <Page.Resources>
        <!-- ── PROFILE SELECTOR PILL STYLE ── -->
        <Style x:Key="ProfileRadioButtonStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="PillBorder"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,5"
                                SnapsToDevicePixels="True">
                            <TextBlock x:Name="TxtContent"
                                       Text="{TemplateBinding Content}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"
                                       VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter TargetName="TxtContent" Property="Foreground" Value="{DynamicResource TextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="PillBorder" Property="Background" Value="{DynamicResource NavActiveGradient}"/>
                                <Setter TargetName="PillBorder" Property="BorderBrush" Value="{DynamicResource BorderAccent}"/>
                                <Setter TargetName="TxtContent" Property="Foreground" Value="{DynamicResource AccentCyan}"/>
                                <Setter TargetName="TxtContent" Property="FontWeight" Value="Bold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── QUICK ACTION TILE STYLE (JamesGui Elevated Cards) ── -->
        <Style x:Key="DashboardActionTileStyle" TargetType="Button">
            <Setter Property="Height" Value="68"/>
            <Setter Property="Background" Value="{DynamicResource Surface1}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TileBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource BorderSubtle}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14,10"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Dedicated Squircle Icon Container (JamesGui style) -->
                                <Border x:Name="IconSquircle" Grid.Column="0"
                                        Width="40" Height="40" CornerRadius="10"
                                        Background="#181D2A" BorderBrush="#283247" BorderThickness="1"
                                        VerticalAlignment="Center" Margin="0,0,14,0">
                                    <Viewbox Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path x:Name="TileIcon"
                                              Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                              Fill="{DynamicResource AccentCyan}"
                                              Stretch="Uniform"/>
                                    </Viewbox>
                                </Border>

                                <!-- Center: Title & Subtitle -->
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>

                                <!-- Right: › chevron (TextMuted) -->
                                <TextBlock x:Name="TileChevron"
                                           Grid.Column="2"
                                           Text="›"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextMuted}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,4,0">
                                    <TextBlock.RenderTransform>
                                        <TranslateTransform x:Name="ChevronShift" X="0"/>
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TileBorder" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter TargetName="TileBorder" Property="BorderBrush" Value="#6600E5FF"/>
                                <Setter TargetName="IconSquircle" Property="Background" Value="#222B3D"/>
                                <Setter TargetName="IconSquircle" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
                                <Setter TargetName="TileIcon" Property="Fill" Value="#FFFFFF"/>
                                <Setter TargetName="TileIcon" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="12" Opacity="0.8" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="4" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ChevronShift"
                                                             Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.15">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ── ROOT SCROLLVIEWER ── -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <!-- Page padding: 32px horizontal, 28px top, 80px bottom -->
        <Grid Margin="32,28,32,48">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Top Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Separator -->
                <RowDefinition Height="*"/>    <!-- Row 2: Main 2-Column Content -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Hero Mission CTA -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 TOP HEADER (spans both columns)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Welcome back, JAMES -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Welcome back, " FontSize="28" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                        <TextBlock Text="JAMES" FontSize="28" FontWeight="Bold">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource ColorAccentCyan}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource ColorAccentViolet}" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="Optimize. Boost. Dominate." FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,0"/>
                </StackPanel>

                <!-- Right: System status pill (CornerRadius 24, Padding 8px 18px, PulseGlow) -->
                <Border x:Name="StatusPillBorder"
                        Grid.Column="1"
                        CornerRadius="24"
                        Padding="18,8"
                        Background="#1A00FF88"
                        BorderBrush="#4D00FF88"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Left dot: 8px circle with PulseGlow animation -->
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessGreen}" VerticalAlignment="Center" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00FF88" BlurRadius="12" Opacity="0.7" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM STATUS" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtStatusValue" Text="EXCELLENT" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 PROFILES SWITCHER (Gaming · Work · Battery Saver) + EXPORT
                 ══════════════════════════════════════════════════════════ -->
            <Border Grid.Row="1" Margin="0,0,0,24" Background="{DynamicResource Surface1}" BorderBrush="{DynamicResource BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="⚡" FontSize="14" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="OPTIMIZATION PROFILE:" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center"/>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <RadioButton x:Name="ProfileGaming" Content="🎮 Gaming Session" Style="{StaticResource ProfileRadioButtonStyle}" IsChecked="True" Click="ProfileRadio_Click" Margin="0,0,8,0"/>
                        <RadioButton x:Name="ProfileWork" Content="💻 Work &amp; Dev" Style="{StaticResource ProfileRadioButtonStyle}" Click="ProfileRadio_Click" Margin="0,0,8,0"/>
                        <RadioButton x:Name="ProfileEco" Content="🔋 Battery Saver" Style="{StaticResource ProfileRadioButtonStyle}" Click="ProfileRadio_Click"/>
                    </StackPanel>

                    <Button Grid.Column="2" x:Name="BtnExportReportDashboard"
                            Style="{StaticResource ConsoleChipStyle}"
                            Click="BtnExportReportDashboard_Click"
                            ToolTip="Export Branded Optimization Report HTML">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📄" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="EXPORT REPORT" FontSize="10" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ══════════════════════════════════════════════════════════
                 MAIN CONTENT: 2-COLUMN GRID (Left 60%, Right 40%, Gap 24px)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>  <!-- Left: 60% -->
                    <ColumnDefinition Width="24"/>  <!-- Gap: 24px -->
                    <ColumnDefinition Width="2*"/>  <!-- Right: 40% -->
                </Grid.ColumnDefinitions>

                <!-- ──────────────────────────────────────────────────────────
                     LEFT COLUMN (60% width)
                     ────────────────────────────────────────────────────────── -->
                <StackPanel Grid.Column="0">

                    <!-- ① OPTIMIZATION SCORE CARD (GlassCard) -->
                    <Border Style="{StaticResource GlassCard}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Left: SVG radial gauge (180px diameter) -->
                            <Grid Grid.Column="0" Width="180" Height="180" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- Outer glow halo: Ellipse AccentCyan 8% opacity, 200px, blur 24px -->
                                <Ellipse Width="180" Height="180" Fill="#1400D4FF">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="24" Opacity="0.5" ShadowDepth="0"/>
                                    </Ellipse.Effect>
                                </Ellipse>

                                <!-- Outer ring: BorderSubtle, 10px stroke, full circle -->
                                <Ellipse Width="160" Height="160" Stroke="{DynamicResource BorderSubtle}" StrokeThickness="10" Fill="Transparent"/>

                                <!-- Progress ring: AccentCyan→AccentViolet gradient, 10px stroke -->
                                <Ellipse x:Name="ScoreProgressRing"
                                         Width="160" Height="160"
                                         StrokeThickness="10"
                                         StrokeDashArray="45.2 100"
                                         StrokeDashCap="Round"
                                         RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <RotateTransform Angle="-90"/>
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Stroke>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="{DynamicResource ColorAccentCyan}" Offset="0"/>
                                            <GradientStop Color="{DynamicResource ColorAccentViolet}" Offset="1"/>
                                        </LinearGradientBrush>
                                    </Ellipse.Stroke>
                                </Ellipse>

                                <!-- Center: Score number (52px Bold, TextPrimary) + "/100" (16px, TextMuted) -->
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtScoreNumber" Text="90" FontSize="52" FontWeight="Black" Foreground="{DynamicResource TextPrimary}" HorizontalAlignment="Center" Margin="0,-4,0,-4"/>
                                    <TextBlock Text="/100" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- Right: Status info & sub-scores -->
                            <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="TxtScoreHeadline" Text="YOUR SYSTEM IS OPTIMIZED" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock x:Name="TxtScoreSubtitle" Text="All primary background schedulers and kernel threads running at peak efficiency."
                                           FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="0,4,0,12"/>

                                <!-- Thin horizontal progress bar AccentCyan full width -->
                                <ProgressBar x:Name="MainScoreBar" Value="90" Height="4" Margin="0,0,0,16" Style="{StaticResource MetricProgressBar}"/>

                                <!-- 4 sub-score rows: System Health, Performance, Security, Stability -->
                                <UniformGrid Columns="2" Rows="2">
                                    <!-- 1. System Health -->
                                    <Grid Margin="0,4,14,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock x:Name="IconHealthCheck" Text="✓" Foreground="{DynamicResource AccentCyan}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <TextBlock Text="System Health" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtHealthSubScore" Grid.Row="0" Grid.Column="1" Text="94% · Excellent" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarHealthSubScore" Grid.Row="1" Grid.ColumnSpan="2" Value="94" Height="3" HorizontalAlignment="Stretch" Margin="0,6,0,0" Background="{DynamicResource BorderSubtle}" Foreground="{DynamicResource SuccessGreen}" BorderThickness="0"/>
                                    </Grid>

                                    <!-- 2. Performance -->
                                    <Grid Margin="0,4,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock x:Name="IconPerfCheck" Text="✓" Foreground="{DynamicResource AccentCyan}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <TextBlock Text="Performance" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtPerfSubScore" Grid.Row="0" Grid.Column="1" Text="88% · Excellent" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarPerfSubScore" Grid.Row="1" Grid.ColumnSpan="2" Value="88" Height="3" HorizontalAlignment="Stretch" Margin="0,6,0,0" Background="{DynamicResource BorderSubtle}" Foreground="{DynamicResource SuccessGreen}" BorderThickness="0"/>
                                    </Grid>

                                    <!-- 3. Security -->
                                    <Grid Margin="0,4,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock x:Name="IconSecCheck" Text="✓" Foreground="{DynamicResource AccentCyan}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <TextBlock Text="Security" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSecSubScore" Grid.Row="0" Grid.Column="1" Text="92% · Excellent" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarSecSubScore" Grid.Row="1" Grid.ColumnSpan="2" Value="92" Height="3" HorizontalAlignment="Stretch" Margin="0,6,0,0" Background="{DynamicResource BorderSubtle}" Foreground="{DynamicResource SuccessGreen}" BorderThickness="0"/>
                                    </Grid>

                                    <!-- 4. Stability -->
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                            <TextBlock x:Name="IconStabCheck" Text="✓" Foreground="{DynamicResource AccentCyan}" FontSize="12" FontWeight="Bold" Margin="0,0,4,0"/>
                                            <TextBlock Text="Stability" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtStabSubScore" Grid.Row="0" Grid.Column="1" Text="86% · Excellent" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                                        <ProgressBar x:Name="BarStabSubScore" Grid.Row="1" Grid.ColumnSpan="2" Value="86" Height="3" HorizontalAlignment="Stretch" Margin="0,6,0,0" Background="{DynamicResource BorderSubtle}" Foreground="{DynamicResource SuccessGreen}" BorderThickness="0"/>
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ② QUICK ACTIONS CARD (GlassCard, margin-top 24px) -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,24,0,0">
                        <StackPanel>
                            <!-- Header: "QUICK ACTIONS" (SectionLabel) + lightning bolt icon AccentCyan -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="{DynamicResource AccentCyan}" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock Text="QUICK ACTIONS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- 2×3 grid of action tiles, gap 12px -->
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 1. 1-Click Optimize — target icon -->
                                <Button x:Name="BtnQuickOptimize" Grid.Row="0" Grid.Column="0" Margin="0,0,0,12"
                                        Style="{StaticResource DashboardActionTileStyle}"
                                        Click="BtnQuickAction_Click"
                                        Tag="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8zm0-14c-3.31 0-6 2.69-6 6s2.69 6 6 6 6-2.69 6-6-2.69-6-6-6zm0 10c-2.21 0-4-1.79-4-4s1.79-4 4-4 4 1.79 4 4-1.79 4-4 4z">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="1-Click Optimize" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtQuickOptimizeSubtitle" Text="Smart optimization" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- 2. Clean Junk — trash icon -->
                                <Button x:Name="BtnQuickClean" Grid.Row="0" Grid.Column="2" Margin="0,0,0,12"
                                        Style="{StaticResource DashboardActionTileStyle}"
                                        Click="BtnQuickAction_Click"
                                        Tag="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Clean Junk" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtQuickCleanSubtitle" Text="Free up space" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- 3. Boost Performance — rocket icon -->
                                <Button x:Name="BtnQuickBoost" Grid.Row="1" Grid.Column="0" Margin="0,0,0,12"
                                        Style="{StaticResource DashboardActionTileStyle}"
                                        Click="BtnQuickAction_Click"
                                        Tag="M12 2.5s-4 4-4 9.5c0 2.5 1 4.5 2 5.5l-1 3.5 3-1.5 3 1.5-1-3.5c1-1 2-3 2-5.5 0-5.5-4-9.5-4-9.5zm-1 8a1 1 0 1 1 2 0 1 1 0 0 1-2 0z">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Boost Performance" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtQuickBoostSubtitle" Text="Maximize speed" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- 4. RAM Cleanup — lightning icon -->
                                <Button x:Name="BtnQuickRam" Grid.Row="1" Grid.Column="2" Margin="0,0,0,12"
                                        Style="{StaticResource DashboardActionTileStyle}"
                                        Click="BtnQuickAction_Click"
                                        Tag="M7 2v11h3v9l7-12h-4l4-8z">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="RAM Cleanup" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtQuickRamSubtitle" Text="Free up memory" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- 5. Startup Manager — list icon -->
                                <Button x:Name="BtnQuickStartup" Grid.Row="2" Grid.Column="0"
                                        Style="{StaticResource DashboardActionTileStyle}"
                                        Click="BtnQuickAction_Click"
                                        Tag="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zM7 7v2h14V7H7z">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Startup Manager" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock x:Name="TxtQuickStartupSubtitle" Text="Manage startup apps" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                </Button>

                                <!-- 6. Network Boost — globe icon -->
                                <Button x:Name="BtnQuickNetwork" Grid.Row="2" Grid.Column="2"
                                        Style="{StaticResource DashboardActionTileStyle}"
                                        Click="BtnQuickAction_Click"
                                        Tag="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z">
