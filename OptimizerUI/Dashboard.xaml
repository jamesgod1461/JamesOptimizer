                                        <Canvas x:Name="CanvasDisk" Grid.Column="1" Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                                        <TextBlock x:Name="TxtDiskUsage" Grid.Column="2" Text="2%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningAmber}" VerticalAlignment="Center"/>
