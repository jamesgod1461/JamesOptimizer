                                <Border Background="{DynamicResource Surface2}" CornerRadius="10" Height="64" Padding="14,0" Margin="0,0,0,10">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="95">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 14H4V6h16v12zM6 10h4v4H6zm6 0h6v4h-6z"
                                                      Fill="{DynamicResource AccentViolet}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="GPU" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtGpuTemp" Text="42°C · Temp" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="24,2,0,0"/>
                                        </StackPanel>
                                        <Canvas x:Name="CanvasGpu" Grid.Column="1" Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                                        <TextBlock x:Name="TxtGpuUsage" Grid.Column="2" Text="8%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- RAM Usage -->
                                <Border Background="{DynamicResource Surface2}" CornerRadius="10" Height="64" Padding="14,0" Margin="0,0,0,10">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Width="95">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M2 7h20v10H2V7zm2 2v6h16V9H4zm2 1h2v4H6v-4zm4 0h2v4h-2v-4zm4 0h2v4h-2v-4z"
                                                      Fill="{DynamicResource SuccessGreen}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                <TextBlock Text="RAM" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtRamSubtitle" Text="12.4 / 32.0 GB" FontSize="10" Foreground="{DynamicResource TextMuted}" Margin="24,2,0,0"/>
                                        </StackPanel>
                                        <Canvas x:Name="CanvasRam" Grid.Column="1" Width="80" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True"/>
                                        <TextBlock x:Name="TxtRamUsage" Grid.Column="2" Text="39%" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <!-- Disk Usage -->
                                <Border Background="{DynamicResource Surface2}" CornerRadius="10" Height="64" Padding="14,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Width="95">
                                            <Path Data="M2 20h20v-4H2v4zm2-3h2v2H4v-2zM2 4v4h20V4H2zm4 3H4V5h2v2zm-4 7h20v-4H2v4zm2-3h2v2H4v-2z"
                                                  Fill="{DynamicResource WarningAmber}" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                            <TextBlock Text="DISK" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
