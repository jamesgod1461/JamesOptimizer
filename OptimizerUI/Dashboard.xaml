                                <RadioButton x:Name="ChipAuto15"   Content="15M" Tag="15"   GroupName="AutoFreq" Style="{StaticResource ProfileRadioButtonStyle}" Click="AutoChip_Click" Margin="0,0,6,0"/>
                                <RadioButton x:Name="ChipAuto30"   Content="30M" Tag="30"   GroupName="AutoFreq" Style="{StaticResource ProfileRadioButtonStyle}" Click="AutoChip_Click" Margin="0,0,6,0"/>
                                <RadioButton x:Name="ChipAuto45"   Content="45M" Tag="45"   GroupName="AutoFreq" Style="{StaticResource ProfileRadioButtonStyle}" Click="AutoChip_Click" Margin="0,0,6,0"/>
                                <RadioButton x:Name="ChipAuto60"   Content="1H"  Tag="60"   GroupName="AutoFreq" Style="{StaticResource ProfileRadioButtonStyle}" Click="AutoChip_Click" Margin="0,0,6,0"/>
                                <RadioButton x:Name="ChipAuto120"  Content="2H"  Tag="120"  GroupName="AutoFreq" Style="{StaticResource ProfileRadioButtonStyle}" Click="AutoChip_Click" Margin="0,0,6,0"/>
                                <RadioButton x:Name="ChipAuto180"  Content="3H"  Tag="180"  GroupName="AutoFreq" Style="{StaticResource ProfileRadioButtonStyle}" Click="AutoChip_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ④ OPTIMIZATION SUMMARY (GlassCard, margin-top 16px) -->
                    <Border Style="{StaticResource GlassCard}" Margin="0,16,0,0">
                        <StackPanel>
                            <!-- Header: "OPTIMIZATION SUMMARY" -->
                            <TextBlock Text="OPTIMIZATION SUMMARY" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SectionLabelBrush}" Margin="0,0,0,16"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Left: Donut Chart SVG (120px) -->
                                <Grid Grid.Column="0" Width="120" Height="120" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <!-- Resolved segment (AccentCyan) -->
                                    <Ellipse Width="100" Height="100" Stroke="{DynamicResource AccentCyan}" StrokeThickness="10" Fill="Transparent"/>

                                    <!-- Issues segment (WarningAmber) -->
                                    <Ellipse x:Name="IssuesSegment" Width="100" Height="100"
