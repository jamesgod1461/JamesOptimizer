<Page x:Class="JamesOptimizer.ServiceManager"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:JamesOptimizer"
      Title="Service Manager"
      Background="Transparent"
      FontFamily="{DynamicResource PrimaryFontFamily}"
      Loaded="ServiceManager_Loaded">

    <Page.Resources>
        <!-- Service Debloate Ghost Button (AccentViolet border/text) -->
        <Style x:Key="DebloateButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentViolet}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentViolet}"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{DynamicResource GlowViolet}"/>
                                <Setter TargetName="Border" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentViolet}" BlurRadius="12" Opacity="0.4" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact Ghost Button -->
        <Style x:Key="CompactGhostButtonStyle" TargetType="Button" BasedOn="{StaticResource GhostButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </Page.Resources>

    <Grid>
        <!-- Main Content -->
        <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="32,28,32,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/> <!-- Header -->
                    <RowDefinition Height="Auto"/> <!-- Separator -->
                    <RowDefinition Height="Auto"/> <!-- Toolbar -->
                    <RowDefinition Height="*"/>    <!-- Service List / Empty state -->
                </Grid.RowDefinitions>

                <!-- ══════════════════════════════════════════════════════
                     HEADER
                     ══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Gear icon (AccentCyan, 28px) -->
                        <Viewbox Width="28" Height="28" Margin="0,0,14,0">
                            <Path Fill="{DynamicResource AccentCyan}"
                                  Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"/>
                        </Viewbox>
                        <TextBlock Text="SERVICE MANAGER" Style="{StaticResource PageTitle}"/>
                    </StackPanel>
                    <TextBlock Text="Manage Windows Services, optimize background processes, and debloat Windows."
                               Style="{StaticResource BodyText}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- Separator -->
                <Rectangle Grid.Row="1" Height="1" Fill="{DynamicResource BorderSubtle}" Margin="0,20,0,20" SnapsToDevicePixels="True"/>

                <!-- ══════════════════════════════════════════════════════
                     TOOLBAR
                     Horizontal layout, space-between, margin-bottom 16px
                     ══════════════════════════════════════════════════════ -->
                <Grid Grid.Row="2" Margin="0,0,0,16">
                    <!-- Left side action buttons -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <!-- ↺ Refresh (GhostButton, compact) -->
                        <Button x:Name="BtnRefresh" Style="{StaticResource CompactGhostButtonStyle}"
                                Click="BtnRefresh_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="↺ " FontSize="14" FontWeight="Bold"/>
                                <TextBlock Text="Refresh" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>

                        <!-- 🛡 Service Debloate (GhostButton, AccentViolet border/text) -->
                        <Button x:Name="BtnOpenDebloat" Margin="10,0,0,0"
                                Style="{StaticResource DebloateButtonStyle}"
                                Click="BtnOpenDebloat_Click">
                            <StackPanel Orientation="Horizontal">
                                <Viewbox Width="14" Height="14" Margin="0,0,6,0">
                                    <Path Fill="{DynamicResource AccentViolet}"
                                          Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                                </Viewbox>
                                <TextBlock Text="Service Debloate" FontSize="13" FontWeight="SemiBold"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Right side search bar -->
                    <Grid HorizontalAlignment="Right" Width="240">
                        <TextBox x:Name="TxtSearch"
                                 Style="{StaticResource GlassSearchBar}"
                                 Tag="Search Services..."
                                 TextChanged="TxtSearch_TextChanged"/>
                    </Grid>
                </Grid>

                <!-- ══════════════════════════════════════════════════════
                     SERVICE LIST / EMPTY STATE
                     ══════════════════════════════════════════════════════ -->
                <StackPanel Grid.Row="3">
                    <!-- Loading Indicator -->
                    <Border x:Name="LoadingIndicator" Visibility="Collapsed" Padding="30" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Loading Windows Services..." Style="{StaticResource BodyText}"/>
                        </StackPanel>
                    </Border>

                    <!-- Service Items Container -->
                    <ItemsControl x:Name="ServicesListControl">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Height="72" Margin="0,0,0,8"
                                        Style="{StaticResource ListItemRow}"
                                        Padding="20,0">
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="280"/> <!-- Left: Publisher dot + Name + Publisher -->
                                            <ColumnDefinition Width="*"/>   <!-- Center: Service Name • Status • Startup -->
                                            <ColumnDefinition Width="Auto"/> <!-- Right: Status Badge + Action Button -->
                                        </Grid.ColumnDefinitions>

                                        <!-- Left section (280px) -->
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Publisher status dot (8px) -->
                                            <Ellipse Width="8" Height="8" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <Ellipse.Style>
                                                    <Style TargetType="Ellipse">
                                                        <Setter Property="Fill" Value="{DynamicResource WarningAmber}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DotType}" Value="Microsoft">
                                                                <Setter Property="Fill" Value="{DynamicResource AccentCyan}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding DotType}" Value="Verified">
                                                                <Setter Property="Fill" Value="{DynamicResource SuccessGreen}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Ellipse.Style>
                                            </Ellipse>

                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="245"/>
                                                <TextBlock Text="{Binding PublisherFormatted}"
                                                           FontSize="11" Foreground="{DynamicResource TextMuted}"
                                                           FontStyle="{Binding PublisherFontStyle}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="245" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Center section (flexible) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,16,0">
                                            <TextBlock Text="{Binding ServiceNameText}" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding StatusBrush}"/>
                                            <TextBlock Text="  •  " FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                            <TextBlock Text="{Binding StartupText}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                        </StackPanel>

                                        <!-- Right section (auto): Status Badge + Start/Stop Button -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- Status Badge -->
                                            <Border CornerRadius="8" Padding="10,4" Margin="0,0,12,0" Background="{Binding BadgeBg}" BorderBrush="{Binding BadgeBorder}" BorderThickness="1">
                                                <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding BadgeFg}"/>
                                            </Border>

                                            <!-- Start/Stop Button -->
                                            <Button Width="80" Height="34"
                                                    Tag="{Binding ServiceName}"
                                                    Click="BtnToggleService_Click"
                                                    Style="{Binding ActionButtonStyle}">
                                                <TextBlock Text="{Binding ActionButtonText}" FontSize="12" FontWeight="SemiBold"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ── EMPTY STATE ── -->
                    <Border x:Name="EmptyStateBorder" Visibility="Collapsed" Margin="0,48,0,0" HorizontalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                            <Viewbox Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,12">
                                <Path Fill="{DynamicResource TextMuted}"
                                      Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                            </Viewbox>
                            <TextBlock Text="No services found" Style="{StaticResource CardTitle}" HorizontalAlignment="Center"/>
                            <TextBlock Text="Try a different search term" Style="{StaticResource BodyText}" HorizontalAlignment="Center" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- ══════════════════════════════════════════════════════════════
             DEBLOAT CONFIRMATION MODAL DIALOG
             GlassCard modal overlay, 460px wide, CornerRadius 16
             Backdrop: #000000 40% opacity
             ══════════════════════════════════════════════════════════════ -->
        <Grid x:Name="DebloatModalGrid" Visibility="Collapsed" Background="#66000000">
            <Border x:Name="DebloatModalCard"
                    Width="460" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Style="{StaticResource GlassCard}"
                    CornerRadius="16" Padding="32">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ModalScale" ScaleX="1" ScaleY="1" CenterX="230" CenterY="130"/>
                </Border.RenderTransform>
                <StackPanel>
                    <!-- Warning Icon (DangerRed 40px) -->
                    <Viewbox Width="40" Height="40" HorizontalAlignment="Center" Margin="0,0,0,14">
                        <Path Fill="{DynamicResource DangerRed}"
                              Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                    </Viewbox>

                    <TextBlock Text="Service Debloater" FontSize="18" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="This will disable non-essential Windows services. A system restore point will be created first."
                               Style="{StaticResource BodyText}"
                               TextAlignment="Center"
                               Margin="0,12,0,24"/>

                    <!-- Action Buttons: Cancel GhostButton + Proceed DangerButton -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel" Height="42"
                                Style="{StaticResource GhostButton}"
                                Click="BtnCancelDebloat_Click"/>

                        <Button Grid.Column="2" Content="Proceed" Height="42"
                                Style="{StaticResource DangerButton}"
                                Click="BtnProceedDebloat_Click"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
