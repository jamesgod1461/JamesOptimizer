<Page x:Class="JamesOptimizer.SystemCleanups"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:JamesOptimizer"
      Title="System Cleanups"
      Background="Transparent"
      FontFamily="{DynamicResource PrimaryFontFamily}"
      Loaded="SystemCleanups_Loaded">

    <Page.Resources>
        <!-- ── CLEANUP GHOST BUTTON STYLE (Cyan Accent - Column 1) ── -->
        <Style x:Key="CleanupGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentCyan}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="18" Opacity="0.35" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CLEANUP VIOLET GHOST BUTTON STYLE (Violet Accent - Column 2) ── -->
        <Style x:Key="CleanupVioletGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{DynamicResource Surface2}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderSubtle}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentViolet}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorAccentViolet}" BlurRadius="18" Opacity="0.35" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CLEANUP DANGER GHOST BUTTON STYLE (Column 3 Service Debloater) ── -->
        <Style x:Key="CleanupDangerGhostButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="58"/>
            <Setter Property="Background" Value="{DynamicResource DangerBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource DangerHoverBackground}"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource DangerRed}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorDangerRed}" BlurRadius="20" Opacity="0.45" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="{DynamicResource Surface1}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ── CLEANUP PRIMARY BUTTON STYLE (Column 3 Ultimate Debloat Hero Button) ── -->
        <Style x:Key="CleanupPrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="60"/>
            <Setter Property="Background" Value="{DynamicResource HeroGradient}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform X="0" Y="0"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="14,0"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ColorHeroCoral}" BlurRadius="22" Opacity="0.5" ShadowDepth="0"/>
                            </Border.Effect>
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="{DynamicResource ColorHeroCoral}" BlurRadius="30" Opacity="0.75" ShadowDepth="0"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- ── ROOT SCROLLVIEWER ── -->
    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <!-- Page padding: 32px horizontal, 28px top, 32px bottom -->
        <Grid Margin="32,28,32,32">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Row 0: Header -->
                <RowDefinition Height="Auto"/> <!-- Row 1: Separator -->
                <RowDefinition Height="*"/>    <!-- Row 2: 3-Column Card Grid -->
                <RowDefinition Height="Auto"/> <!-- Row 3: Pro Tip Card -->
            </Grid.RowDefinitions>

            <!-- ══════════════════════════════════════════════════════════
                 HEADER
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Title & Subtitle with Glowing Icon Squircle -->
                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Icon Badge: Glowing squircle container with Broom Icon -->
                        <Border Width="42" Height="42"
                                CornerRadius="11"
                                Background="{DynamicResource Surface2}"
                                BorderBrush="{DynamicResource BorderAccent}"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource ColorAccentGlow}" BlurRadius="14" Opacity="0.4" ShadowDepth="0"/>
                            </Border.Effect>
                            <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Path Data="M19.36 2.72l1.42 1.42-3.18 3.18-1.42-1.42 3.18-3.18z M15.78 7.32l1.42 1.42L8.71 15.81 7.29 14.39 14.36 7.32z M3 21v-3l5-5 3 3-5 5H3z"
                                      Fill="{DynamicResource AccentCyan}"/>
                            </Viewbox>
                        </Border>

                        <!-- Page title: "SYSTEM CLEANUPS" -->
                        <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SYSTEM CLEANUPS"
                                       FontSize="24"
                                       FontWeight="Black"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Subtitle: High contrast and legible -->
                    <TextBlock Text="Remove junk, clear caches, and debloat Windows for a faster, cleaner system."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondary}"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <!-- Right: System Health Indicator Pill -->
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        CornerRadius="20"
                        Background="{DynamicResource Surface1}"
                        BorderBrush="{DynamicResource BorderSubtle}"
                        BorderThickness="1"
                        Padding="14,7">
                    <Border.Effect>
                        <DropShadowEffect Color="#000000" BlurRadius="12" Opacity="0.3" ShadowDepth="0"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessGreen}" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#00FF9D" BlurRadius="8" Opacity="0.9" ShadowDepth="0"/>
                            </Ellipse.Effect>
                        </Ellipse>
                        <TextBlock Text="ENGINE ACTIVE · CLEAN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SuccessGreen}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Separator line: 1px BorderSubtle, margin 20px 0 -->
            <Rectangle Grid.Row="1"
                       Height="1"
                       Fill="{DynamicResource BorderSubtle}"
                       Margin="0,20,0,24"
                       SnapsToDevicePixels="True"/>

            <!-- ══════════════════════════════════════════════════════════
                 MAIN CONTENT: 3-COLUMN CARD GRID (1:1:1, Gap 20px)
                 ══════════════════════════════════════════════════════════ -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ──────────────────────────────────────────────────────
                     COLUMN 1: SYSTEM CLEANUPS (AccentCyan)
                     ────────────────────────────────────────────────────── -->
                <Border x:Name="Card1"
                        Grid.Column="0"
                        Style="{StaticResource GlassCard}"
                        Padding="0"
                        ClipToBounds="True"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TransCard1" Y="16"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3.5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Luminous section accent bar (Cyan Gradient with Glow) -->
                        <Border Grid.Row="0" CornerRadius="16,16,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource ColorAccentGlow}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource ColorAccentViolet}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Card Content: Padding 22px inside -->
                        <StackPanel Grid.Row="1" Margin="22">
                            <!-- Title Row with Pill Badge -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="System Cleanups" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        CornerRadius="6"
                                        Background="#1A00E5FF"
                                        BorderBrush="#4D00E5FF"
                                        BorderThickness="1"
                                        Padding="7,2">
                                    <TextBlock Text="3 UTILITIES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentCyan}"/>
                                </Border>
                            </Grid>

                            <!-- Description -->
                            <TextBlock Text="Safely remove unnecessary temporary files, clear caches, and flush system memory."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,18"/>

                            <!-- Button list: StackPanel, gap 10px -->
                            <StackPanel>
                                <!-- 1. Clean Up RAM -->
                                <Button x:Name="BtnCleanRam"
                                        Style="{StaticResource CleanupGhostButtonStyle}"
                                        Click="BtnCleanRam_Click"
                                        Margin="0,0,0,10"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnCleanRam" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon container -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A00E5FF" BorderBrush="#3300E5FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M22.7 19l-9.1-9.1c.9-2.3.4-5-1.5-6.9-2-2-5-2.4-7.4-1.3L9 6 6 9 1.6 4.7C.4 7.1.9 10.1 2.9 12.1c1.9 1.9 4.6 2.4 6.9 1.5l9.1 9.1c.4.4 1 .4 1.4 0l2.3-2.3c.5-.4.5-1.1.1-1.4z"
                                                      Fill="{DynamicResource AccentCyan}"/>
                                            </Viewbox>
                                        </Border>

                                        <!-- Title + Subtitle -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Clean Up RAM" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Free system memory instantly" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Right Chevron -->
                                        <TextBlock Grid.Column="2" Text="›" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </Button>

                                <!-- 2. Flush Network DNS -->
                                <Button x:Name="BtnFlushDns"
                                        Style="{StaticResource CleanupGhostButtonStyle}"
                                        Click="BtnFlushDns_Click"
                                        Margin="0,0,0,10"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnFlushDns" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon container -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A00E5FF" BorderBrush="#3300E5FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"
                                                      Fill="{DynamicResource AccentCyan}"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Flush Network DNS" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Clear DNS resolver cache" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="›" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </Button>

                                <!-- 3. Fast Temp Clean -->
                                <Button x:Name="BtnFastTempClean"
                                        Style="{StaticResource CleanupGhostButtonStyle}"
                                        Click="BtnFastTempClean_Click"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnFastTempClean" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon container -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A00E5FF" BorderBrush="#3300E5FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z"
                                                      Fill="{DynamicResource AccentCyan}"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Fast Temp Clean" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Remove temp files in seconds" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="›" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentCyan}" VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ──────────────────────────────────────────────────────
                     COLUMN 2: ADVANCED CLEANUPS (AccentViolet)
                     ────────────────────────────────────────────────────── -->
                <Border x:Name="Card2"
                        Grid.Column="2"
                        Style="{StaticResource GlassCard}"
                        Padding="0"
                        ClipToBounds="True"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TransCard2" Y="16"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3.5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Luminous section accent bar (Violet Gradient) -->
                        <Border Grid.Row="0" CornerRadius="16,16,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource ColorAccentViolet}" Offset="0"/>
                                    <GradientStop Color="#D946EF" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Card Content: Padding 22px inside -->
                        <StackPanel Grid.Row="1" Margin="22">
                            <!-- Title Row with Pill Badge -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Advanced Cleanups" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        CornerRadius="6"
                                        Background="#1A8A67FF"
                                        BorderBrush="#4D8A67FF"
                                        BorderThickness="1"
                                        Padding="7,2">
                                    <TextBlock Text="2 UTILITIES" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource AccentViolet}"/>
                                </Border>
                            </Grid>

                            <!-- Description -->
                            <TextBlock Text="Deeply clean up shader caches, game leftovers, and reclaim disk space from update files."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,18"/>

                            <!-- Button list: StackPanel, gap 10px -->
                            <StackPanel>
                                <!-- 1. Clear Shader Caches -->
                                <Button x:Name="BtnClearShaderCaches"
                                        Style="{StaticResource CleanupVioletGhostButtonStyle}"
                                        Click="BtnClearShaderCaches_Click"
                                        Margin="0,0,0,10"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnClearShaderCaches" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon container -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A8A67FF" BorderBrush="#338A67FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M21 6H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-10 7H8v3H6v-3H3v-2h3V8h2v3h3v2zm4.5 2c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm3-3c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z"
                                                      Fill="{DynamicResource AccentViolet}"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Clear Shader Caches" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Remove GPU shader cache files" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="›" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentViolet}" VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </Button>

                                <!-- 2. Deep System Cleanup -->
                                <Button x:Name="BtnDeepCleanup"
                                        Style="{StaticResource CleanupVioletGhostButtonStyle}"
                                        Click="BtnDeepCleanup_Click"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnDeepCleanup" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Icon container -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#1A8A67FF" BorderBrush="#338A67FF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M16 9v10H8V9h8m-1.5-6h-5l-1 1H5v2h14V4h-3.5l-1-1zM18 7H6v12c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7z"
                                                      Fill="{DynamicResource AccentViolet}"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Deep System Cleanup" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                            <TextBlock Text="Full junk scan and removal" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="›" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource AccentViolet}" VerticalAlignment="Center" Margin="4,0,0,0" Opacity="0.7"/>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ──────────────────────────────────────────────────────
                     COLUMN 3: WINDOWS DEBLOAT (DangerRed)
                     ────────────────────────────────────────────────────── -->
                <Border x:Name="Card3"
                        Grid.Column="4"
                        Style="{StaticResource GlassCard}"
                        Padding="0"
                        ClipToBounds="True"
                        Opacity="0">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="TransCard3" Y="16"/>
                    </Border.RenderTransform>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3.5"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top: Luminous section accent bar (Coral Rose Gradient) -->
                        <Border Grid.Row="0" CornerRadius="16,16,0,0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource ColorDangerRed}" Offset="0"/>
                                    <GradientStop Color="#FF8533" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Card Content: Padding 22px inside -->
                        <StackPanel Grid.Row="1" Margin="22">
                            <!-- Title Row with Pill Badge -->
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="Windows Debloat" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border HorizontalAlignment="Right"
                                        CornerRadius="6"
                                        Background="#1FFF4D6D"
                                        BorderBrush="{DynamicResource DangerBorder}"
                                        BorderThickness="1"
                                        Padding="7,2">
                                    <TextBlock Text="CRITICAL" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource DangerRed}"/>
                                </Border>
                            </Grid>

                            <!-- Description -->
                            <TextBlock Text="Completely remove Windows telemetry, pre-installed bloatware, and unnecessary background services."
                                       FontSize="12"
                                       Foreground="{DynamicResource TextMuted}"
                                       TextWrapping="Wrap"
                                       LineHeight="18"
                                       Margin="0,4,0,18"/>

                            <!-- Button list: StackPanel, gap 10px -->
                            <StackPanel>
                                <!-- 1. Ultimate Win 11 Debloat (Hero Button, High Contrast) -->
                                <Button x:Name="BtnUltimateDebloat"
                                        Style="{StaticResource CleanupPrimaryButtonStyle}"
                                        Click="BtnUltimateDebloat_Click"
                                        Margin="0,0,0,10"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnUltimateDebloat" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Glowing Icon Squircle -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#33000000" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M7 2v11h3v9l7-12h-4l4-8z" Fill="#FFFFFF">
                                                    <Path.Effect>
                                                        <DropShadowEffect Color="#FFFFFF" BlurRadius="6" Opacity="0.8" ShadowDepth="0"/>
                                                    </Path.Effect>
                                                </Path>
                                            </Viewbox>
                                        </Border>

                                        <!-- Title + Subtitle in Pure High-Contrast White -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Ultimate Win 11 Debloat" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}">
                                                <TextBlock.Effect>
                                                    <DropShadowEffect Color="#000000" BlurRadius="4" Opacity="0.4" ShadowDepth="1"/>
                                                </TextBlock.Effect>
                                            </TextBlock>
                                            <TextBlock Text="Aggressive deep bloatware purge" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextSecondary}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Recommended Pill Badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Background="#2EFFFFFF"
                                                BorderBrush="#4DFFFFFF"
                                                BorderThickness="1"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="RECOMMENDED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        </Border>
                                    </Grid>
                                </Button>

                                <!-- 2. Service Debloater (Ruby Danger Accent) -->
                                <Button x:Name="BtnServiceDebloater"
                                        Style="{StaticResource CleanupDangerGhostButtonStyle}"
                                        Click="BtnServiceDebloater_Click"
                                        Opacity="0">
                                    <Button.RenderTransform>
                                        <TranslateTransform x:Name="TransBtnServiceDebloater" Y="10"/>
                                    </Button.RenderTransform>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Danger icon container -->
                                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="10" Background="#26FF4D6D" BorderBrush="{DynamicResource DangerBorder}" BorderThickness="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                            <Viewbox Width="18" Height="18" VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Path Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58c.18-.14.23-.41.12-.61l-1.92-3.32c-.12-.22-.37-.29-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54c-.04-.24-.24-.41-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58c-.18.14-.23.41-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6c-1.98 0-3.6-1.62-3.6-3.6s1.62-3.6 3.6-3.6 3.6 1.62 3.6 3.6-1.62 3.6-3.6 3.6z"
                                                      Fill="{DynamicResource DangerRed}"/>
                                            </Viewbox>
                                        </Border>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="Service Debloater" FontSize="13" FontWeight="Bold" Foreground="#FF6B8B"/>
                                            <TextBlock Text="Disable background tracking services" FontSize="11" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                        </StackPanel>

                                        <!-- Advanced Pill Badge -->
                                        <Border Grid.Column="2"
                                                CornerRadius="6"
                                                Background="#1FFF4D6D"
                                                BorderBrush="{DynamicResource DangerBorder}"
                                                BorderThickness="1"
                                                Padding="6,2"
                                                VerticalAlignment="Center">
                                            <TextBlock Text="ADVANCED" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource DangerRed}"/>
                                        </Border>
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══════════════════════════════════════════════════════════
                 PRO TIP CARD (Redesigned Modern Glass Advisory)
                 ══════════════════════════════════════════════════════════ -->
            <Border x:Name="CardProTip"
                    Grid.Row="3"
                    Margin="0,24,0,0"
                    CornerRadius="14"
                    Background="{DynamicResource Surface1}"
                    BorderBrush="#4DFFB703"
                    BorderThickness="1"
                    SnapsToDevicePixels="True"
                    Opacity="0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TransCardProTip" Y="16"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="#FFB703" BlurRadius="24" Opacity="0.22" ShadowDepth="2"/>
                </Border.Effect>
                <Grid Margin="18,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/> <!-- Left Amber Vertical Stripe -->
                        <ColumnDefinition Width="Auto"/> <!-- Lightbulb Icon Badge -->
                        <ColumnDefinition Width="*"/>    <!-- Text Content -->
                    </Grid.ColumnDefinitions>

                    <!-- Left: 4px golden amber accent strip with rounded ends -->
                    <Border Grid.Column="0" Width="4" Height="48" CornerRadius="2" Margin="0,0,16,0" VerticalAlignment="Center">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#FFB703" Offset="0"/>
                                <GradientStop Color="#FB8500" Offset="1"/>
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Center-Left: Glowing Lightbulb Icon Container -->
                    <Border Grid.Column="1" Width="42" Height="42" CornerRadius="12" Background="#26FFB703" BorderBrush="#59FFB703" BorderThickness="1" Margin="0,0,18,0" VerticalAlignment="Center">
                        <Viewbox Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Path Data="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm2.85 11.1l-.85.6V16h-4v-2.3l-.85-.6C7.8 12.16 7 10.63 7 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.63-.8 3.16-2.15 4.1z"
                                  Fill="{DynamicResource WarningAmber}">
                                <Path.Effect>
                                    <DropShadowEffect Color="#FFB703" BlurRadius="8" Opacity="0.8" ShadowDepth="0"/>
                                </Path.Effect>
                            </Path>
                        </Viewbox>
                    </Border>

                    <!-- Right text -->
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="💡 PRO TIP · OPTIMIZATION BEST PRACTICES"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource WarningAmber}"/>
                        <TextBlock Text="Running these cleanups once a week will ensure your SSD maintains peak read/write speeds and your system stays responsive!"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>

                        <!-- Safety Callout Pill -->
                        <Border Margin="0,8,0,0"
                                HorizontalAlignment="Left"
                                CornerRadius="8"
                                Background="{DynamicResource AccentTint}"
                                BorderBrush="#3300E5FF"
                                BorderThickness="1"
                                Padding="10,5">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="🛡 Safety Guarantee:"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentCyan}"
                                           Margin="0,0,6,0"/>
                                <TextBlock Text="The 'Ultimate Win 11 Debloat' tool will prompt you to create a Restore Point before running, to ensure safety."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
