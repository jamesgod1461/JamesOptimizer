<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ========================================================================= -->
    <!-- JAMESOPTIMIZER V3 — NEUTRAL CHROME + NEON DATA DESIGN TOKENS              -->
    <!-- ========================================================================= -->

    <!-- Runtime Effects Flag (auto-managed by ThemeEffects) -->
    <x:Boolean x:Key="Theme.EffectsEnabled">True</x:Boolean>

    <!-- Typography Families (Bundled SIL OFL Fonts) -->
    <FontFamily x:Key="Font.Sans">ms-appx:///Assets/Fonts/PlusJakartaSans.ttf#Plus Jakarta Sans, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Display">ms-appx:///Assets/Fonts/SpaceGrotesk.ttf#Space Grotesk, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="Font.Mono">ms-appx:///Assets/Fonts/JetBrainsMono.ttf#JetBrains Mono, Cascadia Mono, Consolas, monospace</FontFamily>
    <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- Type Scale -->
    <x:Double x:Key="FontSize.Display">48</x:Double>
    <x:Double x:Key="FontSize.Title">26</x:Double>
    <x:Double x:Key="FontSize.Body">14</x:Double>
    <x:Double x:Key="FontSize.Caption">12</x:Double>
    <x:Double x:Key="FontSize.Label">11</x:Double>

    <!-- Shape / Corner Radius -->
    <CornerRadius x:Key="Radius.Sm">8</CornerRadius>
    <CornerRadius x:Key="Radius.Md">12</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">16</CornerRadius>
    <CornerRadius x:Key="Radius.Bar">2</CornerRadius>

    <!-- Spacing Scale: 4 / 8 / 12 / 16 / 24 / 32 -->
    <x:Double x:Key="Space.1">4</x:Double>
    <x:Double x:Key="Space.2">8</x:Double>
    <x:Double x:Key="Space.3">12</x:Double>
    <x:Double x:Key="Space.4">16</x:Double>
    <x:Double x:Key="Space.5">24</x:Double>
    <x:Double x:Key="Space.6">32</x:Double>

    <Thickness x:Key="Card.Padding">20</Thickness>
    <Thickness x:Key="Card.PaddingLg">24</Thickness>
    <Thickness x:Key="Page.Padding">28,24,28,32</Thickness>
    <Thickness x:Key="Focus.BorderThickness">2</Thickness>

    <!-- Shadow & Spring Motion Constants -->
    <x:Double x:Key="Shadow.Contact.Idle.OffsetY">2</x:Double>
    <x:Double x:Key="Shadow.Contact.Idle.Blur">4</x:Double>
    <x:Double x:Key="Shadow.Contact.Idle.Opacity">0.60</x:Double>
    <x:Double x:Key="Shadow.Contact.Hover.OffsetY">4</x:Double>
    <x:Double x:Key="Shadow.Contact.Hover.Blur">8</x:Double>
    <x:Double x:Key="Shadow.Contact.Pressed.OffsetY">1</x:Double>
    <x:Double x:Key="Shadow.Contact.Pressed.Blur">2</x:Double>

    <x:Double x:Key="Shadow.Ambient.Idle.OffsetY">8</x:Double>
    <x:Double x:Key="Shadow.Ambient.Idle.Blur">18</x:Double>
    <x:Double x:Key="Shadow.Ambient.Idle.Opacity">0.45</x:Double>
    <x:Double x:Key="Shadow.Ambient.Hover.OffsetY">14</x:Double>
    <x:Double x:Key="Shadow.Ambient.Hover.Blur">28</x:Double>
    <x:Double x:Key="Shadow.Ambient.Pressed.OffsetY">2</x:Double>
    <x:Double x:Key="Shadow.Ambient.Pressed.Blur">4</x:Double>

    <x:Double x:Key="Spring.DampingRatio">0.50</x:Double>
    <x:Double x:Key="Spring.PeriodMs">50</x:Double>
    <x:Double x:Key="Spring.HoverScale">1.04</x:Double>
    <x:Double x:Key="Spring.HoverLiftY">-2</x:Double>
    <x:Double x:Key="Spring.PressScaleX">0.96</x:Double>
    <x:Double x:Key="Spring.PressScaleY">0.97</x:Double>
    <x:Double x:Key="Spring.PressContentOffsetY">1</x:Double>

