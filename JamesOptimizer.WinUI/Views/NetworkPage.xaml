<Page
    x:Class="JamesOptimizer.WinUI.Views.NetworkPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,32">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="NETWORK BOOST &amp; DNS" FontFamily="{StaticResource DisplayFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Purge stale DNS resolvers, minimize latency, reset network stacks, and switch high-speed DNS." FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Button x:Name="BtnTestLatency" Grid.Column="1" Click="BtnTestLatency_Click" Style="{StaticResource ModernPrimaryButtonStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                        <TextBlock Text="PING TEST" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Ping Results Cards -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Cloudflare Ping -->
                <Border Grid.Column="0" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Cloudflare DNS (1.1.1.1)" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="TxtCloudflarePing" Text="--" FontSize="32" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="ms" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#1A00F5FF" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Google Ping -->
                <Border Grid.Column="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="Google DNS (8.8.8.8)" FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock x:Name="TxtGooglePing" Text="--" FontSize="32" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                                <TextBlock Text="ms" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                        <Border Grid.Column="1" Width="44" Height="44" CornerRadius="12" Background="#1A00E676" VerticalAlignment="Center">
                            <TextBlock Text="🌐" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- Network Tools Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Flush DNS -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Flush DNS Cache" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Text="Clears Windows client DNS cache, resolving address resolution deadlocks and website reachability problems." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <Button Grid.Row="2" Click="BtnFlushDns_Click" Style="{StaticResource ModernPrimaryButtonStyle}" HorizontalAlignment="Stretch" Content="Flush DNS Cache"/>
                    </Grid>
                </Border>

                <!-- Reset TCP/IP Stack -->
                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Reset TCP/IP &amp; Winsock" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Text="Rewrites corrupted Windows networking sockets and resets routing interfaces to clean factory defaults." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <Button Grid.Row="2" Click="BtnResetNetwork_Click" Style="{StaticResource ModernGhostButtonStyle}" HorizontalAlignment="Stretch" Content="Reset Network Stack"/>
                    </Grid>
                </Border>

                <!-- DNS Switcher -->
                <Border Grid.Row="2" Grid.ColumnSpan="3" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="4">
                            <TextBlock Text="High-Performance DNS Switcher" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Switch active network adapters to low-latency, privacy-first Anycast DNS servers." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Click="BtnSetDns_Click" Tag="Cloudflare" Style="{StaticResource ModernGhostButtonStyle}" Content="Cloudflare (1.1.1.1)"/>
                            <Button Click="BtnSetDns_Click" Tag="Google" Style="{StaticResource ModernGhostButtonStyle}" Content="Google (8.8.8.8)"/>
                            <Button Click="BtnSetDns_Click" Tag="Quad9" Style="{StaticResource ModernGhostButtonStyle}" Content="Quad9 (9.9.9.9)"/>
                            <Button Click="BtnSetDns_Click" Tag="DHCP" Style="{StaticResource ModernGhostButtonStyle}" Content="Automatic (DHCP)"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
