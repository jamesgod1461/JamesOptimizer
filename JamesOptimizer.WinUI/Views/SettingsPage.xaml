<Page
    x:Class="JamesOptimizer.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,32">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="SETTINGS &amp; ABOUT" FontFamily="{StaticResource DisplayFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Background automation, autostart, window styling, and developer info." FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Card 1: Background Service & Automation -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="⚡" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Background Optimization Service" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Service Status Row -->
                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Windows Service Status" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtServiceStatus" Text="Detecting \\.\pipe\JamesOptimizerPipe..." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button x:Name="BtnPingService" Grid.Column="1" Click="BtnPingService_Click" Style="{StaticResource ModernGhostButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Ping Service" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!-- Auto-Run Interval -->
                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Scheduled Auto-Optimization Interval" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Automatically clean temp memory, flush standby caches, and optimize latency." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboAutoTimer" Grid.Column="1" SelectionChanged="ComboAutoTimer_SelectionChanged" Width="180" VerticalAlignment="Center">
                                <ComboBoxItem Content="Disabled (Manual Only)" Tag="0"/>
                                <ComboBoxItem Content="Every 15 Minutes" Tag="15"/>
                                <ComboBoxItem Content="Every 30 Minutes" Tag="30"/>
                                <ComboBoxItem Content="Every 1 Hour" Tag="60"/>
                                <ComboBoxItem Content="Every 2 Hours" Tag="120"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Run at Windows Startup -->
                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Launch on Windows Startup" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Automatically launch James Optimizer in the background when signing into Windows." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToggleStartup" Grid.Column="1" Toggled="ToggleStartup_Toggled" OnContent="Enabled" OffContent="Disabled" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: Appearance & Window Aesthetics -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🎨" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Appearance &amp; Window Material" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Theme Mode -->
                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Application Theme" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Cyber Dark (recommended for OLED) or Clean Light mode." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboTheme" Grid.Column="1" SelectionChanged="ComboTheme_SelectionChanged" Width="180" VerticalAlignment="Center">
                                <ComboBoxItem Content="Dark (Cyber)" Tag="Dark"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Windows Default" Tag="Default"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Zero Telemetry Assurance -->
                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="100% Local &amp; Private" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="No remote telemetry, tracking, or cloud surveillance. Everything executes on your device." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Border Grid.Column="1" Background="#1A00F5FF" BorderBrush="#4D00F5FF" BorderThickness="1" CornerRadius="8" Padding="12,6" VerticalAlignment="Center">
                                <TextBlock Text="✓ SECURE &amp; LOCAL" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2.5: Network Diagnostics & Latency Tester -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="16">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="🌐" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Network Latency &amp; DNS Benchmark" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Text="Cloudflare DNS (1.1.1.1) Ping" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock x:Name="TxtPingResult" Text="Click 'Test Latency' to measure round-trip socket latency." FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                            <Button x:Name="BtnTestPing" Grid.Column="1" Click="BtnTestPing_Click" Style="{StaticResource ModernGhostButtonStyle}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFontFamily}" FontSize="12" VerticalAlignment="Center"/>
                                    <TextBlock Text="Test Latency" FontSize="11" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 3: Developer Info & Suite Credentials -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="20">
                <StackPanel Spacing="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="56" Height="56" CornerRadius="14" Background="#1A00F5FF" BorderBrush="#4D00F5FF" BorderThickness="1" Margin="0,0,16,0" VerticalAlignment="Center">
                            <Image Source="ms-appx:///Assets/logo-128.png" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="JAMES OPTIMIZER" FontFamily="{StaticResource DisplayFontFamily}" FontSize="18" FontWeight="Black" Foreground="{StaticResource TextPrimaryBrush}"/>
                                <Border Background="#1A00F5FF" BorderBrush="#4D00F5FF" BorderThickness="1" CornerRadius="6" Padding="6,2">
                                    <TextBlock Text="WINUI 3 · PRO v3.2" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="Lead Engineer: " FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                <TextBlock Text="James God" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource AccentCyanBrush}"/>
                                <TextBlock Text="· WinUI 3 Native Desktop" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="&quot;Dedicated to building the absolute fastest and most reliable Windows tweaking utility for gamers and power users.&quot;" FontSize="12" FontStyle="Italic" Foreground="{StaticResource TextMutedBrush}"/>

                    <Border Height="1" Background="{StaticResource BorderSubtleBrush}"/>

                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="BtnOpenGithub_Click" Style="{StaticResource ModernGhostButtonStyle}">
                            <TextBlock Text="GitHub Repository" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Click="BtnReportIssue_Click" Style="{StaticResource ModernGhostButtonStyle}">
                            <TextBlock Text="Report an Issue" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                        <Button Click="BtnOpenDiscord_Click" Style="{StaticResource ModernGhostButtonStyle}">
                            <TextBlock Text="Discord Community" FontSize="12" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>

                    <TextBlock Text="© 2025 James God — All Rights Reserved · Built with Windows App SDK &amp; WinUI 3" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
