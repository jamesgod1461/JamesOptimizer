<Page
    x:Class="JamesOptimizer.WinUI.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="{StaticResource Page.Padding}">
            <!-- Header -->
            <StackPanel Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource Font.Icon}" FontSize="22" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center"/>
                    <TextBlock Text="SETTINGS, PROFILES &amp; SMART RAM" Style="{StaticResource Type.Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <TextBlock Text="Service automation, threshold-based standby RAM purger, JSON profile export/import, panic revert, and release settings." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
            </StackPanel>

            <!-- Card 1: Background Service & Smart Standby RAM Purger -->
            <Border x:Name="CardService" Style="{StaticResource CardPanelStyle}" Padding="{StaticResource Card.Padding}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE945;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Accent.Cyan}" VerticalAlignment="Center"/>
                        <TextBlock Text="Background Service &amp; Smart Standby RAM Purger" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Windows Service Status &amp; Version Handshake" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                                <TextBlock x:Name="TxtServiceStatus" Text="Detecting \\.\pipe\JamesOptimizerPipe..." Style="{StaticResource Type.Label}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <Button x:Name="BtnPingService" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnPingService_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="Ping &amp; Handshake"/>
                        </Grid>
                    </Border>

                    <!-- Smart Threshold Standby RAM Purger -->
                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <StackPanel Spacing="12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Threshold-Based Smart Standby RAM Purger [ADMIN]" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="TxtMemoryBreakdown" Text="Standby list is normally beneficial; purges only when Free RAM drops below threshold." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                                </StackPanel>
                                <ToggleSwitch x:Name="ToggleSmartRam" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="SmartRam_Changed" OnContent="Enabled" OffContent="Off"/>
                            </Grid>
                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Purge when Free &lt;" VerticalAlignment="Center" Style="{StaticResource Type.Caption}"/>
                                <ComboBox x:Name="ComboSmartRamThreshold" Grid.Column="1" SelectionChanged="SmartRam_Changed" SelectedIndex="1" Width="170">
                                    <ComboBoxItem Content="1024 MB (1 GB)" Tag="1024"/>
                                    <ComboBoxItem Content="2048 MB (2 GB)" Tag="2048"/>
                                    <ComboBoxItem Content="4096 MB (4 GB)" Tag="4096"/>
                                </ComboBox>
                                <CheckBox x:Name="ChkPauseFullscreen" Grid.Column="2" Content="Pause while fullscreen game/app is active" IsChecked="True" Checked="SmartRam_Changed" Unchecked="SmartRam_Changed" VerticalAlignment="Center"/>
                                <Button Grid.Column="3" Click="BtnSaveSmartRam_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="Apply to Service"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Scheduled Auto-Optimization Interval (Temp &amp; RAM)" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Prefetch is preserved during scheduled runs to protect application launch speeds." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboAutoTimer" Grid.Column="1" HorizontalAlignment="Right" SelectionChanged="ComboAutoTimer_SelectionChanged" Width="190" VerticalAlignment="Center">
                                <ComboBoxItem Content="Disabled (Manual Only)" Tag="0"/>
                                <ComboBoxItem Content="Every 15 Minutes" Tag="15"/>
                                <ComboBoxItem Content="Every 30 Minutes" Tag="30"/>
                                <ComboBoxItem Content="Every 1 Hour" Tag="60"/>
                                <ComboBoxItem Content="Every 2 Hours" Tag="120"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Launch on Windows Startup" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Start JamesOptimizer quietly in the tray on Windows sign-in." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ToggleSwitch x:Name="ToggleStartup" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Toggled="ToggleStartup_Toggled" OnContent="Enabled" OffContent="Disabled"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 2: JSON Profile Export / Import & Panic Revert -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="{StaticResource Card.Padding}">
                <StackPanel Spacing="12">
                    <TextBlock Text="JSON Profile Provisioning &amp; Panic Revert" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}"/>
                    <TextBlock x:Name="TxtProfileStatus" Text="Export active catalog tweaks to signed v2 JSON (DPAPI-protected HMAC-SHA256) or preview before importing. Safe-Mode CLI: JamesOptimizer.WinUI.exe --revert-all" Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>

                    <Border x:Name="ProfileTrustBanner" Visibility="Collapsed" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12,8">
                        <StackPanel Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border x:Name="BadgeProfileTrust" Style="{StaticResource Badge.Sm}">
                                    <TextBlock x:Name="TxtProfileTrustBadge" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock x:Name="TxtProfileTrustSummary" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </StackPanel>
                            <CheckBox x:Name="ChkConfirmUnverifiedProfile" Visibility="Collapsed" Content="I reviewed this profile and confirm applying unverified or legacy settings." IsChecked="False"/>
                        </StackPanel>
                    </Border>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtProfilePath" Grid.Column="0" Style="{StaticResource ModernSearchBoxStyle}" PlaceholderText="Path to profile JSON (defaults to Desktop on Export)"/>
                        <Button Grid.Column="1" Click="BtnExportProfile_Click" Style="{StaticResource ModernPrimaryButtonStyle}" Content="Export Profile"/>
                        <Button Grid.Column="2" Click="BtnPreviewImportProfile_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="Dry-Run Import"/>
                        <Button Grid.Column="3" Click="BtnApplyImportProfile_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="Apply Import"/>
                        <Button Grid.Column="4" Click="BtnPanicRevert_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="PANIC REVERT ALL"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card 3: Appearance & Release Preferences -->
            <Border x:Name="CardAppearance" Style="{StaticResource CardPanelStyle}" Padding="{StaticResource Card.Padding}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Appearance, Updates &amp; Privacy" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}"/>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Application Theme" Style="{StaticResource Type.Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ComboTheme" Grid.Column="1" HorizontalAlignment="Right" SelectionChanged="ComboTheme_SelectionChanged" Width="200">
                                <ComboBoxItem Content="Dark (Neutral Chrome)" Tag="Dark"/>
                                <ComboBoxItem Content="Light" Tag="Light"/>
                                <ComboBoxItem Content="Windows Default" Tag="Default"/>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reduce Animations &amp; Glow Effects" Style="{StaticResource Type.Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="ToggleReduceAnimations" Grid.Column="1" HorizontalAlignment="Right" Toggled="ToggleReduceAnimations_Toggled" OnContent="Reduced" OffContent="Enabled (30fps)"/>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Minimize to System Tray on Close" Style="{StaticResource Type.Body}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <ToggleSwitch x:Name="ToggleMinimizeToTray" Grid.Column="1" HorizontalAlignment="Right" Toggled="ToggleMinimizeToTray_Toggled" OnContent="Enabled" OffContent="Exit App"/>
                        </Grid>
                    </Border>

                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="16,12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                                <TextBlock Text="Opt-In Update Checks (Zero Telemetry by Default)" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                                <TextBlock Text="Disabled by default per goal.md. When enabled, checks signed GitHub release manifest over HTTPS." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox x:Name="ComboReleaseChannel" Grid.Column="1" SelectedIndex="0" Width="120" VerticalAlignment="Center" SelectionChanged="UpdatePrefs_Changed">
                                <ComboBoxItem Content="Stable" Tag="Stable"/>
                                <ComboBoxItem Content="Beta" Tag="Beta"/>
                            </ComboBox>
                            <ToggleSwitch x:Name="ToggleOptInUpdates" Grid.Column="2" VerticalAlignment="Center" Toggled="UpdatePrefs_Changed" OnContent="Opted In" OffContent="Off"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Card 4: Network Quick Ping & About / Acknowledgements -->
            <Border x:Name="CardNetworkBench" Style="{StaticResource CardPanelStyle}" Padding="{StaticResource Card.Padding}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="Cloudflare DNS (1.1.1.1) Quick Ping" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtPingResult" Text="Click 'Test Latency' to measure round-trip socket latency." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button x:Name="BtnTestPing" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Click="BtnTestPing_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="Test Latency"/>
                </Grid>
            </Border>

            <Border x:Name="CardAbout" Style="{StaticResource CardPanelStyle}" Padding="{StaticResource Card.Padding}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="JAMESOPTIMIZER V3" FontFamily="{StaticResource Font.Display}" FontSize="18" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}"/>
                        <Border Style="{StaticResource Badge.Sm}">
                            <TextBlock Text="WINUI 3 · JAMES GOD" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource Accent.Cyan}"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="Built on .NET 10, WinUI 3, Win2D, and a hardened Windows Worker Service. Acknowledgements: inspired in part by classic post-install utilities such as hellzerg/optimizer, re-implemented natively with full Apply -&gt; Revert snapshots." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Click="BtnOpenGithub_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="GitHub Repository"/>
                        <Button Click="BtnReportIssue_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="Report an Issue"/>
                        <Button Click="BtnOpenDiscussions_Click" Style="{StaticResource ModernGhostButtonStyle}" Content="GitHub Discussions"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
