<Page
    x:Class="JamesOptimizer.WinUI.Views.GamingModePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,32">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="PRO GAMING MODE" FontFamily="{StaticResource DisplayFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Hardware-accelerated ultra-low latency tuning for esports and competitive gaming." FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Border Grid.Column="1" Background="#1A00E676" BorderBrush="#3300E676" BorderThickness="1" CornerRadius="20" Padding="14,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStatus" Text="STANDBY READY" FontSize="11" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Hero Turbo Card -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="16" Padding="24">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Spacing="8" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="⚡" FontSize="20" VerticalAlignment="Center"/>
                            <TextBlock Text="GAME TURBO ENGINE" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1F00E5FF" BorderBrush="#4D00E5FF" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                <TextBlock Text="0.5ms TIMER RES" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtTurboStatus" Text="Click below to engage extreme thread priority, purge RAM standby lists, and lock CPU clocks." FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" MaxWidth="600" TextWrapping="Wrap"/>
                    </StackPanel>

                    <Button x:Name="BtnActivateTurbo" Grid.Column="1" Click="BtnActivateTurbo_Click" Style="{StaticResource ModernPrimaryButtonStyle}" Height="46" Padding="24,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtTurboBtn" Text="ACTIVATE GAME TURBO ⚡" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- 2x2 Feature Grid -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 1. GPU Scheduling -->
                <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="{StaticResource AccentCyanBrush}"/>
                            <TextBlock Text="Hardware GPU Scheduling (HAGS)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Offloads high-frequency graphics frame scheduling directly to GPU VRAM for reduced render lag." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16"/>
                        <Button Grid.Row="2" Click="BtnGpuOptimize_Click" Style="{StaticResource ModernGhostButtonStyle}" HorizontalAlignment="Stretch" Content="Optimize GPU Pipeline"/>
                    </Grid>
                </Border>

                <!-- 2. Packet Latency -->
                <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE839;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="{StaticResource AccentVioletBrush}"/>
                            <TextBlock Text="Zero Packet Delay (Disable Nagle)" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Forces immediate delivery of gaming network packets without waiting for packet coalescing buffers." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16"/>
                        <Button Grid.Row="2" Click="BtnNetworkLatency_Click" Style="{StaticResource ModernGhostButtonStyle}" HorizontalAlignment="Stretch" Content="Minimize Packet Jitter"/>
                    </Grid>
                </Border>

                <!-- 3. Disable DVR -->
                <Border Grid.Row="2" Grid.Column="0" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE714;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="{StaticResource WarningAmberBrush}"/>
                            <TextBlock Text="Disable Game DVR &amp; Bar" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Terminates background recording telemetry, preventing frame drops in competitive FPS titles." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16"/>
                        <Button Grid.Row="2" Click="BtnDisableDvr_Click" Style="{StaticResource ModernGhostButtonStyle}" HorizontalAlignment="Stretch" Content="Disable Game DVR"/>
                    </Grid>
                </Border>

                <!-- 4. Mouse Precision -->
                <Border Grid.Row="2" Grid.Column="2" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="&#xE962;" FontFamily="{StaticResource IconFontFamily}" FontSize="18" Foreground="{StaticResource SuccessGreenBrush}"/>
                            <TextBlock Text="1:1 Raw Mouse Precision" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="Disables Windows Enhanced Pointer Precision (mouse acceleration) for true 1:1 muscle memory aim." FontSize="12" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,16"/>
                        <Button Grid.Row="2" Click="BtnMousePrecision_Click" Style="{StaticResource ModernGhostButtonStyle}" HorizontalAlignment="Stretch" Content="Set 1:1 Raw Mouse Aim"/>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
