<Page
    x:Class="JamesOptimizer.WinUI.Views.CleanupsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,32">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="SYSTEM CLEANUPS" FontFamily="{StaticResource DisplayFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Deep sweep temporary junk, OS caches, delivery logs, and browser clutter." FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BtnScanAll" Click="BtnScanAll_Click" Style="{StaticResource ModernGhostButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="SCAN ALL" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCleanAll" Click="BtnCleanAll_Click" Style="{StaticResource ModernPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="CLEAN SELECTED" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Hero Summary Card -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="14" Padding="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="56" Height="56" CornerRadius="14" Background="#1A00F5FF" BorderBrush="#3300F5FF" BorderThickness="1" Margin="0,0,20,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="26" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock x:Name="TxtTotalReclaimable" Text="Calculating..." FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}"/>
                            <Border Background="#1A00E676" CornerRadius="6" Padding="8,2" VerticalAlignment="Center">
                                <TextBlock Text="RECLAIMABLE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource SuccessGreenBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="TxtScanStatus" Text="Ready to scan system directories and caches." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <ProgressBar x:Name="ScanProgressBar" Visibility="Collapsed" Height="4" Margin="0,8,40,0" IsIndeterminate="True" Foreground="{StaticResource AccentCyanBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <CheckBox x:Name="ChkSelectAll" Content="Select All" IsChecked="True" Checked="ChkSelectAll_Checked" Unchecked="ChkSelectAll_Unchecked" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Cleanup Categories ItemsControl -->
            <ItemsControl x:Name="CleanupCategoriesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,14,0"/>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                                </StackPanel>

                                <Border Grid.Column="2" Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplaySize}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>

                                <Button Grid.Column="3" Click="BtnCleanSingle_Click" Tag="{Binding Id}" Style="{StaticResource ModernGhostButtonStyle}" Height="32" Padding="12,0" VerticalAlignment="Center">
                                    <TextBlock Text="Clean" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
