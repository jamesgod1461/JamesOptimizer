<Page
    x:Class="JamesOptimizer.WinUI.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="28,24,28,32">
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFontFamily}" FontSize="24" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="WINDOWS SERVICES MANAGER" FontFamily="{StaticResource DisplayFontFamily}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Inspect Windows background services, kill telemetry bloat, and manage startup types." FontSize="13" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BtnDisableTelemetryServices" Click="BtnDisableTelemetryServices_Click" Style="{StaticResource ModernPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE730;" FontFamily="{StaticResource IconFontFamily}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="DISABLE TELEMETRY SERVICES" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Style="{StaticResource ModernGhostButtonStyle}">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFontFamily}" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filters Bar -->
            <Border Background="{StaticResource Surface1Brush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="14,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <RadioButton x:Name="FilterAll" Content="All Services" IsChecked="True" Checked="Filter_Checked" Tag="ALL" Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="FilterTelemetry" Content="Telemetry &amp; Bloat" Checked="Filter_Checked" Tag="TELEMETRY" Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="FilterRunning" Content="Running" Checked="Filter_Checked" Tag="RUNNING" Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="FilterStopped" Content="Stopped" Checked="Filter_Checked" Tag="STOPPED" Style="{StaticResource ModernRadioButtonStyle}"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtCountStatus" Grid.Column="2" Text="Loading services..." FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Services List -->
            <ItemsControl x:Name="ServicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="8" Background="#181D2A" BorderBrush="#283247" BorderThickness="1" Margin="0,0,14,0" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource AccentCyanBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding ServiceName}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PathName}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="500"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2" CornerRadius="6" Padding="10,4" Margin="14,0" VerticalAlignment="Center" Background="#1A00F5FF">
                                    <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}"/>
                                </Border>

                                <!-- Start/Stop Button -->
                                <Button Grid.Column="3" Click="BtnToggleService_Click" Tag="{Binding}" Style="{StaticResource ModernGhostButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActionButtonText}" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
