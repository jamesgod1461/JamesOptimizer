<Page
    x:Class="JamesOptimizer.WinUI.Views.ServicesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="{StaticResource Page.Padding}">
            <!-- Header -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Font.Icon}" FontSize="22" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center"/>
                        <TextBlock Text="WINDOWS SERVICES MANAGER" Style="{StaticResource Type.Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Text="Inspect Windows background services, kill telemetry bloat, and manage startup types." Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button x:Name="BtnDisableTelemetryServices" Click="BtnDisableTelemetryServices_Click" Style="{StaticResource ModernPrimaryButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="&#xE730;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="DISABLE TELEMETRY SERVICES" FontFamily="{StaticResource Font.Mono}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Style="{StaticResource IconRaisedButtonStyle}" Width="36" Height="36">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icon}" FontSize="14"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Filters Bar -->
            <Border Style="{StaticResource CardPanelStyle}" Padding="16,12">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" Spacing="14">
                        <RadioButton x:Name="FilterAll" Content="All Services" IsChecked="True" Checked="Filter_Checked" Tag="ALL" Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="FilterTelemetry" Content="Telemetry &amp; Bloat" Checked="Filter_Checked" Tag="TELEMETRY" Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="FilterRunning" Content="Running" Checked="Filter_Checked" Tag="RUNNING" Style="{StaticResource ModernRadioButtonStyle}"/>
                        <RadioButton x:Name="FilterStopped" Content="Stopped" Checked="Filter_Checked" Tag="STOPPED" Style="{StaticResource ModernRadioButtonStyle}"/>
                    </StackPanel>

                    <TextBlock x:Name="TxtCountStatus" Grid.Column="2" Text="Loading services..." Style="{StaticResource Type.Label}" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Services List -->
            <ItemsControl x:Name="ServicesList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardPanelStyle}" Padding="{StaticResource Card.Padding}" Margin="0,0,0,12">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="{StaticResource Radius.Sm}" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE90F;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Accent.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Type.Body}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding ServiceName}" Style="{StaticResource Type.Label}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding PathName}" Style="{StaticResource Type.Caption}" Foreground="{ThemeResource Text.Secondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- Status Badge -->
                                <Border Grid.Column="2" Style="{StaticResource Badge.Sm}" Padding="10,4">
                                    <TextBlock Text="{Binding Status}" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource Accent.Cyan}"/>
                                </Border>

                                <!-- Start/Stop Button -->
                                <Button Grid.Column="3" Click="BtnToggleService_Click" Tag="{Binding}" Style="{StaticResource ModernGhostButtonStyle}" Height="32" Padding="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ActionButtonText}" FontSize="12" FontWeight="SemiBold"/>
                                </Button>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>
