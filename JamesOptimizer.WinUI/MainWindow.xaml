<Window
    x:Class="JamesOptimizer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:JamesOptimizer.WinUI"
    mc:Ignorable="d"
    Title="JamesOptimizer V3">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid x:Name="RootShellGrid" Background="{ThemeResource Bg.App}">
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OpenCommandPalette_Invoked" />
            <KeyboardAccelerator Modifiers="Control" Key="L" Invoked="OpenAuditDrawer_Invoked" />
        </Grid.KeyboardAccelerators>

        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ========================================================================= -->
        <!-- CUSTOM TITLE BAR (NEUTRAL CHROME)                                         -->
        <!-- ========================================================================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource Bg.Sidebar}" VerticalAlignment="Stretch"
              BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="0,0,0,1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="144" />
            </Grid.ColumnDefinitions>

            <!-- Drag region -->
            <Border x:Name="TitleBarDragArea" Grid.ColumnSpan="3" Background="Transparent" IsHitTestVisible="True" />

            <!-- Left: Brand Emblem + JAMES OPTIMIZER V3 -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0" Spacing="12" IsHitTestVisible="False">
                <Border Width="28" Height="28" CornerRadius="{StaticResource Radius.Sm}" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1">
                    <Image Source="ms-appx:///Assets/logo-128.png" Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="JAMES" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="Bold" CharacterSpacing="40" Foreground="{ThemeResource Text.Primary}" VerticalAlignment="Center" />
                    <TextBlock Text="OPTIMIZER" FontFamily="{StaticResource Font.Display}" FontSize="15" FontWeight="Medium" CharacterSpacing="40" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                    <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="8,2" Margin="4,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="V3" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{ThemeResource Text.Secondary}" />
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Center: Windows OS Status Pill + Quick Actions Ctrl+K Trigger -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                <!-- Windows OS & System Ready Pill -->
                <Border Background="{ThemeResource Bg.Surface}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="12,5" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Path Data="M0,0 H5.5 V5.5 H0 Z M7,0 H12.5 V5.5 H7 Z M0,7 H5.5 V12.5 H0 Z M7,7 H12.5 V12.5 H7 Z"
                              Fill="{ThemeResource Text.Secondary}" Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="TxtOsVersion" Text="Windows 11 · 64-bit" FontFamily="{StaticResource Font.Sans}" FontSize="12" FontWeight="Medium" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                        <Rectangle Width="1" Height="10" Fill="{ThemeResource Border.Subtle}" VerticalAlignment="Center" />
                        <Ellipse x:Name="StatusPulseDot" Width="6" Height="6" Fill="{ThemeResource State.Good}" VerticalAlignment="Center" />
                        <TextBlock Text="READY" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold" CharacterSpacing="40" Foreground="{ThemeResource State.Good}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Quick Actions Ctrl+K Pill (Inset) -->
                <Button x:Name="TitleBarSearchBtn" Click="OpenCommandPalette_Click"
                        Style="{StaticResource InsetButtonStyle}"
                        AutomationProperties.Name="Quick Actions">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                        <TextBlock Text="Quick Actions..." FontFamily="{StaticResource Font.Sans}" FontSize="12" Foreground="{ThemeResource Text.Tertiary}" VerticalAlignment="Center" />
                        <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="6,1" VerticalAlignment="Center">
                            <TextBlock Text="Ctrl+K" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource Text.Secondary}" />
                        </Border>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MAIN WORKSPACE: SIDEBAR RAIL + PAGE FRAME                                 -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColDef" Width="58" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION RAIL -->
            <Border Grid.Column="0"
                    x:Name="SidebarContainer"
                    Background="{ThemeResource Bg.Sidebar}"
                    BorderBrush="{ThemeResource Border.Subtle}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Hamburger Collapse/Expand Button -->
                    <Button x:Name="ToggleSidebarBtn"
                            Click="ToggleSidebarBtn_Click"
                            Style="{StaticResource SidebarNavButtonStyle}"
                            Margin="8,10,8,6"
                            AutomationProperties.Name="Toggle Sidebar"
                            ToolTipService.ToolTip="Toggle Sidebar">
                        <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="&#xE700;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock x:Name="NavHeaderLabel" Text="NAVIGATION" Visibility="Collapsed" FontFamily="{StaticResource Font.Display}" FontSize="11" FontWeight="Bold" CharacterSpacing="90" Foreground="{ThemeResource Text.Tertiary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Nav Items -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <Grid x:Name="NavScrollGrid">
                            <!-- Left Accent.Cyan Active Indicator -->
                            <Border x:Name="SidebarActiveIndicator"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Width="3"
                                    Height="18"
                                    Margin="2,12,0,0"
                                    CornerRadius="{StaticResource Radius.Bar}"
                                    Background="{ThemeResource Accent.Cyan}"
                                    IsHitTestVisible="False" />

                            <StackPanel x:Name="NavItemsPanel" Spacing="4" Margin="8,2">
                                <!-- 1. Dashboard -->
                                <Button x:Name="NavDashboard" Click="NavButton_Click" Tag="Dashboard"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Dashboard"
                                        ToolTipService.ToolTip="Dashboard"
                                        Background="{ThemeResource Brush.Raised.Pressed}" BorderBrush="{ThemeResource Border.InnerPressedShadow}">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Accent.Cyan}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelDashboard" Text="Dashboard" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 2. System Cleanups -->
                                <Button x:Name="NavCleanups" Click="NavButton_Click" Tag="Cleanups"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="System Cleanups"
                                        ToolTipService.ToolTip="System Cleanups">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelClean" Text="System Cleanups" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 3. Performance Tweaks -->
                                <Button x:Name="NavPerformance" Click="NavButton_Click" Tag="Performance"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Performance Tweaks"
                                        ToolTipService.ToolTip="Performance Tweaks">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE950;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelPerf" Text="Performance Tweaks" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 4. Gaming Mode -->
                                <Button x:Name="NavGamingMode" Click="NavButton_Click" Tag="GamingMode"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Gaming Mode"
                                        ToolTipService.ToolTip="Gaming Mode">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelGame" Text="Gaming Mode" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 5. Startup Apps -->
                                <Button x:Name="NavStartup" Click="NavButton_Click" Tag="Startup"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Startup Apps"
                                        ToolTipService.ToolTip="Startup Apps">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelStartup" Text="Startup Apps" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 6. Services -->
                                <Button x:Name="NavServices" Click="NavButton_Click" Tag="Services"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Services"
                                        ToolTipService.ToolTip="Services">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelServices" Text="Services" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Category Separator -->
                                <Border Height="1" Background="{ThemeResource Border.Subtle}" Margin="8,8,8,8" />

                                <!-- 7. Network Boost -->
                                <Button x:Name="NavNetwork" Click="NavButton_Click" Tag="Network"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Network Boost"
                                        ToolTipService.ToolTip="Network Boost">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelNet" Text="Network Boost" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 8. Storage -->
                                <Button x:Name="NavStorage" Click="NavButton_Click" Tag="Storage"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Storage"
                                        ToolTipService.ToolTip="Storage">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelStorage" Text="Storage" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 9. Toolbox -->
                                <Button x:Name="NavToolbox" Click="NavButton_Click" Tag="Toolbox"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Toolbox"
                                        ToolTipService.ToolTip="Toolbox">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE825;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelToolbox" Text="Toolbox" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 10. Diagnostics -->
                                <Button x:Name="NavDiagnostics" Click="NavButton_Click" Tag="Diagnostics"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Diagnostics"
                                        ToolTipService.ToolTip="Diagnostics">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelDiag" Text="Diagnostics" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- 11. Settings -->
                                <Button x:Name="NavSettings" Click="NavButton_Click" Tag="Settings"
                                        Style="{StaticResource SidebarNavButtonStyle}"
                                        AutomationProperties.Name="Settings"
                                        ToolTipService.ToolTip="Settings">
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelSettings" Text="Settings" Visibility="Collapsed" FontFamily="{StaticResource Font.Sans}" FontSize="14" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- Bottom Emblem Badge -->
                    <Border Grid.Row="2"
                            Margin="8,8,8,12"
                            Height="44"
                            Padding="7,0"
                            Background="{ThemeResource Bg.Surface}"
                            BorderBrush="{ThemeResource Border.Subtle}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource Radius.Md}"
                            PointerPressed="UserCard_PointerPressed">
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Border Width="26" Height="26" CornerRadius="{StaticResource Radius.Sm}" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1">
                                <TextBlock Text="&#xE945;" FontFamily="{StaticResource Font.Icon}" FontSize="13" Foreground="{ThemeResource Accent.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel x:Name="UserInfoPanel" Visibility="Collapsed" VerticalAlignment="Center" Spacing="1">
                                <TextBlock Text="JamesOptimizer" FontFamily="{StaticResource Font.Display}" FontSize="13" FontWeight="Bold" Foreground="{ThemeResource Text.Primary}" />
                                <TextBlock Text="PRO SUITE V3" FontFamily="{StaticResource Font.Mono}" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Foreground="{ThemeResource Text.Tertiary}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Page Frame -->
            <Frame x:Name="ContentFrame" Grid.Column="1" Background="Transparent" />

            <!-- Floating Toast Notification Host -->
            <StackPanel x:Name="ToastHost" Grid.Column="1"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,24,0" Spacing="8" Width="320"
                        IsHitTestVisible="False" />
        </Grid>

        <!-- ========================================================================= -->
        <!-- CTRL+K COMMAND PALETTE MODAL OVERLAY                                      -->
        <!-- ========================================================================= -->
        <Grid x:Name="CommandPaletteOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource Bg.Overlay}" PointerPressed="CommandPaletteBackdrop_PointerPressed">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="CloseCommandPalette_Invoked" />
            </Grid.KeyboardAccelerators>

            <Border x:Name="CommandPaletteCard" Width="540" MaxHeight="440" VerticalAlignment="Top" Margin="0,78,0,0"
                    Background="{ThemeResource Bg.Surface}"
                    BorderBrush="{ThemeResource Border.Strong}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}"
                    PointerPressed="CommandPaletteCard_PointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Row="0" Padding="16,12" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="{StaticResource Font.Icon}" FontSize="15" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                        <TextBox x:Name="PaletteSearchBox" Grid.Column="1"
                                 PlaceholderText="Jump to page or execute optimizer command..."
                                 BorderThickness="0" Background="Transparent"
                                 MinHeight="32" Padding="4,4" VerticalContentAlignment="Center"
                                 FontFamily="{StaticResource Font.Sans}" FontSize="14"
                                 TextChanged="PaletteSearchBox_TextChanged"
                                 PreviewKeyDown="PaletteSearchBox_PreviewKeyDown" />
                        <Border Grid.Column="2" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="8,2" VerticalAlignment="Center">
                            <TextBlock Text="ESC" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{ThemeResource Text.Secondary}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource Border.Subtle}" />

                    <!-- Results List -->
                    <ListView x:Name="PaletteResultsList" Grid.Row="2" Padding="8" SelectionMode="Single"
                              IsItemClickEnabled="True" ItemClick="PaletteResultsList_ItemClick">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:CommandPaletteItem">
                                <Grid Padding="10,9" ColumnSpacing="14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="30" Height="30" CornerRadius="{StaticResource Radius.Sm}" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Glyph}" FontFamily="{StaticResource Font.Icon}" FontSize="13" Foreground="{ThemeResource Accent.Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock Text="{x:Bind Title}" FontFamily="{StaticResource Font.Sans}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{x:Bind Subtitle}" FontFamily="{StaticResource Font.Sans}" FontSize="12" Foreground="{ThemeResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="8,2" VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Badge}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{ThemeResource Text.Secondary}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Footer Hints -->
                    <Border Grid.Row="3" Background="{ThemeResource Bg.Sidebar}" CornerRadius="0,0,16,16" Padding="16,8" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="↑↓ Navigate" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{ThemeResource Text.Tertiary}" />
                            <TextBlock Text="↵ Execute" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{ThemeResource Text.Tertiary}" />
                            <TextBlock Text="Esc Close" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{ThemeResource Text.Tertiary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ========================================================================= -->
        <!-- CTRL+L ON-DEMAND AUDIT LOG & TWEAK REVERT MODAL                           -->
        <!-- ========================================================================= -->
        <Grid x:Name="AuditDrawerOverlay" Grid.RowSpan="2" Visibility="Collapsed"
              Background="{ThemeResource Bg.Overlay}" PointerPressed="AuditBackdrop_PointerPressed">
            <Grid.KeyboardAccelerators>
                <KeyboardAccelerator Key="Escape" Invoked="CloseAuditDrawer_Invoked" />
            </Grid.KeyboardAccelerators>

            <Border Width="760" Height="520" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Background="{ThemeResource Bg.Surface}"
                    BorderBrush="{ThemeResource Border.Strong}"
                    BorderThickness="1" CornerRadius="{StaticResource Radius.Lg}"
                    PointerPressed="CommandPaletteCard_PointerPressed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header & Mode Tabs -->
                    <Grid Grid.Row="0" Padding="20,14" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="&#xE756;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{ThemeResource Text.Secondary}" VerticalAlignment="Center" />
                            <TextBlock Text="AUDIT LOG &amp; TWEAK REVERT HISTORY" FontFamily="{StaticResource Font.Sans}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                            <Button x:Name="BtnTabLogs" Click="BtnAuditTab_Click" Tag="LOGS" Style="{StaticResource SegmentedPillActiveButtonStyle}" Content="Live Logs" />
                            <Button x:Name="BtnTabHistory" Click="BtnAuditTab_Click" Tag="HISTORY" Style="{StaticResource SegmentedPillButtonStyle}" Content="Revert History" />
                            <Button Click="BtnCopyAuditLogs_Click" Style="{StaticResource GhostButtonStyle}" Height="32" Content="Copy" />
                            <Button Click="BtnClearAuditLogs_Click" Style="{StaticResource GhostButtonStyle}" Height="32" Content="Clear" />
                            <Button Click="BtnCloseAuditDrawer_Click" Style="{StaticResource IconRaisedButtonStyle}" Width="32" Height="32" CornerRadius="8" Content="✕" AutomationProperties.Name="Close Audit Drawer" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Background="{ThemeResource Border.Subtle}" />

                    <!-- Live Logs List -->
                    <ListView x:Name="AuditLogsList" Grid.Row="2" Padding="14,12" SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnSpacing="12" Padding="4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="96" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding TimestampText}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{ThemeResource Text.Tertiary}" VerticalAlignment="Center" />
                                    <Border Grid.Column="1" Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource Accent.Cyan}" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding Message}" FontFamily="{StaticResource Font.Mono}" FontSize="12" LineHeight="18" Foreground="{ThemeResource Text.Primary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Tweak Revert History List -->
                    <ListView x:Name="AuditHistoryList" Grid.Row="2" Padding="14,12" SelectionMode="None" Visibility="Collapsed">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{ThemeResource Bg.Surface2}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Md}" Padding="14,12" Margin="0,0,0,8">
                                    <Grid ColumnSpacing="14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="68" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding TimeLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="12" Foreground="{ThemeResource Text.Tertiary}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                                            <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{ThemeResource Text.Primary}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding KeyPath}" FontFamily="{StaticResource Font.Mono}" FontSize="11" Foreground="{ThemeResource Text.Secondary}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Background="{ThemeResource Bg.Input}" BorderBrush="{ThemeResource Border.Subtle}" BorderThickness="1" CornerRadius="{StaticResource Radius.Sm}" Padding="8,3" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding StatusLabel}" FontFamily="{StaticResource Font.Mono}" FontSize="11" FontWeight="SemiBold" Foreground="{ThemeResource Accent.Cyan}" />
                                        </Border>
                                        <Button Grid.Column="3" Click="BtnRevertSnapshot_Click" Tag="{Binding Id}" Style="{StaticResource ModernGhostButtonStyle}" Height="32" Padding="12,0" Content="Revert" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
