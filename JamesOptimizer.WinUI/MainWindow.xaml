<Window
    x:Class="JamesOptimizer.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:JamesOptimizer.WinUI"
    xmlns:models="using:JamesOptimizer.WinUI.Models"
    xmlns:vm="using:JamesOptimizer.WinUI.ViewModels"
    mc:Ignorable="d"
    Title="JAMES OPTIMIZER PRO">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </Window.SystemBackdrop>

    <Grid Background="{StaticResource BgBaseBrush}">
        <Grid.RowDefinitions>
            <!-- Custom Title Bar (Full Bleed) -->
            <RowDefinition Height="48" />
            <!-- Main Content Area with Sidebar & Page -->
            <RowDefinition Height="*" />
            <!-- System Console Bar (Footer with Expandable Terminal Drawer) -->
            <RowDefinition x:Name="ConsoleRowDef" Height="36" />
        </Grid.RowDefinitions>

        <!-- Atmospheric Mesh Lighting Overlays (JamesGui Signature) -->
        <Border Grid.RowSpan="3" Background="{StaticResource AtmosphereTopRadialBrush}" Height="340" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.75" />
        <Border Grid.RowSpan="3" Background="{StaticResource AtmosphereCyanWashBrush}" Width="450" HorizontalAlignment="Left" IsHitTestVisible="False" Opacity="0.45" />

        <!-- ========================================================================= -->
        <!-- CUSTOM TITLE BAR (JAMESGUI BESPOKE BRANDING)                              -->
        <!-- ========================================================================= -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="Transparent" VerticalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Drag region overlay -->
            <Border x:Name="TitleBarDragArea" Grid.ColumnSpan="3" Background="Transparent" IsHitTestVisible="True" />

            <!-- Left: App Brand & Icon -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0" Spacing="8" IsHitTestVisible="False">
                <!-- Squircle Icon with Neon Coral Gradient -->
                <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource HeroMissionGradientBrush}">
                    <TextBlock Text="⚡" FontSize="15" Foreground="#FFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Border>
                <TextBlock Text="JamesOptimizer" FontFamily="{StaticResource DisplayFontFamily}" FontSize="15" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                <!-- Version Pill (v3.2) -->
                <Border Background="{StaticResource AccentVioletTint10Brush}" BorderBrush="{StaticResource AccentVioletBrush}" BorderThickness="1" CornerRadius="8" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="v3.2" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentVioletBrush}" />
                </Border>
                <!-- Pulsing Core Ready Pill -->
                <Border Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="4,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusPulseDot" Width="7" Height="7" Fill="{StaticResource AccentGreenBrush}">
                            <Ellipse.Resources>
                                <Storyboard x:Name="TitlePulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                    <DoubleAnimation
                                        Storyboard.TargetName="StatusPulseDot"
                                        Storyboard.TargetProperty="Opacity"
                                        From="1.0" To="0.25"
                                        Duration="0:0:0.7">
                                        <DoubleAnimation.EasingFunction>
                                            <CubicEase EasingMode="EaseInOut" />
                                        </DoubleAnimation.EasingFunction>
                                    </DoubleAnimation>
                                </Storyboard>
                            </Ellipse.Resources>
                        </Ellipse>
                        <TextBlock Text="CORE READY" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Center: Drag Area Spacer -->
            <Grid Grid.Column="1" />

            <!-- Right: Settings Gear (Positioned cleanly left of native Windows caption buttons) -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,145,0">
                <Button Style="{StaticResource CircularIconButtonStyle}" Click="QuickSettings_Click" ToolTipService.ToolTip="Settings &amp; Configuration" AutomationProperties.Name="Settings">
                    <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ========================================================================= -->
        <!-- MAIN WORKSPACE: COLLAPSIBLE SIDEBAR + PAGE CONTENT                         -->
        <!-- ========================================================================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColDef" Width="200" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0"
                    x:Name="SidebarContainer"
                    Background="{StaticResource SidebarAcrylicBrush}"
                    BorderBrush="{StaticResource BorderSubtleBrush}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Collapse / Expand Toggle Button -->
                    <Button x:Name="ToggleSidebarBtn"
                            Click="ToggleSidebarBtn_Click"
                            HorizontalAlignment="Stretch"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="12,10"
                            Margin="8,8,8,6"
                            CornerRadius="8"
                            AutomationProperties.Name="Toggle Navigation Rail">
                        <Grid HorizontalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="&#xE700;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                <TextBlock x:Name="NavHeaderLabel" Text="NAVIGATION" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </Button>

                    <!-- Nav Items ScrollViewer -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Spacing="3" Margin="6,2">
                            <!-- 1. Dashboard -->
                            <Button x:Name="NavDashboard" Click="NavButton_Click" Tag="Dashboard"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="{StaticResource BgElevatedBrush}" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavDashboardBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" CornerRadius="1" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE80F;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelDashboard" Text="Dashboard" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 2. System Cleanups -->
                            <Button x:Name="NavCleanups" Click="NavButton_Click" Tag="Cleanups"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavCleanBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelClean" Text="System Cleanups" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 3. Performance Tweaks -->
                            <Button x:Name="NavPerformance" Click="NavButton_Click" Tag="Performance"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavPerfBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE950;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelPerf" Text="Performance Tweaks" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 4. Gaming Mode -->
                            <Button x:Name="NavGamingMode" Click="NavButton_Click" Tag="GamingMode"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavGameBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelGame" Text="Gaming Mode" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 5. Startup Apps -->
                            <Button x:Name="NavStartup" Click="NavButton_Click" Tag="Startup"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavStartupBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelStartup" Text="Startup Apps" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 6. Services -->
                            <Button x:Name="NavServices" Click="NavButton_Click" Tag="Services"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavServicesBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelServices" Text="Services" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- Subtle Category Separator -->
                            <Border Height="1" Background="{StaticResource BorderSubtleBrush}" Margin="10,4,10,4" />

                            <!-- 7. Network Boost -->
                            <Button x:Name="NavNetwork" Click="NavButton_Click" Tag="Network"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavNetBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE774;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelNet" Text="Network Boost" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 8. Storage -->
                            <Button x:Name="NavStorage" Click="NavButton_Click" Tag="Storage"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavStorageBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelStorage" Text="Storage" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 9. Toolbox -->
                            <Button x:Name="NavToolbox" Click="NavButton_Click" Tag="Toolbox"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavToolboxBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE825;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelToolbox" Text="Toolbox" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 10. Diagnostics -->
                            <Button x:Name="NavDiagnostics" Click="NavButton_Click" Tag="Diagnostics"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavDiagBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelDiag" Text="Diagnostics" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <!-- 11. Settings -->
                            <Button x:Name="NavSettings" Click="NavButton_Click" Tag="Settings"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                    Background="Transparent" BorderThickness="0" CornerRadius="10" Height="38" Padding="0">
                                <Grid>
                                    <Border x:Name="NavSettingsBar" HorizontalAlignment="Left" Width="3" Background="{StaticResource AccentCyanBrush}" Visibility="Collapsed" Margin="2,6,0,6" />
                                    <StackPanel Orientation="Horizontal" Spacing="12" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFontFamily}" FontSize="16" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <TextBlock x:Name="NavLabelSettings" Text="Settings" FontFamily="{StaticResource DisplayFontFamily}" FontSize="13" FontWeight="Normal" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom User Card -->
                    <Border Grid.Row="2"
                            x:Name="UserCardBorder"
                            Margin="8,6,8,10"
                            Background="{StaticResource FrostedBadgeAcrylicBrush}"
                            BorderBrush="{StaticResource BorderSubtleBrush}"
                            BorderThickness="1"
                            CornerRadius="14"
                            Padding="10,8"
                            PointerPressed="UserCard_PointerPressed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Background="#1A00F5FF" BorderBrush="#3300F5FF" BorderThickness="1" VerticalAlignment="Center">
                                <Image Source="ms-appx:///Assets/logo-128.png" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>

                            <StackPanel x:Name="UserInfoPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <TextBlock Text="James God" FontFamily="{StaticResource DisplayFontFamily}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="&#xF78C;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" Foreground="{StaticResource AccentCyanBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="PRO SUITE · ACTIVE" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource AccentGreenBrush}" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Page Frame -->
            <Frame x:Name="ContentFrame" Grid.Column="1" Background="Transparent" />
        </Grid>

        <!-- ========================================================================= -->
        <!-- SYSTEM CONSOLE BAR (EXPANDABLE LOG DRAWER + SLIDER + CLEAR BUTTON)        -->
        <!-- Just the logs and the slider. When clicked, it expands. Just a clear btn.  -->
        <!-- ========================================================================= -->
        <Border Grid.Row="2"
                x:Name="ConsoleContainer"
                Background="{StaticResource BgSurfaceBrush}"
                BorderBrush="{StaticResource BorderSubtleBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <!-- Compact Console Bar Header (Height=36, Always Visible) -->
                    <RowDefinition Height="36" />
                    <!-- Expanded Terminal View (Revealed when expanded) -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ROW 0: CONSOLE BAR (LOGS + SLIDER + CLEAR + EXPAND BUTTON) -->
                <Grid Grid.Row="0" Margin="14,0,12,0" VerticalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <!-- Left: `>_ SYSTEM CONSOLE`, pulsing green dot, and monospace log stream -->
                        <ColumnDefinition Width="*" />
                        <!-- Right: Slider + Clear Button + Expand Button -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Terminal Prompt + Pulsing Dot + Cascadia Code Log Stream -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Cyan Terminal Prompt Prefix -->
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="&gt;_"
                                       FontFamily="{StaticResource ConsoleFontFamily}"
                                       FontSize="12"
                                       FontWeight="Black"
                                       Foreground="{StaticResource AccentCyanBrush}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="SYSTEM CONSOLE"
                                       FontFamily="{StaticResource ConsoleFontFamily}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="#FFFFFF"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Glowing Green Pulsing Indicator -->
                        <Border Width="16" Height="16" CornerRadius="8" Background="{StaticResource AccentGreenTint10Brush}" VerticalAlignment="Center">
                            <Ellipse x:Name="ConsolePulseDot" Width="6" Height="6" Fill="{StaticResource AccentGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Ellipse.Resources>
                                    <Storyboard x:Name="ConsolePulseStoryboard" RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetName="ConsolePulseDot"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1.0" To="0.25"
                                            Duration="0:0:0.7">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseInOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </Ellipse.Resources>
                            </Ellipse>
                        </Border>

                        <!-- Live Cascadia Code Log Message -->
                        <TextBlock x:Name="ConsoleMarqueeText"
                                   Text="[SYSTEM] Kernel optimizations ready · 32GB RAM Ready · 0 bottlenecks detected."
                                   FontFamily="{StaticResource ConsoleFontFamily}"
                                   FontSize="11"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Right: The Slider + Clear Button + Expand Button (Nothing else!) -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <!-- Log History / Buffer Scrubber Slider -->
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="BUFFER"
                                       FontFamily="{StaticResource ConsoleFontFamily}"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" />
                            <Slider x:Name="LogScrubberSlider"
                                    Width="120"
                                    Height="24"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="100"
                                    ValueChanged="LogScrubberSlider_ValueChanged"
                                    Style="{StaticResource ConsoleSliderStyle}"
                                    ToolTipService.ToolTip="Scrub Log History (Drag left for past logs, right for live)"
                                    AutomationProperties.Name="Log History Scrubber Slider" />
                        </StackPanel>

                        <!-- CLEAR Button: Clean ghost button, clears logs -->
                        <Button x:Name="ClearLogsBtn"
                                Click="ClearLogsBtn_Click"
                                Style="{StaticResource GhostButtonStyle}"
                                Height="24"
                                Padding="10,0"
                                ToolTipService.ToolTip="Clear console messages"
                                AutomationProperties.Name="Clear Console Logs">
                            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFontFamily}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                <TextBlock Text="CLEAR" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Expand / Collapse Drawer Button -->
                        <Button x:Name="ToggleConsoleExpandBtn"
                                Click="ToggleConsoleExpandBtn_Click"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Width="26"
                                Height="24"
                                ToolTipService.ToolTip="Expand Console Drawer"
                                AutomationProperties.Name="Expand Console Drawer">
                            <TextBlock x:Name="ConsoleExpandIcon" Text="&#xE70E;" FontFamily="{StaticResource IconFontFamily}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- ROW 1: EXPANDED TERMINAL VIEW (FULL MULTI-LINE LOG VIEWER) -->
                <Border Grid.Row="1"
                        x:Name="ExpandedTerminalPanel"
                        Background="#080A0E"
                        BorderBrush="{StaticResource BorderSubtleBrush}"
                        BorderThickness="0,1,0,0"
                        Visibility="Collapsed">
                    <Grid Margin="14,8,14,8">
                        <Grid.RowDefinitions>
                            <!-- Mini Terminal Header -->
                            <RowDefinition Height="Auto" />
                            <!-- Scrollable Terminal Body -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Terminal Subheader -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <TextBlock Text="KERNEL STREAM · LIVE TELEMETRY" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                <TextBlock x:Name="LogCountText" Text="(0 entries)" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="9" Foreground="{StaticResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock HorizontalAlignment="Right" Text="AUTO-SCROLL: ENGAGED" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="9" Foreground="{StaticResource AccentGreenBrush}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Scrollable Log List -->
                        <ScrollViewer x:Name="TerminalScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="TerminalLogsItemsControl">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:LogEntry">
                                        <Grid Margin="0,2" Padding="4,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="65" />
                                                <ColumnDefinition Width="80" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{x:Bind TimestampText}" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="1" HorizontalAlignment="Left" Background="{StaticResource BgElevatedBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="4" Padding="6,1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Category}" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="9" FontWeight="Bold" Foreground="{StaticResource AccentCyanBrush}" />
                                            </Border>
                                            <TextBlock Grid.Column="2" Text="{x:Bind Message}" FontFamily="{StaticResource ConsoleFontFamily}" FontSize="11" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" Margin="8,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
