<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///Styles/Colors.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- ========================================================================= -->
    <!-- TYPOGRAPHY TOKENS                                                         -->
    <!-- Display: Inter Variable / Inter / Segoe UI Variable Display               -->
    <!-- Body: Inter / Segoe UI Variable Text                                      -->
    <!-- Monospace Console: Cascadia Code / Consolas                               -->
    <!-- ========================================================================= -->
    <FontFamily x:Key="DisplayFontFamily">Inter, Segoe UI Variable Display, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="BodyFontFamily">Inter, Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
    <FontFamily x:Key="ConsoleFontFamily">Cascadia Code, Consolas, Courier New, monospace</FontFamily>
    <FontFamily x:Key="IconFontFamily">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- ========================================================================= -->
    <!-- ACCESSIBILITY & FOCUS VISUAL                                              -->
    <!-- ========================================================================= -->
    <Style x:Key="CyanFocusVisual" TargetType="Control">
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="False" />
    </Style>

    <!-- ========================================================================= -->
    <!-- CARD / PANEL STYLES (JAMESGUI 16px RADIUS WITH HIGH CONTRAST BORDERS)     -->
    <!-- ========================================================================= -->
    <Style x:Key="CardPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style x:Key="JamesGuiCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Active Coral Card Style (e.g. Screen Mirror active card in screenshot) -->
    <Style x:Key="JamesGuiActiveCoralCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardActiveCoralBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentCoralBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Active Cyan Card Style -->
    <Style x:Key="JamesGuiActiveCyanCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardActiveCyanBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Active Violet Card Style -->
    <Style x:Key="JamesGuiActiveVioletCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardActiveVioletBgBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentVioletBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <!-- Inner Bevel Overlay Border -->
    <Style x:Key="InnerBevelBorderStyle" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource InnerBevelBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

    <!-- ========================================================================= -->
    <!-- HERO "START MISSION" BUTTON STYLE (JAMESGUI ICONIC CALL TO ACTION)       -->
    <!-- ========================================================================= -->
    <Style x:Key="HeroMissionButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CharacterSpacing" Value="50" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Height" Value="52" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="Background" Value="{StaticResource HeroMissionGradientBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Primary CTA Button (CornerRadius="24") -->
    <Style x:Key="PrimaryCtaButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Padding" Value="24,0" />
        <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="Foreground" Value="#070A10" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Secondary Button (CornerRadius="10") -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Segmented Filter / Pill Button -->
    <Style x:Key="SegmentedPillButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="SegmentedPillActiveButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Background" Value="{StaticResource AccentVioletBrush}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Ghost Button (Console actions) -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource ConsoleFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Title Bar Custom Window Control Button -->
    <Style x:Key="TitleBarButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFontFamily}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- Circular Gear / Icon Button -->
    <Style x:Key="CircularIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- PILL BADGES & FILTER BUTTONS (JAMESGUI EXACT STYLE)                       -->
    <!-- ========================================================================= -->
    <Style x:Key="PillTagCoralStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentCoralBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillTagVioletStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentVioletBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillTagCyanStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="PillTagDarkStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="MetricPillBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="8,0,12,0" />
    </Style>

    <Style x:Key="ConsoleFilterPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- ========================================================================= -->
    <!-- CUSTOM TOGGLE SWITCH (NEON CORAL ACCENT)                                  -->
    <!-- ========================================================================= -->
    <Style x:Key="AutoRunToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ========================================================================= -->
    <!-- SLIDER STYLES                                                             -->
    <!-- ========================================================================= -->
    <Style x:Key="ConsoleSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
    </Style>

    <Style x:Key="JamesGuiNeonSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentCoralBrush}" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="Height" Value="28" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsThumbToolTipEnabled" Value="False" />
    </Style>

    <!-- Modern View Button Styles -->
    <Style x:Key="ModernPrimaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="{StaticResource AccentCyanBrush}" />
        <Setter Property="Foreground" Value="#070A10" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style x:Key="ModernSecondaryButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="{StaticResource BgElevatedBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style x:Key="ModernGhostButtonStyle" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource BodyFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

</ResourceDictionary>
